{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confighub.github.io/helm-expt/site/configs.schema.json",
  "title": "ConfigHub Workshop configs section",
  "description": "One row per config in the Catalog's configs section. Every row carries a stable id, a one-line summary, its state, and next: the exact command or address an agent uses.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "section",
    "schema",
    "generatedFrom",
    "count",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "catalog.confighub.com/v1alpha1"
    },
    "kind": {
      "const": "WorkshopSection"
    },
    "section": {
      "const": "configs"
    },
    "schema": {
      "const": "https://confighub.github.io/helm-expt/site/configs.schema.json"
    },
    "generatedFrom": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "format",
          "version",
          "base",
          "summary",
          "state",
          "objectCount",
          "flatteningVerdict",
          "checks",
          "listing",
          "next"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "base": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1,
            "description": "Discovery classification: classified when the listing carries roles that cub config list --role finds, and not-classified otherwise. It is not a review or readiness state; checks says what was checked."
          },
          "objectCount": {
            "type": "integer",
            "minimum": 0
          },
          "flatteningVerdict": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "object",
            "description": "The listing's four assessment stages, each as evidenceState/resultState, for example completed/pass. completed means the stage's evidence exists for this exact configuration; pending, not-run and blocked mean it does not. It checks the configuration, not your values or your cluster.",
            "required": [
              "inspection",
              "materialization",
              "destination",
              "post-deployment"
            ],
            "additionalProperties": false,
            "properties": {
              "inspection": {
                "type": "string",
                "pattern": "^[a-z-]+/[a-z-]+$"
              },
              "materialization": {
                "type": "string",
                "pattern": "^[a-z-]+/[a-z-]+$"
              },
              "destination": {
                "type": "string",
                "pattern": "^[a-z-]+/[a-z-]+$"
              },
              "post-deployment": {
                "type": "string",
                "pattern": "^[a-z-]+/[a-z-]+$"
              }
            }
          },
          "listing": {
            "type": "string",
            "minLength": 1
          },
          "next": {
            "type": "object",
            "description": "What an agent does next: run command, open address, or read note.",
            "minProperties": 1,
            "properties": {
              "command": {
                "type": "string"
              },
              "address": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "digest": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
