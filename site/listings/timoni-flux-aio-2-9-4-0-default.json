    "howToMakeOne": {
      "model": "The catalog builds a base by pinning one source version, fixing one set of inputs, and retaining the exact objects that come out. A new variant starts from a retained base and changes only the fields it owns, so the base stays comparable and the change stays reviewable.",
      "steps": [
        "Materialize this base and confirm the object set hashes to sha256:cb8a9a65993ca63c0e02a2fbd70240184691bec17678f0378b96842e8da28b24. The exact objects are recorded at examples/timoni/flux-aio-2-9-4-0/rendered/release-objects.yaml.",
        "Put those objects in a local directory called rendered, then preview the retention before writing anything.",
        "Retain the base in ConfigHub, carrying the object-set hash as an annotation so the accepted identity travels with it.",
        "Create the new variant from that base and change only the fields the variant owns.",
        "Preview the promotion and read the mutations before any write command runs."
      ],
      "commands": [
        {
          "step": "Preview the retention",
          "command": "cub variant upload --dry-run --component flux-aio --variant default --space timoni-flux-aio-2-9-4-0-default --granularity minimal --annotation workshop.confighub.com/object-set-sha256=sha256:cb8a9a65993ca63c0e02a2fbd70240184691bec17678f0378b96842e8da28b24 ./rendered",
          "writes": false
        },
        {
          "step": "Retain this base",
          "command": "cub variant upload --component flux-aio --variant default --space timoni-flux-aio-2-9-4-0-default --granularity minimal --annotation workshop.confighub.com/object-set-sha256=sha256:cb8a9a65993ca63c0e02a2fbd70240184691bec17678f0378b96842e8da28b24 ./rendered",
          "writes": true
        },
        {
          "step": "Create a staging variant",
          "command": "cub variant create staging timoni-flux-aio-2-9-4-0-default --space-pattern template:timoni-flux-aio-2-9-4-0-default-staging --environment Staging --unit-annotation workshop.confighub.com/object-set-sha256=sha256:cb8a9a65993ca63c0e02a2fbd70240184691bec17678f0378b96842e8da28b24",
          "writes": true
        },
        {
          "step": "Preview the promotion",
          "command": "cub variant promote timoni-flux-aio-2-9-4-0-default-staging --dry-run -o mutations",
          "writes": false
        }
      ],
