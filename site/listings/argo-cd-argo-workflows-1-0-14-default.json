        {
          "comment": "publish the Release that the cluster's Argo CD pulls",
          "command": "cub release publish <your-space>-dev",
          "needsAccount": true,
          "writes": true
        },
        {
          "comment": "delete the installer record, which Argo CD cannot read",
          "command": "cub unit delete --space <your-space>-dev installer-record",
          "needsAccount": true,
          "writes": true
        },
        {
          "comment": "publish again without it",
          "command": "cub release publish <your-space>-dev",
          "needsAccount": true,
          "writes": true
        }
