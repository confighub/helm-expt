{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://confighub.com/helm-expt/schemas/helm-render-intent.schema.json",
  "title": "Helm Render Intent",
  "description": "UNOFFICIAL/EXPERIMENTAL. A machine-readable ConfigHub-facing description of one proven Helm base variant render path. Generated by scripts/generate-helm-render-intents.mjs from committed helm-expt evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec",
    "status"
  ],
  "properties": {
    "apiVersion": {
      "const": "helm-expt.confighub.com/v1alpha1"
    },
    "kind": {
      "const": "HelmRenderIntent"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "labels"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "object",
          "required": [
            "component",
            "chart",
            "version",
            "base",
            "catalogLayer"
          ],
          "properties": {
            "component": {
              "type": "string"
            },
            "chart": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "base": {
              "type": "string"
            },
            "catalogLayer": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "chart",
        "baseVariant",
        "renderInputs",
        "renderOutput",
        "evidence",
        "lifecycle",
        "targetFacts",
        "provenance"
      ],
      "properties": {
        "component": {
          "type": "string"
        },
        "chart": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "sourceRepository": {
              "type": "string"
            },
            "sourceContent": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "baseVariant": {
          "type": "string"
        },
        "renderInputs": {
          "type": "object",
          "required": [
            "recipe",
            "variant",
            "revision",
            "packageBase",
            "sourceLock"
          ],
          "properties": {
            "recipe": {
              "type": "string"
            },
            "variant": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "packageBase": {
              "type": "string"
            },
            "sourceLock": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "releaseName": {
              "type": "string"
            },
            "valuesProfile": {
              "type": "string"
            },
            "capabilityProfile": {
              "type": "object",
              "additionalProperties": true
            },
            "hookPolicy": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "renderOutput": {
          "type": "object",
          "required": [
            "renderedObjects",
            "objectInventory",
            "revision",
            "packageBase"
          ],
          "properties": {
            "renderedObjects": {
              "type": "string"
            },
            "objectInventory": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "packageBase": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "object",
          "required": [
            "renderParity",
            "confighubScanOps",
            "localKind",
            "lifecycleObserved",
            "gitopsOciLive",
            "liveDualParity",
            "twoClusterKind",
            "variantPromotion"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "lifecycle": {
          "type": "object",
          "required": [
            "routeContract",
            "routeCount",
            "dispositions",
            "executionModes",
            "safeAutomatic"
          ],
          "properties": {
            "routeContract": {
              "type": "string"
            },
            "routeCount": {
              "type": "string"
            },
            "dispositions": {
              "type": "string"
            },
            "executionModes": {
              "type": "string"
            },
            "safeAutomatic": {
              "type": "string"
            },
            "contractPath": {
              "type": "string"
            },
            "jsonPath": {
              "type": "string"
            },
            "variantRoutes": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        },
        "targetFacts": {
          "type": "object",
          "required": [
            "status",
            "declared",
            "actions"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "declared": {
              "type": "object",
              "description": "Target facts declared by the base variant, including required Secrets, CRDs, namespaces, values, storage, DNS names, or topology.",
              "additionalProperties": true
            },
            "actions": {
              "type": "array",
              "description": "Follow-up action records derived from observed prerequisite failures. These are separate from the base declaration.",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "required": [
            "matrixRowKind",
            "catalogLayer",
            "customizationLayer",
            "fullModelPath"
          ],
          "properties": {
            "matrixRowKind": {
              "type": "string"
            },
            "catalogLayer": {
              "type": "string"
            },
            "customizationLayer": {
              "type": "string"
            },
            "rowStatus": {
              "type": "string"
            },
            "githubRecipeUrl": {
              "type": "string"
            },
            "githubPackageBaseUrl": {
              "type": "string"
            },
            "fullModelPath": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "disposition",
        "claim",
        "limits"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "real-base-render-intent"
          ]
        },
        "claim": {
          "type": "string"
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
