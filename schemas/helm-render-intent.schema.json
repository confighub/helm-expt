{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://confighub.com/helm-expt/schemas/helm-render-intent.schema.json",
  "title": "Helm Render Intent",
  "description": "UNOFFICIAL/EXPERIMENTAL. A machine-readable ConfigHub-facing description of one proven Helm base variant render path. Generated by scripts/generate-helm-render-intents.mjs from committed helm-expt evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec",
    "status"
  ],
  "definitions": {
    "runnerEvidence": {
      "type": "object",
      "required": [
        "implementation",
        "status",
        "evidence"
      ],
      "properties": {
        "implementation": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "required": [
        "policy",
        "maxAge"
      ],
      "properties": {
        "policy": {
          "enum": [
            "recheck-before-render",
            "recheck-before-apply"
          ]
        },
        "maxAge": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "apiVersion": {
      "const": "helm-expt.confighub.com/v1alpha1"
    },
    "kind": {
      "const": "HelmRenderIntent"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "labels"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "object",
          "required": [
            "component",
            "chart",
            "version",
            "base",
            "catalogLayer"
          ],
          "properties": {
            "component": {
              "type": "string"
            },
            "chart": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "base": {
              "type": "string"
            },
            "catalogLayer": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "chart",
        "baseVariant",
        "renderInputs",
        "renderOutput",
        "evidence",
        "lifecycle",
        "targetFacts",
        "provenance"
      ],
      "properties": {
        "component": {
          "type": "string"
        },
        "chart": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "sourceRepository": {
              "type": "string"
            },
            "sourceContent": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "baseVariant": {
          "type": "string"
        },
        "renderInputs": {
          "type": "object",
          "required": [
            "recipe",
            "variant",
            "revision",
            "packageBase",
            "sourceLock"
          ],
          "properties": {
            "recipe": {
              "type": "string"
            },
            "variant": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "packageBase": {
              "type": "string"
            },
            "installerPackageOciRef": {
              "type": "string",
              "description": "The multi-preset cub installer package OCI reference for this chart version."
            },
            "sourceLock": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "releaseName": {
              "type": "string"
            },
            "valuesProfile": {
              "type": "string"
            },
            "capabilityProfile": {
              "type": "object",
              "additionalProperties": true
            },
            "hookPolicy": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "renderOutput": {
          "type": "object",
          "required": [
            "renderedObjects",
            "objectInventory",
            "revision",
            "packageBase"
          ],
          "properties": {
            "renderedObjects": {
              "type": "string"
            },
            "objectInventory": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "packageBase": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "object",
          "required": [
            "renderParity",
            "confighubScanOps",
            "localKind",
            "lifecycleObserved",
            "gitopsOciLive",
            "liveDualParity",
            "twoClusterKind",
            "variantPromotion"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "lifecycle": {
          "type": "object",
          "required": [
            "routeContract",
            "routeCount",
            "dispositions",
            "executionModes",
            "safeAutomatic",
            "variantRoutes",
            "coverage"
          ],
          "properties": {
            "routeContract": {
              "type": "string"
            },
            "routeCount": {
              "type": "string"
            },
            "dispositions": {
              "type": "string"
            },
            "executionModes": {
              "type": "string"
            },
            "safeAutomatic": {
              "type": "string"
            },
            "contractPath": {
              "type": "string"
            },
            "jsonPath": {
              "type": "string"
            },
            "variantRoutes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "routeName",
                  "routeSourceVersion",
                  "evidence",
                  "gitOps",
                  "runners"
                ],
                "properties": {
                  "routeName": {
                    "type": "string"
                  },
                  "routeSourceVersion": {
                    "type": "string"
                  },
                  "automatic": {
                    "const": false
                  },
                  "operatingDetails": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "gitOps": {
                    "type": "object"
                  },
                  "runners": {
                    "type": "object",
                    "required": [
                      "direct",
                      "argoCd",
                      "flux"
                    ],
                    "properties": {
                      "direct": {
                        "$ref": "#/definitions/runnerEvidence"
                      },
                      "argoCd": {
                        "$ref": "#/definitions/runnerEvidence"
                      },
                      "flux": {
                        "$ref": "#/definitions/runnerEvidence"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": true
              }
            },
            "coverage": {
              "type": "object",
              "required": [
                "state",
                "reason",
                "evidence",
                "nextAction"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "attached",
                    "actionable-gap",
                    "no-route-required"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "nextAction": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "targetFacts": {
          "type": "object",
          "required": [
            "status",
            "declared",
            "requirements",
            "actions",
            "coverage"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "declared": {
              "type": "object",
              "description": "Target facts declared by the base variant, including required Secrets, CRDs, namespaces, values, storage, DNS names, or topology.",
              "additionalProperties": true
            },
            "requirements": {
              "type": "array",
              "description": "Normalized target prerequisites, including when they must be checked again and any linked evidence.",
              "items": {
                "type": "object",
                "required": [
                  "category",
                  "name",
                  "requiredBefore",
                  "freshness",
                  "declarationPath",
                  "evidence"
                ],
                "properties": {
                  "category": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "packageSource": {
                    "type": "string",
                    "description": "Package-relative source for an exact prerequisite file, when the installer package carries one."
                  },
                  "packagePath": {
                    "type": "string",
                    "description": "Repository path to the generated prerequisite file."
                  },
                  "requiredBefore": {
                    "enum": [
                      "render",
                      "apply"
                    ]
                  },
                  "freshness": {
                    "$ref": "#/definitions/freshness"
                  },
                  "declarationPath": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": true
              }
            },
            "actions": {
              "type": "array",
              "description": "Follow-up action records derived from observed prerequisite failures. These are separate from the base declaration.",
              "items": {
                "type": "object",
                "required": [
                  "requiredBefore",
                  "freshness",
                  "evidence"
                ],
                "properties": {
                  "requiredBefore": {
                    "const": "apply"
                  },
                  "freshness": {
                    "$ref": "#/definitions/freshness"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": true
              }
            },
            "coverage": {
              "type": "object",
              "required": [
                "state",
                "reason",
                "declarationSource",
                "nextAction"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "attached",
                    "attached-with-observed-actions",
                    "actionable-gap",
                    "no-target-facts-required"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "declarationSource": {
                  "type": "string"
                },
                "nextAction": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "required": [
            "matrixRowKind",
            "catalogLayer",
            "customizationLayer",
            "fullModelPath"
          ],
          "properties": {
            "matrixRowKind": {
              "type": "string"
            },
            "catalogLayer": {
              "type": "string"
            },
            "customizationLayer": {
              "type": "string"
            },
            "rowStatus": {
              "type": "string"
            },
            "githubRecipeUrl": {
              "type": "string"
            },
            "githubPackageBaseUrl": {
              "type": "string"
            },
            "fullModelPath": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "disposition",
        "claim",
        "limits"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "real-base-render-intent"
          ]
        },
        "claim": {
          "type": "string"
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
