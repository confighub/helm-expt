{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confighub.com/helm-expt/schemas/observation-receipt.schema.json",
  "title": "Observation Receipt",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "common-defs.schema.json#/$defs/apiVersion" },
    "kind": { "const": "ObservationReceipt" },
    "metadata": { "$ref": "common-defs.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "required": ["variantRevision", "observer", "target", "observedAt", "freshnessTTL", "result", "checks"],
      "properties": {
        "variantRevision": { "$ref": "common-defs.schema.json#/$defs/relativePath" },
        "renderedObjectSetSHA256": { "$ref": "common-defs.schema.json#/$defs/sha256" },
        "observer": {
          "type": "object",
          "required": ["name", "method"],
          "additionalProperties": true
        },
        "target": {
          "type": "object",
          "required": ["kind", "name"],
          "additionalProperties": true
        },
        "observedAt": { "type": "string", "minLength": 1 },
        "freshnessTTL": { "type": "string", "minLength": 1 },
        "result": { "$ref": "common-defs.schema.json#/$defs/result" },
        "checks": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
