{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confighub.com/helm-expt/schemas/effective-values.schema.json",
  "title": "Effective Values",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "common-defs.schema.json#/$defs/apiVersion" },
    "kind": { "const": "EffectiveValues" },
    "metadata": { "$ref": "common-defs.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "required": ["files", "values"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "source", "sha256"],
            "properties": {
              "path": { "$ref": "common-defs.schema.json#/$defs/relativePath" },
              "source": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "common-defs.schema.json#/$defs/sha256" }
            },
            "additionalProperties": true
          }
        },
        "values": { "type": "object" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
