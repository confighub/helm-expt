{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://confighub.com/helm-expt/schemas/flattening-safety-verdict.schema.json",
  "title": "Flattening Safety Verdict",
  "description": "One receipted answer per chart version to a single question: what happens if you ship this chart as literal rendered YAML instead of running Helm? The verdict joins a template-level witness scan of the pinned chart package with the catalog's recorded hook and lifecycle evidence, states one finding and disposition per quirk class, and decides a lane. The lane is scoped to the audited base; a variantScope entry records how other values change the finding set. Generated by scripts/generate-flattening-safety-verdicts.mjs.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "evidence.confighub.com/v1alpha1" },
    "kind": { "const": "FlatteningSafetyVerdict" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "spec": {
      "type": "object",
      "required": ["chart", "witnessRef", "auditedBase", "dispositions", "verdict", "boundedness", "provenance"],
      "additionalProperties": false,
      "properties": {
        "chart": {
          "type": "object",
          "required": ["repository", "name", "version", "packageSHA256"],
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "name": { "type": "string" },
            "version": { "type": "string" },
            "packageSHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "witnessRef": { "type": "string" },
        "auditedBase": { "type": "string" },
        "dispositions": {
          "type": "array",
          "minItems": 11,
          "items": {
            "type": "object",
            "required": ["class", "finding", "disposition"],
            "additionalProperties": false,
            "properties": {
              "class": {
                "enum": [
                  "helm-hooks",
                  "resource-policy-keep",
                  "lookup",
                  "webhook-ca",
                  "capabilities-api-versions",
                  "generated-secrets",
                  "crd-ordering",
                  "immutable-fields",
                  "namespace-creation",
                  "subchart-conditions",
                  "test-hooks"
                ]
              },
              "finding": { "enum": ["absent", "present", "present-gated", "not-evaluated"] },
              "detail": { "type": "string" },
              "disposition": { "type": "string" },
              "evidence": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "variantScope": {
          "description": "How values choices move the finding set. The lane above holds for the audited base only.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["values", "effect"],
            "additionalProperties": false,
            "properties": {
              "values": { "type": "string" },
              "effect": { "type": "string" }
            }
          }
        },
        "verdict": {
          "type": "object",
          "required": ["lane", "rationale"],
          "additionalProperties": false,
          "properties": {
            "lane": { "enum": ["safe-to-flatten", "flatten-with-routes", "unsafe-to-flatten"] },
            "rationale": { "type": "string" },
            "routes": {
              "description": "For flatten-with-routes: the named companion artifacts the bundle must ship.",
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "boundedness": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "provenance": {
          "type": "object",
          "required": ["emittedBy", "generatedFrom"],
          "additionalProperties": false,
          "properties": {
            "emittedBy": { "type": "string" },
            "generatedFrom": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
