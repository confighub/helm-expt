{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://confighub.com/helm-expt/schemas/flattening-safety-verdict.schema.json",
  "title": "Flattening Safety Verdict",
  "description": "A scoped decision about retaining exact Kubernetes objects instead of rerunning a source processor during delivery. Helm verdicts join a template witness scan with lifecycle evidence. Other sources describe the processing boundary they flatten and any nested sources that still run later. A source, variant, destination, or delivery-runtime change can require a new verdict.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "evidence.confighub.com/v1alpha1" },
    "kind": { "const": "FlatteningSafetyVerdict" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "spec": {
      "type": "object",
      "required": ["dispositions", "verdict", "boundedness", "provenance"],
      "additionalProperties": false,
      "oneOf": [
        { "required": ["chart", "witnessRef", "auditedBase"] },
        { "required": ["subject"] }
      ],
      "properties": {
        "chart": {
          "type": "object",
          "required": ["repository", "name", "version", "packageSHA256"],
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "name": { "type": "string" },
            "version": { "type": "string" },
            "packageSHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "subject": {
          "description": "A non-Helm processing boundary, such as an AICR-generated Application set.",
          "type": "object",
          "required": ["kind", "entry", "upstreamVersion"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "entry": { "type": "string", "minLength": 1 },
            "upstreamVersion": { "type": "string", "minLength": 1 },
            "platformDigest": { "type": "string", "minLength": 1 },
            "note": { "type": "string" }
          }
        },
        "witnessRef": { "type": "string" },
        "auditedBase": { "type": "string" },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["class", "finding", "disposition"],
            "additionalProperties": false,
            "properties": {
              "class": { "type": "string", "minLength": 1 },
              "finding": { "enum": ["absent", "present", "present-gated", "not-evaluated"] },
              "detail": { "type": "string" },
              "disposition": { "type": "string" },
              "companionRequired": { "type": "string" },
              "evidence": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "componentScope": {
          "description": "Nested sources that keep their own processing and flattening decisions.",
          "type": "object",
          "required": ["mode", "statement"],
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "minLength": 1 },
            "referencedCharts": {
              "type": "array",
              "items": { "type": "string" }
            },
            "statement": { "type": "string", "minLength": 1 }
          }
        },
        "variantScope": {
          "description": "How values choices move the finding set. The lane above holds for the audited base only.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["values", "effect"],
            "additionalProperties": false,
            "properties": {
              "values": { "type": "string" },
              "effect": { "type": "string" }
            }
          }
        },
        "verdict": {
          "type": "object",
          "required": ["lane", "rationale"],
          "additionalProperties": false,
          "properties": {
            "lane": { "enum": ["born-flattened", "safe-to-flatten", "flatten-with-routes", "unsafe-to-flatten"] },
            "rationale": { "type": "string" },
            "routes": {
              "description": "For flatten-with-routes: the named companion artifacts the bundle must ship.",
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "boundedness": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "provenance": {
          "type": "object",
          "required": ["emittedBy", "generatedFrom"],
          "additionalProperties": false,
          "properties": {
            "emittedBy": { "type": "string" },
            "generatedFrom": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
