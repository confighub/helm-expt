{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://confighub.com/helm-expt/schemas/demo-program.schema.json",
  "title": "Config Catalog Demonstration Program",
  "description": "The maintained list of source pathways and ConfigHub App demonstrations, with status and evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "catalog.confighub.com/v1alpha1"
    },
    "kind": {
      "const": "DemoProgram"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": [
        "architecture",
        "catalogNavigation",
        "reviewQuestions",
        "exampleJourney",
        "pathways",
        "apps"
      ],
      "properties": {
        "architecture": {
          "type": "object"
        },
        "catalogNavigation": {
          "type": "object"
        },
        "reviewQuestions": {
          "type": "object"
        },
        "exampleJourney": {
          "type": "object"
        },
        "pathways": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/demo"
          }
        },
        "apps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/demo"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "demo": {
      "type": "object",
      "required": [
        "id",
        "name",
        "problem",
        "result",
        "status",
        "workedExample",
        "steps",
        "entrypoints",
        "evidence",
        "limits"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "partial",
            "example-only",
            "planned"
          ]
        },
        "workedExample": {
          "type": "object",
          "required": [
            "status",
            "result",
            "limit"
          ],
          "properties": {
            "status": {
              "const": "working"
            },
            "result": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
