{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://confighub.com/helm-expt/schemas/base-variant-record.schema.json",
  "title": "Config Catalog Base Variant Record",
  "description": "A source-neutral index connecting one reviewed base to its source and intent, exact objects, materialization and flattening decisions, lifecycle requirements, route status, field ownership, evidence, and OCI handoffs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec",
    "status"
  ],
  "properties": {
    "apiVersion": {
      "const": "catalog.confighub.com/v1alpha1"
    },
    "kind": {
      "const": "BaseVariantRecord"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "labels"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "baseVariant",
        "configuration",
        "processing",
        "inputs",
        "lifecycle",
        "ownership",
        "delivery",
        "policy",
        "evidence",
        "operations"
      ],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name",
            "version",
            "record"
          ],
          "properties": {
            "type": {
              "enum": [
                "helm",
                "aicr",
                "timoni",
                "cub-installer",
                "kubara",
                "sveltos",
                "source-oci",
                "configuration-oci",
                "kubernetes-yaml",
                "confighub",
                "rendered-config"
              ]
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "record": {
              "type": "string"
            },
            "packageOciRef": {
              "type": "string"
            }
          }
        },
        "baseVariant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "revision",
            "digest",
            "digestRole",
            "digestRecord"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            },
            "digestRole": {
              "enum": [
                "helm-variant-revision",
              "aicr-platform-index",
              "source-output-inventory",
              "literal-configuration-oci-manifest",
                "source-package-oci-manifest",
              "source-module-oci-manifest",
              "source-file-set",
              "confighub-space-revision",
              "source-file",
                "source-output-record"
              ]
            },
            "digestRecord": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "objects",
            "inventory",
            "objectCount",
            "digest",
            "digestRole",
            "digestRecord"
          ],
          "properties": {
            "format": {
              "type": "string"
            },
            "objects": {
              "type": "string"
            },
            "inventory": {
              "type": "string"
            },
            "objectCount": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:)?[a-f0-9]{64}$"
            },
            "digestRole": {
              "enum": [
                "canonical-object-set",
                "inventory-file",
                "literal-yaml-file"
              ]
            },
            "digestRecord": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "processing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceIntent",
            "materialization",
            "flattening",
            "boundaries"
          ],
          "properties": {
            "sourceIntent": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "record"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "recorded",
                    "partial",
                    "gap"
                  ]
                },
                "record": {
                  "type": "string"
                }
              }
            },
            "materialization": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "status",
                "outputDigest",
                "record"
              ],
              "properties": {
                "method": {
                  "enum": [
                    "helm-render",
                    "aicr-compose",
                    "aicr-compose-then-helm-render",
                    "timoni-build",
                    "generator",
                    "source-oci-processor",
                    "read-literal-configuration",
                    "read-confighub-revision"
                  ]
                },
                "status": {
                  "enum": [
                    "captured",
                    "recorded-no-op",
                    "not-run",
                    "gap"
                  ]
                },
                "outputDigest": {
                  "type": "string"
                },
                "record": {
                  "type": "string"
                }
              }
            },
            "flattening": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "verdict",
                "action",
                "scope",
                "record"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "decided",
                    "not-assessed"
                  ]
                },
                "verdict": {
                  "enum": [
                    "born-flattened",
                    "safe-to-flatten",
                    "flatten-with-routes",
                    "unsafe-to-flatten",
                    "not-assessed"
                  ]
                },
                "action": {
                  "enum": [
                    "retain-exact-objects",
                    "retain-exact-objects-with-routes",
                    "process-source-late",
                    "assessment-required"
                  ]
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "record": {
                  "type": "string"
                }
              }
            },
            "boundaries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fixedAtBuildTime",
            "installTime",
            "installTimeStatus"
          ],
          "properties": {
            "fixedAtBuildTime": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "installTime": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "installTimeStatus": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirements",
            "routeIntent",
            "targetFacts",
            "resolution"
          ],
          "properties": {
            "requirements": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "items",
                "records"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "recorded",
                    "not-required",
                    "gap"
                  ]
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "origin",
                      "type",
                      "detail"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "origin": {
                        "enum": [
                          "source",
                          "base",
                          "variant",
                          "destination"
                        ]
                      },
                      "type": {
                        "enum": [
                          "lifecycle-action",
                          "target-fact",
                          "target-facts"
                        ]
                      },
                      "detail": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "records": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "routeIntent": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "routes",
                "records"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "recorded",
                    "required-at-destination",
                    "not-required",
                    "gap"
                  ]
                },
                "routes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "requirementRefs",
                      "phase",
                      "proposedActor",
                      "proposedMechanism",
                      "automatic",
                      "status",
                      "sourceStatus",
                      "supportedRuntimes",
                      "checks",
                      "evidence"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "requirementRefs": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "phase": {
                        "enum": [
                          "pre-render",
                          "preflight",
                          "pre-apply",
                          "apply",
                          "post-apply",
                          "observe",
                          "cleanup",
                          "destination-resolution"
                        ]
                      },
                      "proposedActor": {
                        "type": "string",
                        "minLength": 1
                      },
                      "proposedMechanism": {
                        "type": "string",
                        "minLength": 1
                      },
                      "automatic": {
                        "type": "boolean"
                      },
                      "status": {
                        "enum": [
                          "recorded",
                          "requires-destination-resolution",
                          "blocked"
                        ]
                      },
                      "sourceStatus": {
                        "type": "string",
                        "minLength": 1
                      },
                      "supportedRuntimes": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "checks": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "evidence": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "orderHint": {
                        "oneOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "string",
                            "minLength": 1
                          }
                        ]
                      }
                    }
                  }
                },
                "records": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "targetFacts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "declared",
                "requirementRefs",
                "records"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "recorded",
                    "not-required",
                    "gap"
                  ]
                },
                "declared": {
                  "type": "object"
                },
                "requirementRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "records": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "resolution": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "rule",
                "records"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "awaits-variant-and-target",
                    "resolved-for-recorded-targets",
                    "not-required",
                    "blocked",
                    "gap"
                  ]
                },
                "rule": {
                  "type": "string",
                  "minLength": 1
                },
                "records": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "sourceControlled",
            "variantControlled",
            "targetSupplied",
            "deliveryProtected",
            "records",
            "rule"
          ],
          "properties": {
            "status": {
              "enum": [
                "declared",
                "partly-declared",
                "not-assessed"
              ]
            },
            "sourceControlled": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "variantControlled": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "targetSupplied": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deliveryProtected": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "records": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rule": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literalConfigOci",
            "configHubReleaseOci",
            "argoCd",
            "flux"
          ],
          "properties": {
            "sourcePackageOci": {
              "type": "object"
            },
            "literalConfigOci": {
              "type": "object"
            },
            "configHubUpload": {
              "type": "object"
            },
            "configHubReleaseOci": {
              "type": "object"
            },
            "argoCd": {
              "type": "string"
            },
            "flux": {
              "type": "string"
            },
            "direct": {
              "type": "string"
            },
            "historicalGitopsOciStatus": {
              "type": "string"
            },
            "receipt": {
              "type": "string"
            }
          }
        },
        "promotion": {
          "type": "object"
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "productionAdds"
          ],
          "properties": {
            "profile": {
              "type": "string"
            },
            "productionAdds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "normalSet": {
              "type": "string",
              "enum": [
                "baseline",
                "approvalRequired"
              ]
            },
            "approvalReason": {
              "type": "string",
              "enum": [
                "production",
                "system-configuration"
              ]
            }
          }
        },
        "evidence": {
          "type": "object"
        },
        "operations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resourceClass",
            "ownerClass",
            "changeCadence"
          ],
          "properties": {
            "resourceClass": {
              "type": "string"
            },
            "ownerClass": {
              "type": "string"
            },
            "changeCadence": {
              "type": "string"
            },
            "classificationSource": {
              "type": "string"
            },
            "classificationReason": {
              "type": "string"
            },
            "liveSpace": {
              "type": "string"
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "ownerClass",
                "selection"
              ],
              "properties": {
                "scope": {
                  "type": "string"
                },
                "ownerClass": {
                  "type": "string"
                },
                "selection": {
                  "type": "string"
                }
              }
            },
            "gates": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "normalSet",
                "productionSet"
              ],
              "properties": {
                "normalSet": {
                  "enum": [
                    "baseline",
                    "approvalRequired"
                  ]
                },
                "productionSet": {
                  "const": "approvalRequired"
                }
              }
            },
            "rollout": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "sequence",
                "status",
                "limit"
              ],
              "properties": {
                "method": {
                  "type": "string"
                },
                "sequence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "status": {
                  "type": "string"
                },
                "limit": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "claim",
        "limits"
      ],
      "properties": {
        "level": {
          "enum": [
            "available",
            "partial",
            "planned"
          ]
        },
        "claim": {
          "type": "string"
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
