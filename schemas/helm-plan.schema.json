{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confighub.com/helm-expt/schemas/helm-plan.schema.json",
  "title": "Helm Plan",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "common-defs.schema.json#/$defs/apiVersion" },
    "kind": { "const": "HelmPlan" },
    "metadata": { "$ref": "common-defs.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "required": ["readiness", "receipts"],
      "properties": {
        "readiness": {
          "type": "object",
          "required": ["status", "chart", "version", "variants"],
          "properties": {
            "status": { "type": "string", "minLength": 1 },
            "chart": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "variants": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": true
        },
        "receipts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common-defs.schema.json#/$defs/relativePath" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
