        "remedy_type": "config_fix",
        "remedy_safety": "safe_auto",
        "remediation": {
          "steps": [
            "Add pod-level securityContext defaults where appropriate",
            "Add container-level securityContext for least-privilege execution",
            "Validate runAsNonRoot and privilege escalation policy before deploy"
          ],
          "commands": [
            "kubectl get deployment <name> -n <namespace> -o yaml | grep -A20 securityContext",
            "kubectl patch deployment <name> -n <namespace> --type=merge -p '{\"spec\":{\"template\":{\"spec\":{\"securityContext\":{\"runAsNonRoot\":true}}}}}'"
