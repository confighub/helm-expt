        "message": "Multi-replica Deployment has no podAntiAffinity; replicas may land on same node",
        "remedy_type": "config_fix",
        "remedy_safety": "safe_auto",
        "remediation": {
          "steps": [
            "Add podAntiAffinity with preferredDuringSchedulingIgnoredDuringExecution",
            "Use topologyKey kubernetes.io/hostname to spread across nodes",
            "For strict HA use requiredDuringSchedulingIgnoredDuringExecution"
          ],
          "commands": [
            "kubectl get deployment <name> -n <namespace> -o jsonpath='{.spec.template.spec.affinity}'"
          ]
        },
        "evidence_source": "native",
