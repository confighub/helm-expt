        "id": "CCVE-2025-3726",
        "name": "Deployment omits pod and container securityContext baseline",
        "category": "CONFIG",
        "track": "misconfiguration",
        "detection_method": "native_rule",
        "severity": "warning",
        "confidence": "high",
        "tool": "kubernetes",
        "resource": {
          "kind": "Deployment",
          "name": "labeler",
          "namespace": "default"
        },
        "message": "Deployment omits pod and container securityContext settings",
        "remedy_type": "config_fix",
        "remedy_safety": "safe_auto",
        "remediation": {
          "steps": [
            "Add pod-level securityContext defaults where appropriate",
            "Add container-level securityContext for least-privilege execution",
            "Validate runAsNonRoot and privilege escalation policy before deploy"
          ],
          "commands": [
            "kubectl get deployment <name> -n <namespace> -o yaml | grep -A20 securityContext",
            "kubectl patch deployment <name> -n <namespace> --type=merge -p '{\"spec\":{\"template\":{\"spec\":{\"securityContext\":{\"runAsNonRoot\":true}}}}}'"
          ]
        },
        "evidence_source": "native",
        "action_type": "mutating",
        "next_step": {
          "action": "apply_fix",
          "description": "Add pod-level securityContext defaults where appropriate",
          "command": "kubectl get deployment <name> -n <namespace> -o yaml | grep -A20 securityContext",
          "doc_ref": "cub-scan --explain CCVE-2025-3726"
        }
