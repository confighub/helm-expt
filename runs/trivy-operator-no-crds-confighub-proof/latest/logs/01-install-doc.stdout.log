{
  "apiVersion": "installer.confighub.com/v1alpha1",
  "kind": "Package",
  "metadata": {
    "name": "aqua-trivy-operator"
  },
  "installerMetadata": {},
  "spec": {
    "bases": [
      {
        "name": "default",
        "path": "bases/default",
        "default": true,
        "description": "aqua/trivy-operator default variant rendered from aqua/trivy-operator@0.32.1"
      },
      {
        "name": "no-crds",
        "path": "bases/no-crds",
        "description": "aqua/trivy-operator no-crds variant rendered from aqua/trivy-operator@0.32.1",
        "externalRequires": [
          {
            "kind": "ClusterFeature",
            "name": "CRD clustercompliancereports.aquasecurity.github.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          },
          {
            "kind": "ClusterFeature",
            "name": "CRD clusterconfigauditreports.aquasecurity.github.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          },
          {
            "kind": "ClusterFeature",
            "name": "CRD clusterinfraassessmentreports.aquasecurity.github.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          },
          {
            "kind": "ClusterFeature",
            "name": "CRD clusterrbacassessmentreports.aquasecurity.github.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          },
          {
            "kind": "ClusterFeature",
            "name": "CRD clustersbomreports.aquasecurity.github.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          },
          {
            "kind": "ClusterFeature",
            "name": "CRD clustervulnerabilityreports.aquasecurity.github.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          },
          {
            "kind": "ClusterFeature",
            "name": "CRD configauditreports.aquasecurity.github.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          },
          {
            "kind": "ClusterFeature",
            "name": "CRD exposedsecretreports.aquasecurity.github.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          },
          {
            "kind": "ClusterFeature",
            "name": "CRD infraassessmentreports.aquasecurity.github.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          },
          {
            "kind": "ClusterFeature",
            "name": "CRD rbacassessmentreports.aquasecurity.github.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          },
          {
            "kind": "ClusterFeature",
            "name": "CRD sbomreports.aquasecurity.github.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          },
          {
            "kind": "ClusterFeature",
            "name": "CRD vulnerabilityreports.aquasecurity.github.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          }
        ]
      }
    ],
    "collector": {
      "command": "/bin/sh",
      "args": [
        "collector/target-facts.sh"
      ],
      "description": "Records target-fact bindings and can live-check existing Secret requirements."
    }
  }
}
