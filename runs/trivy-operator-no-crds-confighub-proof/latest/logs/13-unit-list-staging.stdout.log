      "LastChangeDescription": "Functions: get-resources",
      "MutationSources": [
        {
          "Aliases": {
            "/k8s-pss-restricted-0.1": {}
          },
          "AliasesWithoutScopes": {
            "k8s-pss-restricted-0.1": {}
