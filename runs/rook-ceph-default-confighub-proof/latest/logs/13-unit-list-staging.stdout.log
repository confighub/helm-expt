assed to the NFS server pods).\n                        properties:\n                          volumeSource:\n                            properties:\n                              configMap:\n                                properties:\n                                  defaultMode:\n                                    format: int32\n                                    type: integer\n                                  items:\n                                    items:\n                                      properties:\n                                        key:\n                                          type: string\n                                        mode:\n                                          format: int32\n                                          type: integer\n                                        path:\n                                          type: string\n                                      required:\n                                      - key\n                                      - path\n                                      type: object\n                                    type: array\n                                    x-kubernetes-list-type: atomic\n                                  name:\n                                    default: \"\"\n                                    type: string\n                                  optional:\n                                    type: boolean\n                                type: object\n                                x-kubernetes-map-type: atomic\n                              emptyDir:\n                                properties:\n                                  medium:\n                                    type: string\n                                  sizeLimit:\n                                    anyOf:\n                                    - type: integer\n                                    - type: string\n                                    pattern: ^(\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\