      "LastChangeDescription": "Initial Data: 21209 bytes; from configmap-default-cnpg-default-monitoring.yaml",
      "MutationSources": [
        {
          "Aliases": {
            "default/cnpg-default-monitoring": {}
          },
          "AliasesWithoutScopes": {
