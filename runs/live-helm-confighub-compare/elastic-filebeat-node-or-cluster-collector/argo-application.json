{
  "apiVersion": "argoproj.io/v1alpha1",
  "kind": "Application",
  "metadata": {
    "name": "filebeat-parity",
    "namespace": "argocd"
  },
  "spec": {
    "project": "default",
    "source": {
      "repoURL": "oci://oci.hub.confighub.com:443/target/helm-expt-parity-filebeat-mqfc8opn-qzo-cluster/oci",
      "targetRevision": "latest",
      "path": "./helm-expt-parity-filebeat-mqfc8opn-qzo-filebeat"
    },
    "destination": {
      "server": "https://kubernetes.default.svc",
      "namespace": "default-oci"
    },
    "syncPolicy": {
      "automated": {
        "selfHeal": true,
        "prune": true
      },
      "syncOptions": [
        "ServerSideApply=true",
        "CreateNamespace=true"
      ]
    }
  }
}