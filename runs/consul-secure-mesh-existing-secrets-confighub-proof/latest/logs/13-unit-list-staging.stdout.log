          "ResourceMutationInfo": {
            "Index": 1,
            "MutationType": "Add",
            "Predicate": true,
            "Value": "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  labels:\n    app: consul\n    chart: consul-helm\n    component: terminating-gateway\n    heritage: Helm\n    release: consul\n    terminating-gateway-name: consul-consul-terminating-gateway\n  name: consul-consul-terminating-gateway\n  namespace: consul\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app: consul\n      chart: consul-helm\n      component: terminating-gateway\n      heritage: Helm\n      release: consul\n      terminating-gateway-name: consul-consul-terminating-gateway\n  template:\n    metadata:\n      annotations:\n        consul.hashicorp.com/connect-inject: \"false\"\n        consul.hashicorp.com/gateway-consul-service-name: terminating-gateway\n        consul.hashicorp.com/gateway-kind: terminating-gateway\n        consul.hashicorp.com/mesh-inject: \"false\"\n      labels:\n        app: consul\n        chart: consul-helm\n        component: terminating-gateway\n        consul.hashicorp.com/connect-inject-managed-by: consul-k8s-endpoints-controller\n        heritage: Helm\n        release: consul\n        terminating-gateway-name: consul-consul-terminating-gateway\n    spec:\n      containers:\n      - args:\n        - -addresses=consul-consul-server.consul.svc\n        - -grpc-port=8502\n        - -proxy-service-id-path=/consul/service/proxy-id\n        - -ca-certs=/consul/tls/ca/tls.crt\n        - -credential-type=login\n        - -login-bearer-token-path=/var/run/secrets/kubernetes.io/serviceaccount/token\n        - -login-auth-method=consul-consul-k8s-component-auth-method\n        - -log-level=info\n        - -log-json=false\n        - -envoy-admin-bind-address=127.0.0.1\n        - -xds-bind-addr=127.0.0.1\n        - -graceful-addr=127.0.0.1\n        - -consul-dns-bind-addr=127.0.0.1\n        command:\n        - consul-dataplane\n        env:\n        - name: NAMESPACE\n          valueFrom:\n            fieldRef:\n              fieldPath: metadata.namespace\n        - name: POD_NAME\n          valueFrom:\n            fieldRef:\n              fieldPath: metadata.name\n        - name: NODE_NAME\n          valueFrom:\n            fieldRef:\n              fieldPath: spec.nodeName\n        - name: DP_CREDENTIAL_LOGIN_META1\n          value: pod=$(NAMESPACE)/$(POD_NAME)\n        - name: DP_CREDENTIAL_LOGIN_META2\n          value: component=terminating-gateway\n        - name: DP_SERVICE_NODE_NAME\n          value: $(NODE_NAME)-virtual\n        - name: DP_ENVOY_READY_BIND_ADDRESS\n          valueFrom:\n            fieldRef:\n              fieldPath: status.podIP\n        image: hashicorp/consul-dataplane:2.0.0\n        livenessProbe:\n          failureThreshold: 3\n          initialDelaySeconds: 30\n          periodSeconds: 10\n          successThreshold: 1\n          tcpSocket:\n            port: 8443\n          timeoutSeconds: 5\n        name: terminating-gateway\n        ports:\n        - containerPort: 8443\n          name: gateway\n        readinessProbe:\n          failureThreshold: 3\n          initialDelaySeconds: 10\n          periodSeconds: 10\n          successThreshold: 1\n          tcpSocket:\n            port: 8443\n          timeoutSeconds: 5\n        resources:\n          limits:\n            cpu: 100m\n            memory: 100Mi\n          requests:\n            cpu: 100m\n            memory: 100Mi\n        securityContext:\n          allowPrivilegeEscalation: false\n          capabilities:\n            drop:\n            - ALL\n          readOnlyRootFilesystem: true\n          runAsNonRoot: true\n          runAsUser: 100\n          seccompProfile:\n            type: RuntimeDefault\n        volumeMounts:\n        - mountPath: /tmp\n          name: tmp\n        - mountPath: /consul/service\n          name: consul-service\n          readOnly: true\n        - mountPath: /consul/tls/ca\n          name: consul-ca-cert\n          readOnly: true\n      initContainers:\n      - command:\n        - /bin/sh\n        - -ec\n        - |\n          exec consul-k8s-control-plane connect-init -pod-name=${POD_NAME} -pod-namespace=${NAMESPACE} \\\n              -gateway-kind=\"terminating-gateway\" \\\n              -proxy-id-file=/consul/service/proxy-id \\\n              -service-name=terminating-gateway \\\n              -log-level=info \\\n              -log-json=false\n        env:\n        - name: NAMESPACE\n          valueFrom:\n            fieldRef:\n              fieldPath: metadata.namespace\n        - name: POD_NAME\n          valueFrom:\n            fieldRef:\n              fieldPath: metadata.name\n        - name: NODE_NAME\n          valueFrom:\n            fieldRef:\n              fieldPath: spec.nodeName\n        - name: CONSUL_ADDRESSES\n          value: consul-consul-server.consul.svc\n        - name: CONSUL_GRPC_PORT\n          value: \"8502\"\n        - name: CONSUL_HTTP_PORT\n          value: \"8501\"\n        - name: CONSUL_DATACENTER\n          value: dc1\n        - name: CONSUL_API_TIMEOUT\n          value: 5s\n        - name: CONSUL_USE_TLS\n          value: \"true\"\n        - name: CONSUL_CACERT_FILE\n          value: /consul/tls/ca/tls.crt\n        - name: CONSUL_LOGIN_AUTH_METHOD\n          value: consul-consul-k8s-component-auth-method\n        - name: CONSUL_LOGIN_DATACENTER\n          value: dc1\n        - name: CONSUL_LOGIN_META\n          value: component=terminating-gateway,pod=$(NAMESPACE)/$(POD_NAME)\n        - name: CONSUL_NODE_NAME\n          value: $(NODE_NAME)-virtual\n        image: hashicorp/consul-k8s-control-plane:2.0.0\n        name: terminating-gateway-init\n        resources:\n          limits:\n            cpu: 50m\n            memory: 50Mi\n          requests:\n            cpu: 50m\n            memory: 50Mi\n        securityContext:\n          allowPrivilegeEscalation: false\n          capabilities:\n            drop:\n            - ALL\n          readOnlyRootFilesystem: true\n          runAsNonRoot: true\n          runAsUser: 100\n          seccompProfile:\n            type: RuntimeDefault\n        volumeMounts:\n        - mountPath: /tmp\n          name: tmp\n        - mountPath: /consul/service\n          name: consul-service\n        - mountPath: /consul/tls/ca\n          name: consul-ca-cert\n          readOnly: true\n      serviceAccountName: consul-consul-terminating-gateway\n      terminationGracePeriodSeconds: 10\n      volumes:\n      - emptyDir:\n          medium: Memory\n        name: tmp\n      - emptyDir:\n          medium: Memory\n        name: consul-service\n      - name: consul-ca-cert\n        secret:\n          items:\n          - key: tls.crt\n            path: tls.crt\n          secretName: consul-ca-cert\n"
