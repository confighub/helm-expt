          "PathMutationMap": {},
          "Resource": {
            "ResourceCategory": "Resource",
            "ResourceName": "consul/consul-consul-server-acl-init",
            "ResourceNameWithoutScope": "consul-consul-server-acl-init",
            "ResourceType": "batch/v1/Job"
          },
          "ResourceMutationInfo": {
            "Index": 1,
            "MutationType": "Add",
            "Predicate": true,
            "Value": "apiVersion: batch/v1\nkind: Job\nmetadata:\n  labels:\n    app: consul\n    chart: consul-helm\n    component: server-acl-init\n    heritage: Helm\n    release: consul\n  name: consul-consul-server-acl-init\n  namespace: consul\nspec:\n  template:\n    metadata:\n      annotations:\n        consul.hashicorp.com/connect-inject: \"false\"\n        consul.hashicorp.com/mesh-inject: \"false\"\n      labels:\n        app: consul\n        chart: consul-helm\n        component: server-acl-init\n        release: consul\n      name: consul-consul-server-acl-init\n    spec:\n      containers:\n      - command:\n        - /bin/sh\n        - -ec\n        - |\n          CONSUL_FULLNAME=\"consul-consul\"\n\n          exec consul-k8s-control-plane server-acl-init \\\n            -log-level=info \\\n            -log-json=false \\\n            -resource-prefix=${CONSUL_FULLNAME} \\\n            -k8s-namespace=consul \\\n            -set-server-tokens=true \\\n            -secrets-backend=kubernetes \\\n            -bootstrap-token-secret-name=consul-bootstrap-acl-token \\\n            -bootstrap-token-secret-key=token \\\n            -allow-dns=true \\\n            -connect-inject=true \\\n            -mesh-gateway=true \\\n            -ingress-gateway-name=\"ingress-gateway\" \\\n            -terminating-gateway-name=\"terminating-gateway\" \\\n            -acl-binding-rule-selector=serviceaccount.name!=default \\\n            -client=false \\\n        env:\n        - name: NAMESPACE\n          valueFrom:\n            fieldRef:\n              fieldPath: metadata.namespace\n        - name: POD_NAME\n          valueFrom:\n            fieldRef:\n              fieldPath: metadata.name\n        - name: CONSUL_ADDRESSES\n          value: consul-consul-server.consul.svc\n        - name: CONSUL_GRPC_PORT\n          value: \"8502\"\n        - name: CONSUL_HTTP_PORT\n          value: \"8501\"\n        - name: CONSUL_DATACENTER\n          value: dc1\n        - name: CONSUL_API_TIMEOUT\n          value: 5s\n        - name: CONSUL_USE_TLS\n          value: \"true\"\n        - name: CONSUL_CACERT_FILE\n          value: /consul/tls/ca/tls.crt\n        image: hashicorp/consul-k8s-control-plane:2.0.0\n        name: server-acl-init-job\n        resources:\n          limits:\n            cpu: 50m\n            memory: 50Mi\n          requests:\n            cpu: 50m\n            memory: 50Mi\n        securityContext:\n          allowPrivilegeEscalation: false\n          capabilities:\n            drop:\n            - ALL\n          readOnlyRootFilesystem: true\n          runAsNonRoot: true\n          runAsUser: 100\n          seccompProfile:\n            type: RuntimeDefault\n        volumeMounts:\n        - mountPath: /consul/tls/ca\n          name: consul-ca-cert\n          readOnly: true\n      restartPolicy: Never\n      serviceAccountName: consul-consul-server-acl-init\n      volumes:\n      - name: consul-ca-cert\n        secret:\n          items:\n          - key: tls.crt\n            path: tls.crt\n          secretName: consul-ca-cert\n"
          }
        }
      ],
