          "ResourceMutationInfo": {
            "Index": 1,
            "MutationType": "Add",
            "Predicate": true,
            "Value": "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  labels:\n    app: terraform\n    chart: terraform-helm\n    heritage: Helm\n    release: terraform\n  name: terraform-terraform-sync-workspace\n  namespace: default\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app: terraform\n      chart: terraform-helm\n      component: sync-workspace\n      release: terraform\n  template:\n    metadata:\n      labels:\n        app: terraform\n        chart: terraform-helm\n        component: sync-workspace\n        release: terraform\n    spec:\n      containers:\n      - args:\n        - --enable-leader-election\n        - --k8s-watch-namespace=default\n        command:\n        - /bin/terraform-k8s\n        env:\n        - name: POD_NAME\n          valueFrom:\n            fieldRef:\n              fieldPath: metadata.name\n        - name: OPERATOR_NAME\n          value: terraform-k8s\n        - name: TF_VERSION\n          value: latest\n        - name: TF_CLI_CONFIG_FILE\n          value: /etc/terraform/.terraformrc\n        - name: TF_URL\n          value: \"\"\n        image: hashicorp/terraform-k8s:1.1.2\n        imagePullPolicy: IfNotPresent\n        livenessProbe:\n          failureThreshold: 3\n          httpGet:\n            path: /metrics\n            port: 8383\n            scheme: HTTP\n          initialDelaySeconds: 30\n          periodSeconds: 5\n          successThreshold: 1\n          timeoutSeconds: 5\n        name: terraform-sync-workspace\n        readinessProbe:\n          failureThreshold: 5\n          httpGet:\n            path: /metrics\n            port: 8383\n            scheme: HTTP\n          initialDelaySeconds: 10\n          periodSeconds: 5\n          successThreshold: 1\n          timeoutSeconds: 5\n        volumeMounts:\n        - mountPath: /etc/terraform\n          name: terraformrc\n          readOnly: true\n        - mountPath: /tmp/secrets\n          name: sensitivevars\n          readOnly: true\n      serviceAccountName: terraform-terraform-sync-workspace\n      volumes:\n      - name: terraformrc\n        secret:\n          items:\n          - key: credentials\n            path: .terraformrc\n          secretName: terraformrc\n      - name: sensitivevars\n        secret:\n          secretName: workspacesecrets\n"
