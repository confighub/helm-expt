            "Index": 1,
            "MutationType": "Add",
            "Predicate": true,
            "Value": "apiVersion: apps/v1\nkind: DaemonSet\nmetadata:\n  labels:\n    app: longhorn-manager\n    app.kubernetes.io/instance: longhorn\n    app.kubernetes.io/managed-by: Helm\n    app.kubernetes.io/name: longhorn\n    app.kubernetes.io/version: v1.11.2\n    helm.sh/chart: longhorn-1.11.2\n  name: longhorn-manager\n  namespace: longhorn-system\nspec:\n  selector:\n    matchLabels:\n      app: longhorn-manager\n  template:\n    metadata:\n      labels:\n        app: longhorn-manager\n        app.kubernetes.io/instance: longhorn\n        app.kubernetes.io/managed-by: Helm\n        app.kubernetes.io/name: longhorn\n        app.kubernetes.io/version: v1.11.2\n        helm.sh/chart: longhorn-1.11.2\n    spec:\n      containers:\n      - command:\n        - longhorn-manager\n        - -d\n        - daemon\n        - --engine-image\n        - docker.io/longhornio/longhorn-engine:v1.11.2\n        - --instance-manager-image\n        - docker.io/longhornio/longhorn-instance-manager:v1.11.2\n        - --share-manager-image\n        - docker.io/longhornio/longhorn-share-manager:v1.11.2\n        - --backing-image-manager-image\n        - docker.io/longhornio/backing-image-manager:v1.11.2\n        - --support-bundle-manager-image\n        - docker.io/longhornio/support-bundle-kit:v0.0.84\n        - --manager-image\n        - docker.io/longhornio/longhorn-manager:v1.11.2\n        - --service-account\n        - longhorn-service-account\n        - --upgrade-version-check\n        env:\n        - name: POD_NAME\n          valueFrom:\n            fieldRef:\n              fieldPath: metadata.name\n        - name: POD_NAMESPACE\n          valueFrom:\n            fieldRef:\n              fieldPath: metadata.namespace\n        - name: POD_IP\n          valueFrom:\n            fieldRef:\n              fieldPath: status.podIP\n        - name: NODE_NAME\n          valueFrom:\n            fieldRef:\n              fieldPath: spec.nodeName\n        image: docker.io/longhornio/longhorn-manager:v1.11.2\n        imagePullPolicy: IfNotPresent\n        name: longhorn-manager\n        ports:\n        - containerPort: 9500\n          name: manager\n        - containerPort: 9502\n          name: admission-wh\n        - containerPort: 9503\n          name: recov-backend\n        readinessProbe:\n          httpGet:\n            path: /v1/healthz\n            port: 9502\n            scheme: HTTPS\n        securityContext:\n          privileged: true\n        volumeMounts:\n        - mountPath: /host/boot/\n          name: boot\n          readOnly: true\n        - mountPath: /host/dev/\n          name: dev\n        - mountPath: /host/proc/\n          name: proc\n          readOnly: true\n        - mountPath: /host/etc/\n          name: etc\n          readOnly: true\n        - mountPath: /var/lib/longhorn/\n          mountPropagation: Bidirectional\n          name: longhorn\n        - mountPath: /tls-files/\n          name: longhorn-grpc-tls\n      - command:\n        - sh\n        - -c\n        - echo share-manager image pulled \u0026\u0026 sleep infinity\n        image: docker.io/longhornio/longhorn-share-manager:v1.11.2\n        imagePullPolicy: IfNotPresent\n        name: pre-pull-share-manager-image\n      priorityClassName: longhorn-critical\n      serviceAccountName: longhorn-service-account\n      volumes:\n      - hostPath:\n          path: /boot/\n        name: boot\n      - hostPath:\n          path: /dev/\n        name: dev\n      - hostPath:\n          path: /proc/\n        name: proc\n      - hostPath:\n          path: /etc/\n        name: etc\n      - hostPath:\n          path: /var/lib/longhorn/\n        name: longhorn\n      - name: longhorn-grpc-tls\n        secret:\n          optional: true\n          secretName: longhorn-grpc-tls\n  updateStrategy:\n    rollingUpdate:\n      maxUnavailable: 100%\n"
