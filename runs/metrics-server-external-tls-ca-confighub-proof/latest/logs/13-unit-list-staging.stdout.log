etes/YAML\"\n    whereResource: \"{{ if eq .Selection.Base \\\"external-tls-ca\\\" }}ConfigHub.ResourceType = 'apiregistration.k8s.io/v1/APIService'{{ else }}ConfigHub.ResourceType = 'helm-expt.invalid/v1/Never'{{ end }}\"\n"
