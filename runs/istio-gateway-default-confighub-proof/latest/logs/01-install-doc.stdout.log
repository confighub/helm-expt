{
  "apiVersion": "installer.confighub.com/v1alpha1",
  "kind": "Package",
  "metadata": {
    "name": "istio-gateway"
  },
  "installerMetadata": {},
  "spec": {
    "bases": [
      {
        "name": "default",
        "path": "bases/default",
        "default": true,
        "description": "istio/gateway default variant rendered from istio/gateway@1.30.0"
      },
      {
        "name": "controller-default-reviewed",
        "path": "bases/controller-default-reviewed",
        "description": "istio/gateway controller-default-reviewed useful base; aliases the default render with a named user start path"
      }
    ]
  }
}
