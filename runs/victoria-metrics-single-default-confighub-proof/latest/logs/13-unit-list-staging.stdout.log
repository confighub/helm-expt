 securityContext: {}\n      serviceAccountName: victoria-metrics-single-server\n      terminationGracePeriodSeconds: 60\n      volumes: null\n  updateStrategy: {}\n  volumeClaimTemplates:\n  - apiVersion: v1\n    kind: PersistentVolumeClaim\n    metadata:\n      name: server-volume\n    spec:\n      accessModes:\n      - ReadWriteOnce\n      resources:\n        requests:\n          storage: 16Gi\n"
