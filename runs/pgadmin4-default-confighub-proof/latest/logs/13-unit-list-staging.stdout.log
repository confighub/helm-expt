            "Value": "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  labels:\n    app.kubernetes.io/instance: pgadmin4\n    app.kubernetes.io/managed-by: Helm\n    app.kubernetes.io/name: pgadmin4\n    app.kubernetes.io/version: \"9.13\"\n    helm.sh/chart: pgadmin4-1.62.0\n  name: pgadmin4\n  namespace: default\nspec:\n  replicas: 1\n  revisionHistoryLimit: 10\n  selector:\n    matchLabels:\n      app.kubernetes.io/instance: pgadmin4\n      app.kubernetes.io/name: pgadmin4\n  template:\n    metadata:\n      annotations:\n        checksum/secret: f051ba8327fad1a5a826eeed22fcbe3d5914d859153b920e6a854191183d3b6c\n      labels:\n        app.kubernetes.io/instance: pgadmin4\n        app.kubernetes.io/name: pgadmin4\n    spec:\n      automountServiceAccountToken: false\n      containers:\n      - env:\n        - name: PGADMIN_CONFIG_ENHANCED_COOKIE_PROTECTION\n          value: \"False\"\n        - name: PGADMIN_DEFAULT_EMAIL\n          value: chart@domain.com\n        - name: PGADMIN_DEFAULT_PASSWORD\n          valueFrom:\n            secretKeyRef:\n              key: password\n              name: pgadmin4\n        image: docker.io/dpage/pgadmin4:9.13\n        imagePullPolicy: IfNotPresent\n        livenessProbe:\n          failureThreshold: 3\n          httpGet:\n            path: /misc/ping\n            port: http\n            scheme: HTTP\n          periodSeconds: 20\n          timeoutSeconds: 5\n        name: pgadmin4\n        ports:\n        - containerPort: 80\n          name: http\n          protocol: TCP\n        readinessProbe:\n          failureThreshold: 3\n          httpGet:\n            path: /misc/ping\n            port: http\n            scheme: HTTP\n          periodSeconds: 10\n          timeoutSeconds: 3\n        resources: {}\n        startupProbe:\n          failureThreshold: 18\n          httpGet:\n            path: /misc/ping\n            port: http\n            scheme: HTTP\n          periodSeconds: 10\n        volumeMounts:\n        - mountPath: /var/lib/pgadmin\n          name: pgadmin-data\n          subPath: \"\"\n      securityContext:\n        fsGroup: 5050\n        runAsGroup: 5050\n        runAsUser: 5050\n      volumes:\n      - name: pgadmin-data\n        persistentVolumeClaim:\n          claimName: pgadmin4\n"
