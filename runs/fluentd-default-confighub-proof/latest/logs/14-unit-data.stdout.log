apiVersion: apps/v1
kind: DaemonSet
metadata:
  labels:
    app.kubernetes.io/instance: fluentd
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/name: fluentd
    app.kubernetes.io/version: v1.17.1
    helm.sh/chart: fluentd-0.5.3
  name: fluentd
spec:
  selector:
    matchLabels:
      app.kubernetes.io/instance: fluentd
      app.kubernetes.io/name: fluentd
  template:
    metadata:
      annotations:
        checksum/config: b4148ec5962a6f33cbf0c5274b67acd2c4f76a206821154bb8af50565d96844a
      labels:
        app.kubernetes.io/instance: fluentd
        app.kubernetes.io/name: fluentd
    spec:
      containers:
      - env:
        - name: FLUENTD_CONF
          value: ../../../etc/fluent/fluent.conf
        image: fluent/fluentd-kubernetes-daemonset:v1.17.1-debian-elasticsearch7-1.2
        imagePullPolicy: IfNotPresent
        livenessProbe:
          httpGet:
            path: /metrics
            port: metrics
        name: fluentd
        ports:
        - containerPort: 24231
          name: metrics
          protocol: TCP
        readinessProbe:
          httpGet:
            path: /metrics
            port: metrics
        resources: {}
        securityContext: {}
        volumeMounts:
        - mountPath: /etc/fluent
          name: etcfluentd-main
        - mountPath: /etc/fluent/config.d/
          name: etcfluentd-config
        - mountPath: /var/log
          name: varlog
        - mountPath: /var/lib/docker/containers
          name: varlibdockercontainers
          readOnly: true
      securityContext: {}
      serviceAccountName: fluentd
      volumes:
      - configMap:
          defaultMode: 511
          name: fluentd-main-fluentd
        name: etcfluentd-main
      - configMap:
          defaultMode: 511
          name: fluentd-config-fluentd
        name: etcfluentd-config
      - hostPath:
          path: /var/log
        name: varlog
      - hostPath:
          path: /var/lib/docker/containers
        name: varlibdockercontainers
