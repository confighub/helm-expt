          "Resource": {
            "ResourceCategory": "Resource",
            "ResourceName": "/apiportalauths.hub.traefik.io",
            "ResourceNameWithoutScope": "apiportalauths.hub.traefik.io",
            "ResourceType": "apiextensions.k8s.io/v1/CustomResourceDefinition"
