{
  "apiVersion": "installer.confighub.com/v1alpha1",
  "kind": "Package",
  "metadata": {
    "name": "open-telemetry-opentelemetry-operator"
  },
  "installerMetadata": {},
  "spec": {
    "bases": [
      {
        "name": "default",
        "path": "bases/default",
        "default": true,
        "description": "open-telemetry/opentelemetry-operator default variant rendered from open-telemetry/opentelemetry-operator@0.114.0",
        "externalRequires": [
          {
            "kind": "ClusterFeature",
            "name": "Secret default/opentelemetry-operator-controller-manager-service-cert keys tls.crt,tls.key",
            "namespace": "default",
            "suggestedSource": "Run cert-manager controller to satisfy the chart-rendered Certificate, or stage a valid TLS Secret before waiting for the operator"
          },
          {
            "kind": "ClusterFeature",
            "name": "CRD certificates.cert-manager.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          },
          {
            "kind": "ClusterFeature",
            "name": "CRD issuers.cert-manager.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          }
        ]
      },
      {
        "name": "no-crds",
        "path": "bases/no-crds",
        "description": "open-telemetry/opentelemetry-operator no-crds variant rendered from open-telemetry/opentelemetry-operator@0.114.0",
        "externalRequires": [
          {
            "kind": "ClusterFeature",
            "name": "Secret default/opentelemetry-operator-controller-manager-service-cert keys tls.crt,tls.key",
            "namespace": "default",
            "suggestedSource": "Run cert-manager controller to satisfy the chart-rendered Certificate, or stage a valid TLS Secret before waiting for the operator"
          },
          {
            "kind": "ClusterFeature",
            "name": "CRD certificates.cert-manager.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          },
          {
            "kind": "ClusterFeature",
            "name": "CRD issuers.cert-manager.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          },
          {
            "kind": "ClusterFeature",
            "name": "CRD instrumentations.opentelemetry.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          },
          {
            "kind": "ClusterFeature",
            "name": "CRD opampbridges.opentelemetry.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          },
          {
            "kind": "ClusterFeature",
            "name": "CRD opentelemetrycollectors.opentelemetry.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          },
          {
            "kind": "ClusterFeature",
            "name": "CRD targetallocators.opentelemetry.io",
            "suggestedSource": "kubectl apply -f \u003ccrd-manifest.yaml\u003e"
          }
        ]
      }
    ],
    "collector": {
      "command": "/bin/sh",
      "args": [
        "collector/target-facts.sh"
      ],
      "description": "Records target-fact bindings and can live-check existing Secret requirements."
    }
  }
}
