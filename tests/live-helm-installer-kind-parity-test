def stage_target_facts(
    variant: dict,
    recipe_path: Path,
    kubeconfig: Path,
    context: str,
    fallback_namespace: str,
    run_root: Path,
    label: str,
    lane: str,
    package_path: Path | None = None,
) -> dict:
    required_secrets = [
        secret
        for secret in (((variant.get("spec") or {}).get("targetFacts") or {}).get("requiredSecrets") or [])
        if target_fact_applies(secret, lane)
    ]
    crd_docs, staged_crds = target_fact_crd_docs(
        variant,
        recipe_path,
        run_root,
        lane,
        package_path,
    )
    operator_bootstraps = target_fact_operator_bootstraps(
        variant,
        recipe_path,
        lane,
        package_path,
    )
    required_object_stores = target_fact_object_stores(variant, lane)
    required_namespaces = target_fact_namespaces(variant, lane)
    if not required_secrets and not crd_docs and not operator_bootstraps and not required_object_stores and not required_namespaces:
        return {"result": "pass", "stagedSecrets": [], "stagedCRDs": [], "stagedObjectStores": [], "stagedNamespaces": []}
    secret_docs = []
    namespaces = {namespace.get("name") for namespace in required_namespaces if namespace.get("name")}
    staged_secrets = []
    staged_object_stores = []
    staged_namespaces = []
    object_store_docs = []
    for secret in required_secrets:
        namespace = secret.get("namespace") or fallback_namespace
        name = secret.get("name")
        keys = secret.get("keys") or []
        if not name or not keys:
            raise RuntimeError(f"invalid required secret target fact: {secret}")
        namespaces.add(namespace)
        string_data = {key: target_fact_value(name, key, run_root) for key in keys}
        secret_type = "kubernetes.io/tls" if set(("tls.crt", "tls.key")).issubset(string_data) and len(set(string_data) - set(("tls.crt", "tls.key", "ca.crt"))) == 0 else "Opaque"
        secret_docs.append({
            "apiVersion": "v1",
            "kind": "Secret",
            "metadata": {"name": name, "namespace": namespace},
            "type": secret_type,
            "stringData": string_data,
        })
        staged_secrets.append({"namespace": namespace, "name": name, "keys": sorted(keys), "lane": lane})
    for store in required_object_stores:
        namespace = store.get("namespace") or fallback_namespace
        name = store.get("name")
        service_name = store.get("serviceName") or name
        bucket = store.get("bucket")
        credentials_secret = (store.get("credentialsSecret") or {}).get("name")
        if not name or not service_name or not bucket or not credentials_secret:
            raise RuntimeError(f"invalid required object store target fact: {store}")
        namespaces.add(namespace)
        object_store_docs.extend(minio_object_store_docs(store, fallback_namespace))
        staged_object_stores.append({
            "namespace": namespace,
            "name": name,
            "serviceName": service_name,
            "bucket": bucket,
            "lane": lane,
        })
    if crd_docs:
        crd_path = run_root / f"target-facts-{label}-crds.yaml"
        write_yaml(crd_path, {"apiVersion": "v1", "kind": "List", "items": crd_docs})
        kubectl_must(["apply", "--server-side", "--force-conflicts", "-f", str(crd_path)], kubeconfig, context, f"target fact CRD apply {label}", timeout=300)
        for crd in staged_crds:
            kubectl(["wait", "--for=condition=Established", f"crd/{crd['name']}", "--timeout=180s"], kubeconfig, context, timeout=210)
    if operator_bootstraps:
        staged_crds.extend(
            stage_operator_bootstraps(
                operator_bootstraps,
                kubeconfig,
                context,
                label,
            )
        )
    for namespace in sorted(namespaces):
        if protected_namespace(namespace):
            continue
        namespace_yaml = yaml.safe_load(kubectl_must(
            ["create", "namespace", namespace, "--dry-run=client", "-o", "yaml"],
            kubeconfig,
            context,
            f"target fact namespace {namespace}",
        ))
        namespace_path = run_root / f"target-facts-{label}-{namespace}-namespace.yaml"
        write_yaml(namespace_path, namespace_yaml)
        kubectl_must(["apply", "-f", str(namespace_path)], kubeconfig, context, f"target fact namespace apply {namespace}")
        if any(item.get("name") == namespace for item in required_namespaces):
            staged_namespaces.append({"name": namespace, "lane": lane})
    target_facts_path = run_root / f"target-facts-{label}.yaml"
    if secret_docs:
        private_path = None
        try:
            with tempfile.NamedTemporaryFile(mode="w", suffix=".yaml", delete=False) as private_file:
                yaml.safe_dump(
                    {"apiVersion": "v1", "kind": "List", "items": secret_docs},
                    private_file,
                    sort_keys=False,
                    default_flow_style=False,
                )
                private_path = Path(private_file.name)
            kubectl_must(["apply", "-f", str(private_path)], kubeconfig, context, f"target facts apply {label}")
        finally:
            if private_path:
                private_path.unlink(missing_ok=True)
        write_yaml(target_facts_path, {
            "apiVersion": "helm-expt.confighub.com/v1alpha1",
            "kind": "TargetFactSecretMaterialReceipt",
            "metadata": {"name": f"target-facts-{label}"},
            "spec": {
                "material": "generated for this live run, applied from a temporary file, and not retained",
                "secrets": [
                    {
                        "namespace": (doc.get("metadata") or {}).get("namespace"),
                        "name": (doc.get("metadata") or {}).get("name"),
                        "type": doc.get("type"),
                        "keys": [
                            {
                                "name": key,
                                "sha256": sha256_text(value),
                            }
                            for key, value in sorted((doc.get("stringData") or {}).items())
                        ],
                    }
                    for doc in secret_docs
                ],
            },
        })
    if object_store_docs:
        object_store_path = run_root / f"target-facts-{label}-object-stores.yaml"
        write_yaml(object_store_path, {"apiVersion": "v1", "kind": "List", "items": object_store_docs})
        kubectl_must(["apply", "-f", str(object_store_path)], kubeconfig, context, f"target fact object store apply {label}", timeout=300)
        for store in staged_object_stores:
            kubectl_must(
                ["-n", store["namespace"], "rollout", "status", f"deployment/{store['name']}", "--timeout=180s"],
                kubeconfig,
                context,
                f"target fact object store rollout {label}",
                timeout=210,
            )
            kubectl_must(
                ["-n", store["namespace"], "wait", "--for=condition=complete", f"job/{store['name']}-create-bucket", "--timeout=180s"],
                kubeconfig,
                context,
                f"target fact object store bucket {label}",
                timeout=210,
            )
    return {
        "result": "pass",
        "stagedSecrets": staged_secrets,
        "stagedCRDs": staged_crds,
        "stagedObjectStores": staged_object_stores,
        "stagedNamespaces": staged_namespaces,
        "path": str(target_facts_path),
    }


def self_generated_secret_names(manifest: str) -> set[str]:
    names = set()
    for doc in yaml_docs(manifest):
        kind = doc.get("kind")
        spec = doc.get("spec") or {}
        if kind in {"Deployment", "StatefulSet", "DaemonSet", "Job"}:
            pod_spec = (((spec.get("template") or {}).get("spec")) or {})
        elif kind == "CronJob":
            pod_spec = (((((spec.get("jobTemplate") or {}).get("spec")) or {}).get("template") or {}).get("spec")) or {}
        elif kind == "Pod":
            pod_spec = spec
        else:
            continue
        optional_secrets = {
            secret.get("secretName")
            for volume in pod_spec.get("volumes") or []
            if (secret := volume.get("secret"))
            and secret.get("optional") is True
            and secret.get("secretName")
        }
        if not optional_secrets:
            continue
        args = [
            str(arg)
            for container in pod_spec.get("containers") or []
            for arg in container.get("args") or []
        ]
        rotation_enabled = any(
            arg in {"--enable-cert-rotation", "--enable-cert-rotation=true"}
            for arg in args
        )
        if not rotation_enabled:
            continue
        for name in optional_secrets:
            if f"--cert-secret-name={name}" in args:
                names.add(name)
    return names


def readiness_classifier_self_test() -> int:
    manifest = """\
apiVersion: apps/v1
kind: Deployment
metadata:
  name: certificate-producer
spec:
  template:
    spec:
      containers:
      - name: producer
        args:
        - --enable-cert-rotation=true
        - --cert-secret-name=generated-certs
      volumes:
      - name: certs
        secret:
          secretName: generated-certs
          optional: true
"""
    if self_generated_secret_names(manifest) != {"generated-certs"}:
        raise RuntimeError("self-generated certificate Secret was not detected")
    if self_generated_secret_names(
        manifest.replace("--enable-cert-rotation=true", "--other-setting=true")
    ):
        raise RuntimeError("missing certificate rotation must not receive extra wait time")
    if self_generated_secret_names(manifest.replace("optional: true", "optional: false")):
        raise RuntimeError("a required Secret mount must remain a blocker")
    portable = portable_receipt_value(
        {
            "command": f"tool --file {Path.cwd() / 'runs/example.yaml'}",
            "external": f"{Path.home() / 'other/example.yaml'}",
        },
        Path.cwd(),
    )
    if portable["command"] != "tool --file runs/example.yaml":
        raise RuntimeError("repository paths must be relative in receipts")
    if portable["external"] != "$HOME/other/example.yaml":
        raise RuntimeError("home-directory paths must be portable in receipts")
    print("verified self-generated certificate Secret readiness classifier")
    print("verified portable receipt paths")
    return 0


def ready_status(
    kubeconfig: Path,
    context: str,
    namespace: str,
    self_generated_secrets: set[str] | None = None,
) -> dict:
    self_generated_secrets = self_generated_secrets or set()
    rc, workloads, workload_err = kubectl(
        ["-n", namespace, "get", "deploy,statefulset,daemonset", "--no-headers"],
        kubeconfig,
        context,
        timeout=60,
    )
    rc_pods, pods, pod_err = kubectl(["-n", namespace, "get", "pods", "--no-headers"], kubeconfig, context, timeout=60)
    not_ready = []
    for line in pods.splitlines():
        fields = line.split()
        if len(fields) < 3:
            continue
        name, ready, status = fields[:3]
        ok = status in ("Running", "Completed")
        if status == "Completed":
            ok = True
        elif "/" in ready:
            have, want = ready.split("/", 1)
            ok = ok and have == want
        if not ok:
            item = {"pod": name, "ready": ready, "status": status}
            if pod_status_is_terminal_blocker(status):
                item["blockedReason"] = "pod-runtime-failure"
            not_ready.append(item)
    diagnostics = []
    blockers = []
    for item in not_ready:
        rc_describe, describe, describe_err = kubectl(
            ["-n", namespace, "describe", "pod", item["pod"]],
            kubeconfig,
            context,
            timeout=60,
        )
        detail = describe if rc_describe == 0 else describe_err
        rc_logs, logs, logs_err = kubectl(
            ["-n", namespace, "logs", item["pod"], "--all-containers", "--tail=80"],
            kubeconfig,
            context,
            timeout=60,
        )
        log_detail = logs if rc_logs == 0 else logs_err
        diagnostic = {
            "pod": item["pod"],
            "result": "pass" if rc_describe == 0 else "blocked",
            "detailHead": detail[:3000],
            "detailTail": detail[-3000:],
            "logsHead": log_detail[:3000],
            "logsTail": log_detail[-3000:],
        }
        missing_secret = missing_required_secret(detail)
        if missing_secret and missing_secret in self_generated_secrets:
            item["waitingReason"] = "self-generated-secret"
            item["waitingForSecret"] = missing_secret
            diagnostic["result"] = "watch"
            diagnostic["waitingReason"] = "self-generated-secret"
            diagnostic["waitingForSecret"] = missing_secret
        elif missing_secret:
            item["blockedReason"] = "missing-required-secret"
            item["missingSecret"] = missing_secret
            diagnostic["result"] = "blocked"
            diagnostic["blockedReason"] = "missing-required-secret"
            diagnostic["missingSecret"] = missing_secret
            blockers.append({
                "pod": item["pod"],
                "reason": "missing-required-secret",
                "secret": missing_secret,
            })
        elif item.get("blockedReason") == "pod-runtime-failure":
            diagnostic["result"] = "blocked"
            diagnostic["blockedReason"] = "pod-runtime-failure"
            blockers.append({
                "pod": item["pod"],
                "reason": "pod-runtime-failure",
                "status": item.get("status", ""),
            })
        diagnostics.append(diagnostic)
    if rc == 0 and not workloads.strip():
        # No long-running workloads in this namespace. A CronJob-only chart
        # (issue #517) must classify instead of wedging the readiness loop:
        # pass when a Job completed, blocked when a Job failed, otherwise
        # pending-cronjob so the caller can keep polling until its cutoff.
        rc_cron, crons, cron_err = kubectl(["-n", namespace, "get", "cronjobs", "--no-headers"], kubeconfig, context, timeout=60)
        if rc_cron == 0 and crons.strip():
            rc_jobs, jobs, _jobs_err = kubectl(["-n", namespace, "get", "jobs", "--no-headers"], kubeconfig, context, timeout=60)
            job_lines = [line.split() for line in jobs.splitlines() if line.split()] if rc_jobs == 0 else []
            completed = [fields[0] for fields in job_lines if len(fields) > 1 and fields[1].startswith("Complete")]
            completed += [fields[0] for fields in job_lines if len(fields) > 2 and fields[2].startswith("Complete")]
            # kubectl >=1.31 prints STATUS in column 2; older prints COMPLETIONS "n/m".
            completed += [fields[0] for fields in job_lines if len(fields) > 1 and "/" in fields[1] and fields[1].split("/")[0] == fields[1].split("/")[1] and fields[1].split("/")[0] != "0"]
            failed = [fields[0] for fields in job_lines if len(fields) > 1 and fields[1].startswith("Failed")]
            failed += [fields[0] for fields in job_lines if len(fields) > 2 and fields[2].startswith("Failed")]
            failed += [item["pod"] for item in not_ready if item.get("status", "").startswith(("Error", "CrashLoop"))]
            if failed:
                cron_result = "blocked"
            elif completed:
                cron_result = "pass"
            else:
                cron_result = "pending-cronjob"
            return {
                "result": cron_result,
                "kind": "cronjob-only",
                "workloads": f"cronjobs:\n{crons}\njobs:\n{jobs if rc_jobs == 0 else ''}".rstrip(),
                "pods": pods if rc_pods == 0 else pod_err,
                "notReady": not_ready,
                "diagnostics": diagnostics,
                "cronJobEvidence": {"completedJobs": sorted(set(completed)), "failedJobs": sorted(set(failed))},
            }
    return {
        "result": (
            "blocked"
            if blockers
            else "pass"
            if rc == 0 and bool(workloads.strip()) and rc_pods == 0 and not not_ready
            else "watch"
        ),
        **({"blockedReasons": blockers} if blockers else {}),
        "workloads": workloads if rc == 0 else workload_err,
        "pods": pods if rc_pods == 0 else pod_err,
        "notReady": not_ready,
        "diagnostics": diagnostics,
    }


def missing_required_secret(detail: str) -> str:
    lower = detail.lower()
    if "secret" not in lower or "not found" not in lower:
        return ""
    match = re.search(r'secret "([^"]+)" not found', detail, flags=re.IGNORECASE)
    if match:
        return match.group(1)
    match = re.search(r"SecretName:\s*([^\s]+)", detail)
    if match and "MountVolume.SetUp failed" in detail:
        return match.group(1)
    return ""


def pod_status_is_terminal_blocker(status: str) -> bool:
    normalized_status = status.split(":", 1)[1] if status.startswith("Init:") else status
    return normalized_status in {
        "CrashLoopBackOff",
        "CreateContainerConfigError",
        "ErrImagePull",
        "Error",
        "ImagePullBackOff",
        "InvalidImageName",
    }


def wait_ready_many(
    kubeconfig: Path,
    context: str,
    namespaces: list[str],
    timeout_seconds: int = 300,
    manifest: str = "",
) -> dict:
    generated_secrets = self_generated_secret_names(manifest)
    if not namespaces:
        return {
            "result": "pass",
            "namespaces": [],
            "selfGeneratedSecrets": sorted(generated_secrets),
            "workloads": "",
            "pods": "",
            "notReady": [],
            "diagnostics": [],
        }
    start = time.monotonic()
    deadline = start + timeout_seconds
    last = {}
    while time.monotonic() < deadline:
        results = {
            namespace: ready_status(
                kubeconfig,
                context,
                namespace,
                generated_secrets,
            )
            for namespace in namespaces
        }
        last = results
        if results and all(item.get("result") == "pass" for item in results.values()):
            break
        if results and any(item.get("result") == "blocked" for item in results.values()):
            break
        if results and all(item.get("kind") == "cronjob-only" for item in results.values()):
            # CronJob-only charts do not need the full workload budget: give
            # schedules a fair window (descheduler default fires every few
            # minutes), then classify as watch instead of wedging (issue #517).
            deadline = min(deadline, start + 360)
        time.sleep(10)
    not_ready = []
    diagnostics = []
    workloads = []
    pods = []
    for namespace, result in last.items():
        workloads.append(f"# {namespace}\n{result.get('workloads', '')}".rstrip())
        pods.append(f"# {namespace}\n{result.get('pods', '')}".rstrip())
        for item in result.get("notReady", []):
            not_ready.append({"namespace": namespace, **item})
        for item in result.get("diagnostics", []):
            diagnostics.append({"namespace": namespace, **item})
    if last and all(item.get("result") == "pass" for item in last.values()):
        overall = "pass"
    elif last and any(item.get("result") == "blocked" for item in last.values()):
        overall = "blocked"
    else:
        overall = "watch"
    cron_evidence = {ns: item.get("cronJobEvidence") for ns, item in last.items() if item.get("cronJobEvidence")}
    return {
        "result": overall,
        **({"cronJobEvidence": cron_evidence} if cron_evidence else {}),
        "namespaces": namespaces,
        "selfGeneratedSecrets": sorted(generated_secrets),
        "workloads": "\n".join(workloads),
        "pods": "\n".join(pods),
        "notReady": not_ready,
        "diagnostics": diagnostics,
    }


def api_service_refs(manifest: str) -> list[dict]:
    refs = []
    for doc in yaml_docs(manifest):
        if doc.get("kind") != "APIService":
            continue
        metadata = doc.get("metadata") or {}
        spec = doc.get("spec") or {}
        name = metadata.get("name")
        group = spec.get("group")
        version = spec.get("version")
        if name and group and version:
            refs.append({"name": name, "group": group, "version": version, "queryPath": f"/apis/{group}/{version}"})
    return refs


def api_service_observation(kubeconfig: Path, context: str, ref: dict) -> dict:
    rc, out, err = kubectl(["get", "apiservice", ref["name"], "-o", "json"], kubeconfig, context, timeout=60)
    condition = {}
    if rc == 0:
        try:
            payload = json.loads(out)
        except json.JSONDecodeError:
            payload = {}
        for item in ((payload.get("status") or {}).get("conditions") or []):
            if item.get("type") == "Available":
                condition = item
                break
    query_rc, query_out, query_err = kubectl(["get", "--raw", ref["queryPath"]], kubeconfig, context, timeout=60)
    available = condition.get("status") == "True"
    query_pass = query_rc == 0 and bool(query_out.strip())
    return {
        "name": ref["name"],
        "group": ref["group"],
        "version": ref["version"],
        "queryPath": ref["queryPath"],
        "result": "pass" if available and query_pass else "watch",
        "available": available,
        "conditionStatus": condition.get("status") or "",
        "conditionReason": condition.get("reason") or "",
        "conditionMessage": (condition.get("message") or "")[:1000],
        "queryResult": "pass" if query_pass else "watch",
        "querySHA256": sha256_text(query_out) if query_rc == 0 else "",
        "queryError": "" if query_rc == 0 else (query_err or query_out)[:1000],
    }


def wait_api_services(kubeconfig: Path, context: str, refs: list[dict], timeout_seconds: int = 300) -> dict:
    if not refs:
        return {"result": "pass", "items": []}
    deadline = time.monotonic() + timeout_seconds
    observations = []
    while time.monotonic() < deadline:
        observations = [api_service_observation(kubeconfig, context, ref) for ref in refs]
        if observations and all(item.get("result") == "pass" for item in observations):
            break
        time.sleep(10)
    return {
        "result": "pass" if observations and all(item.get("result") == "pass" for item in observations) else "watch",
        "items": observations,
    }


def wait_for_pod_running(kubeconfig: Path, context: str, namespace: str, pod: str, timeout_seconds: int = 300) -> dict:
    deadline = time.monotonic() + timeout_seconds
    last = {"phase": "", "detail": ""}
    while time.monotonic() < deadline:
        rc, out, err = kubectl(
            ["-n", namespace, "get", "pod", pod, "-o", "json"],
            kubeconfig,
            context,
            timeout=60,
        )
        if rc == 0:
            try:
                payload = json.loads(out)
            except json.JSONDecodeError:
                payload = {}
            phase = (((payload.get("status") or {}).get("phase")) or "")
            last = {"phase": phase, "detail": phase}
            if phase == "Running":
                return {"result": "pass", "phase": phase}
        else:
            last = {"phase": "", "detail": err or out}
        time.sleep(5)
    return {"result": "blocked", **last}


def redacted_vault_status(raw: str) -> dict:
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        return {"rawSHA256": sha256_text(raw), "parse": "failed"}
    allowed = {}
    for key in ("initialized", "sealed", "standby", "version", "storage_type", "cluster_name", "cluster_id"):
        if key in payload:
            allowed[key] = payload[key]
    allowed["rawSHA256"] = sha256_text(raw)
    return allowed


def run_vault_default_operating_policy(kubeconfig: Path, context: str, namespace: str) -> dict:
    pod = "vault-0"
    pod_ready = wait_for_pod_running(kubeconfig, context, namespace, pod, timeout_seconds=300)
    if pod_ready.get("result") != "pass":
        return {"result": "blocked", "operation": "vault-init-unseal", "pod": pod, "podReady": pod_ready}

    base_exec = ["-n", namespace, "exec", pod, "--", "sh", "-ec"]
    status_cmd = "VAULT_ADDR=http://127.0.0.1:8200 vault status -format=json || true"
    _status_rc, status_before, _status_err = kubectl([*base_exec, status_cmd], kubeconfig, context, timeout=120)

    init_cmd = "VAULT_ADDR=http://127.0.0.1:8200 vault operator init -key-shares=1 -key-threshold=1 -format=json"
    init_rc, init_out, init_err = kubectl([*base_exec, init_cmd], kubeconfig, context, timeout=120)
    if init_rc != 0:
        return {
            "result": "blocked",
            "operation": "vault-init-unseal",
            "pod": pod,
            "statusBefore": redacted_vault_status(status_before),
            "initResult": "blocked",
            "detail": (init_err or init_out)[:1000],
        }

    try:
        init_payload = json.loads(init_out)
    except json.JSONDecodeError:
        return {
            "result": "blocked",
            "operation": "vault-init-unseal",
            "pod": pod,
            "statusBefore": redacted_vault_status(status_before),
            "initResult": "blocked",
            "detail": "vault operator init did not return JSON",
        }
    unseal_keys = init_payload.get("unseal_keys_b64") or []
    if not unseal_keys:
        return {
            "result": "blocked",
            "operation": "vault-init-unseal",
            "pod": pod,
            "statusBefore": redacted_vault_status(status_before),
            "initResult": "blocked",
            "detail": "vault operator init returned no unseal key",
        }

    unseal_cmd = f"VAULT_ADDR=http://127.0.0.1:8200 vault operator unseal {unseal_keys[0]}"
    unseal_rc, unseal_out, unseal_err = kubectl([*base_exec, unseal_cmd], kubeconfig, context, timeout=120)
    if unseal_rc != 0:
        return {
            "result": "blocked",
            "operation": "vault-init-unseal",
            "pod": pod,
            "statusBefore": redacted_vault_status(status_before),
            "initResult": "pass",
            "unsealResult": "blocked",
            "detail": (unseal_err or unseal_out)[:1000],
        }

    status_rc, status_after, status_err = kubectl([*base_exec, status_cmd], kubeconfig, context, timeout=120)
    status = redacted_vault_status(status_after)
    passed = status_rc == 0 and status.get("initialized") is True and status.get("sealed") is False
    return {
        "result": "pass" if passed else "blocked",
        "operation": "vault-init-unseal",
        "pod": pod,
        "statusBefore": redacted_vault_status(status_before),
        "initResult": "pass",
        "unsealResult": "pass",
        "statusAfter": status,
        "custody": "unseal key and root token were held in process memory only and not written to the receipt",
        "detail": "" if passed else (status_err or status_after)[:1000],
    }


def run_vault_ha_raft_operating_policy(kubeconfig: Path, context: str, namespace: str) -> dict:
    pods = ["vault-0", "vault-1", "vault-2"]
    pod_states = {pod: wait_for_pod_running(kubeconfig, context, namespace, pod, timeout_seconds=300) for pod in pods}
    not_running = {pod: state for pod, state in pod_states.items() if state.get("result") != "pass"}
    if not_running:
        return {"result": "blocked", "operation": "vault-ha-raft-init-unseal", "pods": pod_states}

    def vault_exec(pod: str, command: str, timeout: int = 120) -> tuple[int, str, str]:
        return kubectl(["-n", namespace, "exec", pod, "--", "sh", "-ec", command], kubeconfig, context, timeout=timeout)

    status_cmd = "VAULT_ADDR=http://127.0.0.1:8200 vault status -format=json || true"
    _status_rc, status_before, _status_err = vault_exec("vault-0", status_cmd)
    init_cmd = "VAULT_ADDR=http://127.0.0.1:8200 vault operator init -key-shares=1 -key-threshold=1 -format=json"
    init_rc, init_out, init_err = vault_exec("vault-0", init_cmd)
    if init_rc != 0:
        return {
            "result": "blocked",
            "operation": "vault-ha-raft-init-unseal",
            "statusBefore": redacted_vault_status(status_before),
            "initResult": "blocked",
            "detail": (init_err or init_out)[:1000],
        }
    try:
        init_payload = json.loads(init_out)
    except json.JSONDecodeError:
        return {
            "result": "blocked",
            "operation": "vault-ha-raft-init-unseal",
            "statusBefore": redacted_vault_status(status_before),
            "initResult": "blocked",
            "detail": "vault operator init did not return JSON",
        }
    unseal_keys = init_payload.get("unseal_keys_b64") or []
    root_token = init_payload.get("root_token")
    if not unseal_keys or not root_token:
        return {
            "result": "blocked",
            "operation": "vault-ha-raft-init-unseal",
            "statusBefore": redacted_vault_status(status_before),
            "initResult": "blocked",
            "detail": "vault operator init returned incomplete local proof material",
        }

    unseal_results = {}
    join_results = {}
    unseal_cmd = f"VAULT_ADDR=http://127.0.0.1:8200 vault operator unseal {unseal_keys[0]}"
    unseal_rc, unseal_out, unseal_err = vault_exec("vault-0", unseal_cmd)
    unseal_results["vault-0"] = {
        "result": "pass" if unseal_rc == 0 else "blocked",
        "detailSHA256": sha256_text(unseal_out if unseal_rc == 0 else (unseal_err or unseal_out)),
    }
    for pod in pods[1:]:
        join_cmd = f"VAULT_ADDR=http://127.0.0.1:8200 VAULT_TOKEN={root_token} vault operator raft join http://vault-0.vault-internal:8200"
        join_rc, join_out, join_err = vault_exec(pod, join_cmd)
        join_results[pod] = {
            "result": "pass" if join_rc == 0 else "blocked",
            "detailSHA256": sha256_text(join_out if join_rc == 0 else (join_err or join_out)),
        }
        unseal_cmd = f"VAULT_ADDR=http://127.0.0.1:8200 vault operator unseal {unseal_keys[0]}"
        unseal_rc, unseal_out, unseal_err = vault_exec(pod, unseal_cmd)
        unseal_results[pod] = {
            "result": "pass" if unseal_rc == 0 else "blocked",
            "detailSHA256": sha256_text(unseal_out if unseal_rc == 0 else (unseal_err or unseal_out)),
        }
    if any(item["result"] != "pass" for item in join_results.values()) or any(item["result"] != "pass" for item in unseal_results.values()):
        return {
            "result": "blocked",
            "operation": "vault-ha-raft-init-unseal",
            "statusBefore": redacted_vault_status(status_before),
            "initResult": "pass",
            "joinResults": join_results,
            "unsealResults": unseal_results,
            "custody": "unseal key and root token were held in process memory only and not written to the receipt",
        }

    deadline = time.monotonic() + 300
    statuses = {}
    raft_peer_count = 0
    while time.monotonic() < deadline:
        statuses = {}
        for pod in pods:
            status_rc, status_out, _status_err = vault_exec(pod, status_cmd)
            statuses[pod] = redacted_vault_status(status_out)
            statuses[pod]["commandResult"] = "pass" if status_rc == 0 else "blocked"
        peer_cmd = f"VAULT_ADDR=http://127.0.0.1:8200 VAULT_TOKEN={root_token} vault operator raft list-peers -format=json || true"
        _peer_rc, peer_out, _peer_err = vault_exec("vault-0", peer_cmd)
        try:
            peer_payload = json.loads(peer_out)
            raft_peer_count = len(peer_payload.get("data", {}).get("config", {}).get("servers", []) or [])
        except json.JSONDecodeError:
            raft_peer_count = 0
        if (
            all(item.get("initialized") is True and item.get("sealed") is False for item in statuses.values())
            and raft_peer_count >= 3
        ):
            break
        time.sleep(10)

    passed = (
        all(item.get("initialized") is True and item.get("sealed") is False for item in statuses.values())
        and raft_peer_count >= 3
    )
    return {
        "result": "pass" if passed else "blocked",
        "operation": "vault-ha-raft-init-unseal",
        "pods": pods,
        "statusBefore": redacted_vault_status(status_before),
        "initResult": "pass",
        "joinResults": join_results,
        "unsealResults": unseal_results,
        "statusAfter": statuses,
        "raftPeerCount": raft_peer_count,
        "custody": "unseal key and root token were held in process memory only and not written to the receipt",
        "detail": "" if passed else "Vault HA pods did not all report initialized=false/sealed=false with three Raft peers before timeout",
    }


def post_render_operations(chart: str, base: str, kubeconfig: Path, context: str, namespace: str) -> dict:
    if chart == "hashicorp/vault" and base == "default":
        return run_vault_default_operating_policy(kubeconfig, context, namespace)
    if chart == "hashicorp/vault" and base == "ha-raft-ui":
        return run_vault_ha_raft_operating_policy(kubeconfig, context, namespace)
    return {"result": "pass", "operation": "none"}


def parse_duration_seconds(value: str) -> int:
    value = value.strip().lower()
    if not value:
        raise ValueError("duration cannot be empty")
    units = {
        "ms": 0.001,
        "s": 1,
        "m": 60,
        "h": 3600,
    }
    for suffix, multiplier in units.items():
        if value.endswith(suffix):
            number = float(value[:-len(suffix)])
            return max(1, int(number * multiplier))
    return max(1, int(float(value)))


def semantic_compare(
    helm_yaml: str,
    installer_yaml: str,
    allowed_extra: list[str],
    semantic_normalizations: list[str] | None = None,
    allowed_missing: list[str] | None = None,
) -> dict:
    semantic_normalizations = semantic_normalizations or []
    allowed_missing = sorted(allowed_missing or [])
    helm = object_map(helm_yaml, semantic_normalizations)
    installer = object_map(installer_yaml, semantic_normalizations)
    helm_keys = set(helm)
    installer_keys = set(installer)
    missing = sorted(helm_keys - installer_keys)
    extra = sorted(installer_keys - helm_keys)
    common = sorted(helm_keys & installer_keys)
    diffs = []
    for key in common:
        if helm[key] == installer[key]:
            continue
        diffs.append(key)
    return {
        "result": "pass" if missing == allowed_missing and extra == allowed_extra and not diffs else "blocked",
        "helmObjectCount": len(helm_keys),
        "installerObjectCount": len(installer_keys),
        "missingFromInstaller": missing,
        "allowedMissingFromInstaller": allowed_missing,
        "extraInInstaller": extra,
        "semanticDiffs": diffs[:50],
        "semanticNormalizations": semantic_normalizations,
        "comparisonSHA256": sha256_text(json.dumps({
            "missing": missing,
            "allowedMissing": allowed_missing,
            "extra": extra,
            "diffs": diffs,
            "semanticNormalizations": semantic_normalizations,
        }, sort_keys=True)),
    }


def rendered_crd_names(text: str) -> list[str]:
    return sorted({
        str((doc.get("metadata") or {}).get("name"))
        for doc in yaml_docs(text)
        if doc.get("kind") == "CustomResourceDefinition"
        and (doc.get("metadata") or {}).get("name")
    })


def crd_object_key(name: str) -> str:
    return f"apiextensions.k8s.io/v1|CustomResourceDefinition||{name}"


def observe_crds(names: list[str], kubeconfig: Path, context: str) -> dict:
    items = []
    for name in names:
        rc, out, err = kubectl(["get", "crd", name, "-o", "name"], kubeconfig, context)
        items.append({
            "name": name,
            "result": "pass" if rc == 0 else "blocked",
            "detail": (out or err).strip()[:1000],
        })
    return {
        "result": "pass" if all(item["result"] == "pass" for item in items) else "blocked",
        "items": items,
    }


def target_topology(variant: dict) -> dict:
    facts = (variant.get("spec") or {}).get("targetFacts") or {}
    topology = facts.get("requiredTopology") or {}
    minimum_nodes = int(topology.get("minimumSchedulableNodes") or 1)
    return {
        "minimumSchedulableNodes": max(1, minimum_nodes),
        "purpose": topology.get("purpose") or "",
    }


def create_kind_cluster(name: str, kubeconfig: Path, node_count: int = 1) -> tuple[int, str, str]:
    kubeconfig.parent.mkdir(parents=True, exist_ok=True)
    cmd = ["kind", "create", "cluster", "--name", name, "--kubeconfig", str(kubeconfig), "--wait", "300s"]
    if node_count > 1:
        config_path = kubeconfig.with_name(f"{name}-kind-config.yaml")
        write_yaml(config_path, {
            "kind": "Cluster",
            "apiVersion": "kind.x-k8s.io/v1alpha4",
            "nodes": [{"role": "control-plane"}, *({"role": "worker"} for _ in range(node_count))],
        })
        cmd.extend(["--config", str(config_path)])
    return sh(cmd, timeout=900)


def delete_kind_cluster(name: str, kubeconfig: Path) -> tuple[int, str, str]:
    return sh(["kind", "delete", "cluster", "--name", name, "--kubeconfig", str(kubeconfig)], timeout=300)


def apply_installer_manifest(manifest: str, manifests_dir: Path, secrets_dir: Path, kubeconfig: Path, context: str, fallback_namespace: str, run_root: Path) -> dict:
    manifest_names = manifest_namespaces(manifest) or [fallback_namespace]
    runtime_names = workload_namespaces(manifest, fallback_namespace)
    namespace_docs = []
    for namespace in manifest_names:
        if protected_namespace(namespace):
            continue
        namespace_docs.append(yaml.safe_load(kubectl_must(
            ["create", "namespace", namespace, "--dry-run=client", "-o", "yaml"],
            kubeconfig,
            context,
            f"namespace yaml {namespace}",
        )))
    if namespace_docs:
        ns_yaml = run_root / "installer-namespaces.yaml"
        write_text(ns_yaml, render_docs_to_yaml(namespace_docs))
        kubectl_must(["apply", "-f", str(ns_yaml)], kubeconfig, context, "namespace apply")

    if manifests_dir.exists():
        for path in sorted(manifests_dir.glob("serviceaccount-*.yaml")):
            kubectl_must(["apply", "-f", str(path)], kubeconfig, context, f"service account apply {path.name}", timeout=120)

    if secrets_dir.exists():
        for secret_path in sorted(secrets_dir.glob("*.yaml")):
            kubectl_must(["apply", "-f", str(secret_path)], kubeconfig, context, f"secret apply {secret_path.name}", timeout=120)

    if manifests_dir.exists():
        crds = docs_matching(manifest, "CustomResourceDefinition")
        if crds:
            crd_path = run_root / "installer-crds.yaml"
            write_text(crd_path, render_docs_to_yaml(crds))
            kubectl_must(["apply", "--server-side", "--force-conflicts", "-f", str(crd_path)], kubeconfig, context, "crd apply", timeout=300)
            for crd in crds:
                name = crd.get("metadata", {}).get("name")
                if name:
                    kubectl(["wait", "--for=condition=Established", f"crd/{name}", "--timeout=180s"], kubeconfig, context, timeout=210)
        for path in sorted(manifests_dir.glob("*.yaml")):
            if "namespace-" in path.name:
                kubectl(["apply", "-f", str(path)], kubeconfig, context, timeout=120)
        rest = [path for path in sorted(manifests_dir.glob("*.yaml")) if "namespace-" not in path.name]
        if rest:
            kubectl_must(["apply", "--server-side", "--force-conflicts", "-f", str(manifests_dir)], kubeconfig, context, "manifest apply", timeout=300)
    return {"manifestNamespaces": manifest_names, "runtimeNamespaces": runtime_names}


def main() -> int:
    if sys.argv[1:] == ["--self-test"]:
        return readiness_classifier_self_test()
    parser = argparse.ArgumentParser()
    parser.add_argument("--chart", required=True)
    parser.add_argument("--version", required=True)
    parser.add_argument("--repo-url", required=True)
    parser.add_argument("--release", required=True)
    parser.add_argument("--namespace", required=True)
    parser.add_argument("--package", required=True)
    parser.add_argument("--recipe", required=True)
    parser.add_argument("--base", required=True)
    parser.add_argument("--variant-revision", required=True)
    parser.add_argument("--values", required=True)
    parser.add_argument("--slug", required=True)
    parser.add_argument("--rig", required=True)
    parser.add_argument("--out", required=True)
    parser.add_argument("--wait", default="8m")
    parser.add_argument("--keep", action="store_true")
    args = parser.parse_args()
    wait_seconds = parse_duration_seconds(args.wait)

    repo = Path(__file__).resolve().parents[1]
    package_path = repo / args.package
    recipe_path = repo / args.recipe
    values_path = repo / args.values
    revision_path = repo / args.variant_revision
    variant_path = recipe_path / "variants" / args.base / "variant.yaml"
    canonical_rendered_path = revision_path.parent / "rendered" / "release-objects.yaml"
    out_path = repo / args.out
    run_root = out_path.parent
    workdir = Path("/tmp") / f"helm-expt-kind-parity-{args.rig}-{args.slug}"
    helm_cluster = f"{args.rig}-helm"
    installer_cluster = f"{args.rig}-installer"
    helm_context = f"kind-{helm_cluster}"
    installer_context = f"kind-{installer_cluster}"
    helm_kubeconfig = run_root / "helm.kubeconfig"
    installer_kubeconfig = run_root / "installer.kubeconfig"

    receipt = {
        "apiVersion": "helm-expt.confighub.com/v1alpha1",
        "kind": "LiveHelmInstallerKindParityReceipt",
        "metadata": {"name": f"{args.chart.replace('/', '-')}-{args.version}-{args.base}-kind-parity-20260606"},
        "spec": {
            "chart": args.chart,
            "version": args.version,
            "base": args.base,
            "result": "blocked",
            "observedAt": datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z"),
            "package": {"path": args.package},
            "recipe": {"path": args.recipe},
            "variantRevision": args.variant_revision,
            "run": {
                "mode": "two-vanilla-kind-clusters",
                "helmCluster": helm_cluster,
                "installerCluster": installer_cluster,
                "namespace": args.namespace,
                "cleanup": {"result": "not-run"},
            },
            "legs": {},
            "semanticComparison": {"allowedExtraInstallerObjects": [f"v1|Namespace||{args.namespace}"]},
            "checks": [],
        },
    }

    def check_item(name: str, result: str, detail: str) -> None:
        receipt["spec"]["checks"].append({"name": name, "result": result, "detail": detail[:1000]})

    def leg(name: str, **fields) -> None:
        receipt["spec"]["legs"][name] = fields

    def mark_stage(name: str) -> None:
        write_text(run_root / "stage.txt", f"{datetime.now(timezone.utc).replace(microsecond=0).isoformat()} {name}\n")

    cleanup_results = []
    try:
        mark_stage("validate-inputs")
        for path, label in [
            (package_path, "package"),
            (recipe_path, "recipe"),
            (variant_path, "variant"),
            (values_path, "values"),
            (revision_path, "variant revision"),
            (canonical_rendered_path, "canonical rendered objects"),
        ]:
            if not path.exists():
                raise RuntimeError(f"{label} path not found: {path}")
        canonical_helm_manifest = canonical_rendered_path.read_text()
        semantic_normalizations = semantic_normalizations_for(revision_path)
        receipt["spec"]["semanticComparison"]["semanticNormalizations"] = semantic_normalizations
        variant = load_yaml(variant_path)
        topology = target_topology(variant)
        receipt["spec"]["run"]["targetTopology"] = topology
        write_text(run_root / "canonical-helm-render.yaml", canonical_helm_manifest)
        helm_values_path = raw_values_file(values_path, run_root / "regular-helm-values.yaml")
        helm_required_values = apply_helm_required_value_overrides(helm_values_path, variant, run_root)
        installer_input_args, installer_required_values = installer_required_value_inputs(variant, run_root)

        mark_stage("create-kind-clusters")
        for name, kubeconfig, label in [
            (helm_cluster, helm_kubeconfig, "helm"),
            (installer_cluster, installer_kubeconfig, "installer"),
        ]:
            rc, out, err = create_kind_cluster(name, kubeconfig, topology["minimumSchedulableNodes"])
            if rc != 0:
                raise RuntimeError(f"kind create {label} cluster failed: {(err or out)[:1000]}")
            detail = out or f"{label} kind cluster created"
            if topology["minimumSchedulableNodes"] > 1:
                detail = f"{detail}\nminimumSchedulableNodes={topology['minimumSchedulableNodes']}"
            check_item(f"kind-create-{label}", "pass", detail)

        helm_target_facts = stage_target_facts(variant, recipe_path, helm_kubeconfig, helm_context, args.namespace, run_root, "helm", "regularHelm")
        installer_target_facts = stage_target_facts(
            variant,
            recipe_path,
            installer_kubeconfig,
            installer_context,
            args.namespace,
            run_root,
            "installer",
            "cubInstallerApply",
            package_path,
        )
        receipt["spec"]["targetFacts"] = {
            "regularHelm": helm_target_facts,
            "cubInstallerApply": installer_target_facts,
            "requiredValues": helm_required_values + installer_required_values,
        }
        check_item("target-facts-helm", helm_target_facts["result"], f"secrets={len(helm_target_facts.get('stagedSecrets', []))} crds={len(helm_target_facts.get('stagedCRDs', []))} namespaces={len(helm_target_facts.get('stagedNamespaces', []))}")
        check_item("target-facts-installer", installer_target_facts["result"], f"secrets={len(installer_target_facts.get('stagedSecrets', []))} crds={len(installer_target_facts.get('stagedCRDs', []))} namespaces={len(installer_target_facts.get('stagedNamespaces', []))}")

        if workdir.exists():
            shutil.rmtree(workdir)

        helm_cmd = [
            "helm", "upgrade", "--install", args.release,
            *helm_chart_command_args(args.chart, args.repo_url),
            "--version", args.version,
            "--namespace", args.namespace,
            "--create-namespace",
            "--values", str(helm_values_path),
            "--wait",
            "--timeout", args.wait,
        ]
        helm_env = {**os.environ, "KUBECONFIG": str(helm_kubeconfig)}
        mark_stage("regular-helm-install")
        rc, helm_out, helm_err = sh(helm_cmd, timeout=900, env=helm_env)
        helm_live_manifest = ""
        get_rc, get_out, get_err = sh(["helm", "get", "manifest", args.release, "--namespace", args.namespace], timeout=120, env=helm_env)
        if get_rc == 0:
            helm_live_manifest = get_out + "\n"
            write_text(run_root / "regular-helm-live-manifest.yaml", helm_live_manifest)
        helm_operations = post_render_operations(args.chart, args.base, helm_kubeconfig, helm_context, args.namespace)
        receipt["spec"].setdefault("operatingPolicy", {})["regularHelm"] = helm_operations
        check_item("regular-helm-operating-policy", helm_operations["result"], helm_operations.get("operation", "none"))
        helm_runtime_names = workload_namespaces(canonical_helm_manifest, args.namespace)
        helm_runtime = wait_ready_many(
            helm_kubeconfig,
            helm_context,
            helm_runtime_names,
            timeout_seconds=wait_seconds,
            manifest=canonical_helm_manifest,
        )
        helm_api_services = wait_api_services(helm_kubeconfig, helm_context, api_service_refs(canonical_helm_manifest), timeout_seconds=wait_seconds)
        helm_runtime["apiServices"] = helm_api_services
        rendered_crds = rendered_crd_names(canonical_helm_manifest)
        helm_crd_observation = observe_crds(rendered_crds, helm_kubeconfig, helm_context)
        receipt["spec"].setdefault("crdObservations", {})["regularHelm"] = helm_crd_observation
        check_item(
            "regular-helm-rendered-crds",
            helm_crd_observation["result"],
            f"observed={sum(item['result'] == 'pass' for item in helm_crd_observation['items'])}/{len(rendered_crds)}",
        )
        helm_observed_crd_keys = (
            [crd_object_key(name) for name in rendered_crds]
            if helm_crd_observation["result"] == "pass"
            else []
        )
        helm_render_live_comparison = semantic_compare(
            canonical_helm_manifest,
            helm_live_manifest,
            [],
            semantic_normalizations,
            helm_observed_crd_keys,
        ) if helm_live_manifest else {
            "result": "blocked",
            "helmObjectCount": len(object_map(canonical_helm_manifest, semantic_normalizations)),
            "installerObjectCount": 0,
            "missingFromInstaller": sorted(object_map(canonical_helm_manifest, semantic_normalizations).keys())[:50],
            "extraInInstaller": [],
            "semanticDiffs": [],
            "semanticNormalizations": semantic_normalizations,
            "comparisonSHA256": sha256_text("missing-live-helm-manifest"),
        }
        receipt["spec"]["semanticComparison"]["regularHelmRenderVsLive"] = helm_render_live_comparison
        check_item(
            "regular-helm-render-live-parity",
            helm_render_live_comparison["result"],
            f"missing={len(helm_render_live_comparison['missingFromInstaller'])} extra={helm_render_live_comparison['extraInInstaller']} diffs={len(helm_render_live_comparison['semanticDiffs'])}",
        )
        helm_clean = (
            rc == 0
            and get_rc == 0
            and helm_operations["result"] == "pass"
            and helm_api_services["result"] == "pass"
            and helm_crd_observation["result"] == "pass"
            and helm_render_live_comparison["result"] == "pass"
        )
        helm_result = "pass" if helm_clean and helm_runtime["result"] == "pass" else ("watch" if helm_clean and helm_runtime["result"] == "watch" else "blocked")
        leg("regularHelm",
            result=helm_result,
            command=" ".join(helm_cmd),
            namespace=args.namespace,
            manifestSHA256=sha256_text(canonical_helm_manifest),
            objectCount=len(object_map(canonical_helm_manifest)),
            liveHelmManifestSHA256=sha256_text(helm_live_manifest) if helm_live_manifest else "",
            liveHelmManifestObjectCount=len(object_map(helm_live_manifest)) if helm_live_manifest else 0,
            runtimeNamespaces=helm_runtime_names,
            runtime=helm_runtime,
            stderr=helm_err[:1000] if rc != 0 else "",
            getManifestError=get_err[:1000] if get_rc != 0 else "",
        )
        check_item("regular-helm-live", helm_result, helm_err or helm_out or helm_runtime.get("workloads", ""))
        if helm_api_services.get("items"):
            check_item(
                "regular-helm-apiservice-aggregation",
                helm_api_services["result"],
                "; ".join(f"{item['name']} available={item['available']} query={item['queryResult']}" for item in helm_api_services["items"]),
            )

        mark_stage("installer-render")
        setup_cmd = [
            "cub", "installer", "setup", "--pull", str(package_path), "--base", args.base,
            "--work-dir", str(workdir), "--non-interactive", "--namespace", args.namespace,
            *installer_input_args,
        ]
        rc, setup_out, setup_err = sh(setup_cmd, timeout=360)
        if rc != 0:
            raise RuntimeError(f"installer setup failed: {(setup_err or setup_out)[:1000]}")
        manifests_dir = workdir / "out" / "manifests"
        secrets_dir = workdir / "out" / "secrets"
        installer_manifest = combine_yaml_parts(collect_yaml(manifests_dir), collect_yaml(secrets_dir))
        write_text(run_root / "installer-rendered-manifest.yaml", installer_manifest)

        mark_stage("installer-apply")
        apply_info = apply_installer_manifest(
            installer_manifest,
            manifests_dir,
            secrets_dir,
            installer_kubeconfig,
            installer_context,
            args.namespace,
            run_root,
        )
        mark_stage("installer-readiness")
        installer_operations = post_render_operations(args.chart, args.base, installer_kubeconfig, installer_context, args.namespace)
        receipt["spec"].setdefault("operatingPolicy", {})["cubInstallerApply"] = installer_operations
        check_item("cub-installer-operating-policy", installer_operations["result"], installer_operations.get("operation", "none"))
        installer_runtime = wait_ready_many(
            installer_kubeconfig,
            installer_context,
            apply_info["runtimeNamespaces"],
            timeout_seconds=wait_seconds,
            manifest=installer_manifest,
        )
        installer_api_services = wait_api_services(installer_kubeconfig, installer_context, api_service_refs(installer_manifest), timeout_seconds=wait_seconds)
        installer_runtime["apiServices"] = installer_api_services
        installer_crd_observation = observe_crds(rendered_crds, installer_kubeconfig, installer_context)
        receipt["spec"].setdefault("crdObservations", {})["cubInstallerApply"] = installer_crd_observation
        check_item(
            "cub-installer-rendered-crds",
            installer_crd_observation["result"],
            f"observed={sum(item['result'] == 'pass' for item in installer_crd_observation['items'])}/{len(rendered_crds)}",
        )
        installer_clean = (
            installer_operations["result"] == "pass"
            and installer_api_services["result"] == "pass"
            and installer_crd_observation["result"] == "pass"
        )
        installer_result = "pass" if installer_clean and installer_runtime["result"] == "pass" else ("blocked" if installer_runtime["result"] == "blocked" else "watch")
        leg("cubInstallerApply",
            result=installer_result,
            renderCommand=" ".join(setup_cmd),
            applyMode="two-cluster vanilla-kind; namespace-first kubectl apply; separated secrets staged when present",
            namespace=args.namespace,
            manifestSHA256=sha256_text(installer_manifest),
            objectCount=len(object_map(installer_manifest)),
            manifestNamespaces=apply_info["manifestNamespaces"],
            runtimeNamespaces=apply_info["runtimeNamespaces"],
            runtime=installer_runtime,
        )
        check_item("cub-installer-apply-live", installer_result, installer_runtime.get("workloads", ""))
        if installer_api_services.get("items"):
            check_item(
                "cub-installer-apiservice-aggregation",
                installer_api_services["result"],
                "; ".join(f"{item['name']} available={item['available']} query={item['queryResult']}" for item in installer_api_services["items"]),
            )

        helm_compare_manifest = helm_live_manifest if helm_live_manifest else canonical_helm_manifest
        if helm_live_manifest:
            write_text(run_root / "regular-helm-compare-manifest.yaml", helm_compare_manifest)
        shared_observed_crd_keys = (
            helm_observed_crd_keys
            if installer_crd_observation["result"] == "pass"
            else []
        )
        allowed_extra_objects = sorted([
            f"v1|Namespace||{args.namespace}",
            *shared_observed_crd_keys,
        ])
        receipt["spec"]["semanticComparison"]["allowedExtraInstallerObjects"] = allowed_extra_objects
        receipt["spec"]["semanticComparison"]["helmManagedCRDsOmittedFromGetManifest"] = shared_observed_crd_keys
        comparison = semantic_compare(
            helm_compare_manifest,
            installer_manifest,
            allowed_extra_objects,
            semantic_normalizations,
        )
        receipt["spec"]["semanticComparison"]["helmVsCubInstallerApply"] = comparison
        check_item("semantic-object-parity", comparison["result"], f"missing={len(comparison['missingFromInstaller'])} extra={comparison['extraInInstaller']} diffs={len(comparison['semanticDiffs'])}")

        if comparison["result"] != "pass" or helm_result == "blocked":
            receipt["spec"]["result"] = "blocked"
        elif installer_result == "pass" and helm_runtime["result"] == "pass":
            receipt["spec"]["result"] = "pass"
        else:
            receipt["spec"]["result"] = "watch"

    except Exception as exc:
        receipt["spec"]["result"] = "blocked"
        check_item("failure", "blocked", str(exc))
        receipt["spec"]["failure"] = {"message": str(exc)}
    finally:
        if args.keep:
            receipt["spec"]["run"]["cleanup"] = {"result": "retained"}
        else:
            mark_stage("cleanup")
            for name, kubeconfig, label in [
                (helm_cluster, helm_kubeconfig, "helm"),
                (installer_cluster, installer_kubeconfig, "installer"),
            ]:
                rc, out, err = delete_kind_cluster(name, kubeconfig)
                cleanup_results.append({
                    "cluster": name,
                    "leg": label,
                    "result": "pass" if rc == 0 else "blocked",
                    "detail": (err or out)[:1000],
                })
            receipt["spec"]["run"]["cleanup"] = {
                "result": "pass" if all(item["result"] == "pass" for item in cleanup_results) else "blocked",
                "clusters": cleanup_results,
            }
        write_yaml(out_path, portable_receipt_value(receipt, repo))
        print(f"wrote {out_path.relative_to(repo)} result={receipt['spec']['result']}")

    return 0 if receipt["spec"]["result"] in ("pass", "watch", "blocked") else 1


if __name__ == "__main__":
    sys.exit(main())
