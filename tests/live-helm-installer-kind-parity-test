try:
    import yaml
except ImportError:  # pragma: no cover
    yaml = None

if yaml:
    class KubernetesYamlLoader(yaml.SafeLoader):
        pass

    KubernetesYamlLoader.yaml_implicit_resolvers = {
        key: [
            (tag, regexp)
            for tag, regexp in resolvers
            if tag != "tag:yaml.org,2002:value"
        ]
        for key, resolvers in yaml.SafeLoader.yaml_implicit_resolvers.items()
    }
else:  # pragma: no cover
    KubernetesYamlLoader = None


def sh(cmd: list[str], timeout: int = 120, env: dict[str, str] | None = None) -> tuple[int, str, str]:
    try:
        proc = subprocess.run(cmd, text=True, capture_output=True, timeout=timeout, env=env)
        return proc.returncode, proc.stdout.strip(), proc.stderr.strip()
    except subprocess.TimeoutExpired:
        return 124, "", f"timeout after {timeout}s"


def helm_chart_command_args(chart: str, repo_url: str) -> list[str]:
    chart_name = chart.split("/", 1)[1] if "/" in chart else chart
    if repo_url.startswith("oci://"):
        repo = repo_url.rstrip("/")
        chart_ref = repo if repo.rsplit("/", 1)[-1] == chart_name else f"{repo}/{chart_name}"
        return [chart_ref]
    return [chart_name, "--repo", repo_url]


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def write_text(path: Path, text: str) -> str:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    return hashlib.sha256(path.read_bytes()).hexdigest()


def write_yaml(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if yaml:
        path.write_text(yaml.safe_dump(data, sort_keys=False, default_flow_style=False))
    else:
        path.write_text(json.dumps(data, indent=2) + "\n")


def portable_receipt_value(value, repo: Path):
    if isinstance(value, dict):
        return {
            key: portable_receipt_value(item, repo)
            for key, item in value.items()
        }
    if isinstance(value, list):
        return [portable_receipt_value(item, repo) for item in value]
    if not isinstance(value, str):
        return value
    repo_prefix = f"{repo.resolve()}{os.sep}"
    home_prefix = f"{Path.home().resolve()}{os.sep}"
    return value.replace(repo_prefix, "").replace(home_prefix, "$HOME/")


def load_yaml(path: Path) -> dict:
    if not yaml:
        raise RuntimeError("PyYAML is required for live parity tests")
    return yaml.load(path.read_text(), Loader=KubernetesYamlLoader) or {}


def semantic_normalizations_for(revision_path: Path) -> list[str]:
    receipt_path = revision_path.parent / "receipts" / "helm-equivalence-receipt.yaml"
    if not receipt_path.exists():
        return []
    receipt = load_yaml(receipt_path)
    values = ((receipt.get("spec") or {}).get("semanticNormalizations") or [])
    return [str(item) for item in values if isinstance(item, str)]


def raw_values_file(source: Path, destination: Path) -> Path:
    data = load_yaml(source)
    if data.get("kind") == "EffectiveValues" and isinstance(data.get("spec", {}).get("values"), dict):
        values = data["spec"]["values"] or {}
        render_delta = str(data.get("spec", {}).get("renderDelta") or "").strip()
        if render_delta:
            values = apply_render_delta(values, render_delta)
        write_yaml(destination, values)
        return destination
    shutil.copyfile(source, destination)
    return destination


def apply_render_delta(values: dict, render_delta: str) -> dict:
    updated = json.loads(json.dumps(values))
    delta_path = Path(render_delta)
    if (Path.cwd() / delta_path).exists() and delta_path.suffix in {".yaml", ".yml"}:
        extra = load_yaml(Path.cwd() / delta_path)
        if isinstance(extra, dict):
            deep_merge(updated, extra)
        return updated
    if not looks_like_value_assignments(render_delta):
        return updated
    for raw_item in re.split(r"[,;]", render_delta):
        item = raw_item.strip()
        if not item:
            continue
        key, raw_value = item.split("=", 1)
        set_dotted_value(updated, key.strip(), parse_scalar(raw_value.strip()))
    return updated


def looks_like_value_assignments(render_delta: str) -> bool:
    items = [item.strip() for item in re.split(r"[,;]", render_delta) if item.strip()]
    return bool(items) and all(re.match(r"^[A-Za-z0-9_.-]+=", item) for item in items)


def deep_merge(target: dict, source: dict) -> dict:
    for key, value in source.items():
        if isinstance(value, dict) and isinstance(target.get(key), dict):
            deep_merge(target[key], value)
        else:
            target[key] = value
    return target


def set_dotted_value(target: dict, dotted_key: str, value) -> None:
    cursor = target
    parts = [part for part in dotted_key.split(".") if part]
    for part in parts[:-1]:
        cursor = cursor.setdefault(part, {})
    if parts:
        cursor[parts[-1]] = value


def parse_scalar(value: str):
    if value.lower() == "true":
        return True
    if value.lower() == "false":
        return False
    if value.lower() == "null":
        return None
    if re.match(r"^-?[0-9]+$", value):
        return int(value)
    if re.match(r"^-?[0-9]+\.[0-9]+$", value):
        return float(value)
    return value


def yaml_docs(text: str) -> list[dict]:
    if not yaml:
        raise RuntimeError("PyYAML is required for live parity tests")
    return [doc for doc in yaml.load_all(text, Loader=KubernetesYamlLoader) if isinstance(doc, dict)]


def object_identity(doc: dict) -> str:
    meta = doc.get("metadata") or {}
    return "|".join([
        str(doc.get("apiVersion") or ""),
        str(doc.get("kind") or ""),
        str(meta.get("namespace") or ""),
        str(meta.get("name") or ""),
    ])


def prune(value):
    if isinstance(value, dict):
        return {key: prune(item) for key, item in value.items() if item is not None}
    if isinstance(value, list):
        return [prune(item) for item in value]
    return value


def trim_command_block_leading_newline(value, key: str | None = None):
    if isinstance(value, dict):
        return {item_key: trim_command_block_leading_newline(item, item_key) for item_key, item in value.items()}
    if isinstance(value, list):
        return [trim_command_block_leading_newline(item, key) for item in value]
    if key in {"args", "command"} and isinstance(value, str) and value.startswith("\n"):
        return value[1:]
    return value


def normalize_json_configmap_data(doc: dict):
    if doc.get("kind") != "ConfigMap":
        return
    data = doc.get("data")
    if not isinstance(data, dict):
        return
    for key, value in list(data.items()):
        if not key.endswith(".json") or not isinstance(value, str):
            continue
        try:
            parsed = json.loads(value)
        except json.JSONDecodeError:
            continue
        data[key] = json.dumps(parsed, sort_keys=True, separators=(",", ":"), ensure_ascii=True)


def apply_semantic_normalizations(doc: dict, semantic_normalizations: list[str]) -> dict:
    identity = object_identity(doc)
    if (
        "loki-configmap-leading-blank-line-pruned-by-kustomize" in semantic_normalizations
        and identity == "v1|ConfigMap|loki|loki"
    ):
        config = doc.get("data", {}).get("config.yaml")
        if isinstance(config, str) and config.startswith("\n"):
            doc["data"]["config.yaml"] = config[1:]
    if "trim-leading-command-block-newline" in semantic_normalizations:
        doc = trim_command_block_leading_newline(doc)
    if (
        "consul-namespace-reference-normalization" in semantic_normalizations
        and doc.get("kind") == "RoleBinding"
    ):
        namespace = (doc.get("metadata") or {}).get("namespace")
        if namespace:
            for subject in doc.get("subjects") or []:
                if subject.get("kind") == "ServiceAccount" and subject.get("namespace") == namespace:
                    subject.pop("namespace", None)
    if "consul-namespace-reference-normalization" in semantic_normalizations:
        normalize_json_configmap_data(doc)
    if (
        "consul-statefulset-gitops-defaults" in semantic_normalizations
        and identity == "apps/v1|StatefulSet|consul|consul-consul-server"
    ):
        spec = doc.get("spec") or {}
        spec.pop("persistentVolumeClaimRetentionPolicy", None)
        spec.pop("revisionHistoryLimit", None)
        spec.pop("updateStrategy", None)
        pod_spec = (((spec.get("template") or {}).get("spec")) or {})
        pod_spec.pop("dnsPolicy", None)
        pod_spec.pop("restartPolicy", None)
        pod_spec.pop("schedulerName", None)
        pod_spec.pop("serviceAccount", None)
        for container in pod_spec.get("containers") or []:
            container.pop("imagePullPolicy", None)
            container.pop("terminationMessagePath", None)
            container.pop("terminationMessagePolicy", None)
            for env in container.get("env") or []:
                (((env.get("valueFrom") or {}).get("fieldRef") or {})).pop("apiVersion", None)
            for port in container.get("ports") or []:
                port.pop("protocol", None)
            for mount in container.get("volumeMounts") or []:
                if mount.get("readOnly") is False:
                    mount.pop("readOnly", None)
        for container in pod_spec.get("initContainers") or []:
            container.pop("imagePullPolicy", None)
            if container.get("resources") == {}:
                container.pop("resources", None)
            container.pop("terminationMessagePath", None)
            container.pop("terminationMessagePolicy", None)
            for env in container.get("env") or []:
                (((env.get("valueFrom") or {}).get("fieldRef") or {})).pop("apiVersion", None)
        for volume in pod_spec.get("volumes") or []:
            if isinstance(volume.get("configMap"), dict):
                volume["configMap"].pop("defaultMode", None)
        for claim in spec.get("volumeClaimTemplates") or []:
            claim.pop("apiVersion", None)
            claim.pop("kind", None)
            claim.pop("status", None)
            claim_spec = claim.get("spec") or {}
            claim_spec.pop("volumeMode", None)
    return doc


def object_map(text: str, semantic_normalizations: list[str] | None = None) -> dict[str, str]:
    semantic_normalizations = semantic_normalizations or []
    result = {}
    for doc in yaml_docs(text):
        meta = doc.get("metadata")
        if not isinstance(meta, dict):
            continue
        if not doc.get("apiVersion") or not doc.get("kind") or not meta.get("name"):
            continue
        doc = prune(doc)
        meta = doc.get("metadata") or {}
        for optional_map in ("annotations", "labels"):
            if meta.get(optional_map) == {}:
                meta.pop(optional_map, None)
        doc = apply_semantic_normalizations(doc, semantic_normalizations)
        result[object_identity(doc)] = json.dumps(doc, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    return result


def collect_yaml(root: Path) -> str:
    docs = []
    if not root.exists():
        return ""
    for path in sorted(root.glob("*.yaml")):
        text = path.read_text()
        if text.strip():
            docs.append(text.rstrip())
    return "\n---\n".join(docs) + ("\n" if docs else "")


def combine_yaml_parts(*parts: str) -> str:
    docs = [part.strip() for part in parts if part.strip()]
    return "\n---\n".join(docs) + ("\n" if docs else "")


def render_docs_to_yaml(docs: list[dict]) -> str:
    if not docs:
        return ""
    return "\n---\n".join(yaml.safe_dump(doc, sort_keys=False).strip() for doc in docs) + "\n"


def docs_matching(text: str, kind: str) -> list[dict]:
    return [doc for doc in yaml_docs(text) if doc.get("kind") == kind]


def manifest_namespaces(text: str) -> list[str]:
    namespaces = set()
    for doc in yaml_docs(text):
        meta = doc.get("metadata") or {}
        namespace = meta.get("namespace")
        if isinstance(namespace, str) and namespace:
            namespaces.add(namespace)
        if doc.get("kind") == "Namespace":
            name = meta.get("name")
            if isinstance(name, str) and name:
                namespaces.add(name)
    return sorted(namespaces)


def workload_namespaces(text: str, fallback: str) -> list[str]:
    workload_kinds = {"Deployment", "StatefulSet", "DaemonSet", "CronJob", "Job"}
    namespaces = set()
    for doc in yaml_docs(text):
        if doc.get("kind") not in workload_kinds:
            continue
        namespace = (doc.get("metadata") or {}).get("namespace")
        if isinstance(namespace, str) and namespace:
            namespaces.add(namespace)
    return sorted(namespaces)


def protected_namespace(namespace: str) -> bool:
    return namespace in ("default", "kube-system", "kube-public", "kube-node-lease")


def kubectl(args: list[str], kubeconfig: Path, context: str, timeout: int = 120) -> tuple[int, str, str]:
    return sh(["kubectl", "--kubeconfig", str(kubeconfig), "--context", context, *args], timeout=timeout)


def kubectl_must(args: list[str], kubeconfig: Path, context: str, step: str, timeout: int = 120) -> str:
    rc, out, err = kubectl(args, kubeconfig, context, timeout=timeout)
    if rc != 0:
        raise RuntimeError(f"{step} failed: {(err or out)[:1000]}")
    return out


target_fact_material_cache: dict[tuple[str, str], tuple[str, ...]] = {}


def ensure_tls_material(run_root: Path) -> tuple[str, str]:
    cache_key = ("tls", str(run_root))
    cached = target_fact_material_cache.get(cache_key)
    if cached:
        return cached[0], cached[1]
    with tempfile.TemporaryDirectory(prefix="helm-expt-target-fact-tls-") as temp_root:
        cert = Path(temp_root) / "tls.crt"
        key = Path(temp_root) / "tls.key"
        rc, out, err = sh([
            "openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes",
            "-keyout", str(key), "-out", str(cert), "-subj", "/CN=helm-expt.local",
            "-days", "1",
        ], timeout=60)
        if rc != 0:
            raise RuntimeError(f"target fact TLS material generation failed: {(err or out)[:1000]}")
        material = (cert.read_text(), key.read_text())
    target_fact_material_cache[cache_key] = material
    return material


def ensure_consul_tls_material(run_root: Path) -> tuple[str, str, str]:
    cache_key = ("consul", str(run_root))
    cached = target_fact_material_cache.get(cache_key)
    if cached:
        return cached[0], cached[1], cached[2]
    with tempfile.TemporaryDirectory(prefix="helm-expt-target-fact-consul-") as temp_root:
        temp_path = Path(temp_root)
        ca_cert = temp_path / "ca.crt"
        ca_key = temp_path / "ca.key"
        server_cert = temp_path / "server.crt"
        server_key = temp_path / "server.key"
        server_csr = temp_path / "server.csr"
        server_config = temp_path / "server-openssl.cnf"
        rc, out, err = sh([
            "openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes",
            "-keyout", str(ca_key), "-out", str(ca_cert), "-subj", "/CN=helm-expt-consul-ca",
            "-days", "1",
        ], timeout=60)
        if rc != 0:
            raise RuntimeError(f"Consul target fact CA generation failed: {(err or out)[:1000]}")
        server_config.write_text("""[req]
distinguished_name = req_distinguished_name
req_extensions = v3_req
prompt = no

[req_distinguished_name]
CN = consul-consul-server.consul.svc

[v3_req]
basicConstraints = CA:FALSE
keyUsage = critical,digitalSignature,keyEncipherment
extendedKeyUsage = serverAuth,clientAuth
subjectAltName = @alt_names

[alt_names]
DNS.1 = consul-consul-server
DNS.2 = consul-consul-server.consul
DNS.3 = consul-consul-server.consul.svc
DNS.4 = consul-consul-server.consul.svc.cluster.local
DNS.5 = server.consul.consul
DNS.6 = server.dc1.consul
DNS.7 = localhost
IP.1 = 127.0.0.1
""")
        rc, out, err = sh([
            "openssl", "req", "-new", "-newkey", "rsa:2048", "-nodes",
            "-keyout", str(server_key), "-out", str(server_csr), "-config", str(server_config),
        ], timeout=60)
        if rc != 0:
            raise RuntimeError(f"Consul target fact server CSR generation failed: {(err or out)[:1000]}")
        rc, out, err = sh([
            "openssl", "x509", "-req", "-in", str(server_csr),
            "-CA", str(ca_cert), "-CAkey", str(ca_key), "-CAcreateserial",
            "-out", str(server_cert), "-days", "1",
            "-extensions", "v3_req", "-extfile", str(server_config),
        ], timeout=60)
        if rc != 0:
            raise RuntimeError(f"Consul target fact server certificate generation failed: {(err or out)[:1000]}")
        material = (ca_cert.read_text(), server_cert.read_text(), server_key.read_text())
    target_fact_material_cache[cache_key] = material
    return material


