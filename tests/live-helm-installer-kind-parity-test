#!/usr/bin/env python3
"""Run one strict live Helm-vs-installer parity test on two vanilla kind clusters.

This test intentionally does not use cub-lk, ConfigHub upload, OCI, Argo CD, or
Flux. It checks one simpler claim:

  1. regular Helm installs chart/base inputs on vanilla kind cluster A
  2. cub installer renders/applies the matching package/base on vanilla kind
     cluster B
  3. the rendered objects are semantically equivalent and both clusters reach
     the same readiness class

The GitOps/OCI lane remains separate. This strict lane is the safer default for
parity because CRDs and controllers in one leg cannot contaminate the other.
"""
from __future__ import annotations

import argparse
import base64
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

try:
    import yaml
except ImportError:  # pragma: no cover
    yaml = None

if yaml:
    class KubernetesYamlLoader(yaml.SafeLoader):
        pass

    KubernetesYamlLoader.yaml_implicit_resolvers = {
        key: [
            (tag, regexp)
            for tag, regexp in resolvers
            if tag != "tag:yaml.org,2002:value"
        ]
        for key, resolvers in yaml.SafeLoader.yaml_implicit_resolvers.items()
    }
else:  # pragma: no cover
    KubernetesYamlLoader = None


def sh(cmd: list[str], timeout: int = 120, env: dict[str, str] | None = None) -> tuple[int, str, str]:
    try:
        proc = subprocess.run(cmd, text=True, capture_output=True, timeout=timeout, env=env)
        return proc.returncode, proc.stdout.strip(), proc.stderr.strip()
    except subprocess.TimeoutExpired:
        return 124, "", f"timeout after {timeout}s"


def helm_chart_command_args(chart: str, repo_url: str) -> list[str]:
    chart_name = chart.split("/", 1)[1] if "/" in chart else chart
    if repo_url.startswith("oci://"):
        repo = repo_url.rstrip("/")
        chart_ref = repo if repo.rsplit("/", 1)[-1] == chart_name else f"{repo}/{chart_name}"
        return [chart_ref]
    return [chart_name, "--repo", repo_url]


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def write_text(path: Path, text: str) -> str:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    return hashlib.sha256(path.read_bytes()).hexdigest()


def write_yaml(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if yaml:
        path.write_text(yaml.safe_dump(data, sort_keys=False, default_flow_style=False))
    else:
        path.write_text(json.dumps(data, indent=2) + "\n")


def load_yaml(path: Path) -> dict:
    if not yaml:
        raise RuntimeError("PyYAML is required for live parity tests")
    return yaml.load(path.read_text(), Loader=KubernetesYamlLoader) or {}


def semantic_normalizations_for(revision_path: Path) -> list[str]:
    receipt_path = revision_path.parent / "receipts" / "helm-equivalence-receipt.yaml"
    if not receipt_path.exists():
        return []
    receipt = load_yaml(receipt_path)
    values = ((receipt.get("spec") or {}).get("semanticNormalizations") or [])
    return [str(item) for item in values if isinstance(item, str)]


def raw_values_file(source: Path, destination: Path) -> Path:
    data = load_yaml(source)
    if data.get("kind") == "EffectiveValues" and isinstance(data.get("spec", {}).get("values"), dict):
        write_yaml(destination, data["spec"]["values"])
        return destination
    shutil.copyfile(source, destination)
    return destination


def yaml_docs(text: str) -> list[dict]:
    if not yaml:
        raise RuntimeError("PyYAML is required for live parity tests")
    return [doc for doc in yaml.load_all(text, Loader=KubernetesYamlLoader) if isinstance(doc, dict)]


def object_identity(doc: dict) -> str:
    meta = doc.get("metadata") or {}
    return "|".join([
        str(doc.get("apiVersion") or ""),
        str(doc.get("kind") or ""),
        str(meta.get("namespace") or ""),
        str(meta.get("name") or ""),
    ])


def prune(value):
    if isinstance(value, dict):
        return {key: prune(item) for key, item in value.items() if item is not None}
    if isinstance(value, list):
        return [prune(item) for item in value]
    return value


def trim_command_block_leading_newline(value, key: str | None = None):
    if isinstance(value, dict):
        return {item_key: trim_command_block_leading_newline(item, item_key) for item_key, item in value.items()}
    if isinstance(value, list):
        return [trim_command_block_leading_newline(item, key) for item in value]
    if key in {"args", "command"} and isinstance(value, str) and value.startswith("\n"):
        return value[1:]
    return value


def normalize_json_configmap_data(doc: dict):
    if doc.get("kind") != "ConfigMap":
        return
    data = doc.get("data")
    if not isinstance(data, dict):
        return
    for key, value in list(data.items()):
        if not key.endswith(".json") or not isinstance(value, str):
            continue
        try:
            parsed = json.loads(value)
        except json.JSONDecodeError:
            continue
        data[key] = json.dumps(parsed, sort_keys=True, separators=(",", ":"), ensure_ascii=True)


def apply_semantic_normalizations(doc: dict, semantic_normalizations: list[str]) -> dict:
    identity = object_identity(doc)
    if (
        "loki-configmap-leading-blank-line-pruned-by-kustomize" in semantic_normalizations
        and identity == "v1|ConfigMap|loki|loki"
    ):
        config = doc.get("data", {}).get("config.yaml")
        if isinstance(config, str) and config.startswith("\n"):
            doc["data"]["config.yaml"] = config[1:]
    if "trim-leading-command-block-newline" in semantic_normalizations:
        doc = trim_command_block_leading_newline(doc)
    if (
        "consul-namespace-reference-normalization" in semantic_normalizations
        and doc.get("kind") == "RoleBinding"
    ):
        namespace = (doc.get("metadata") or {}).get("namespace")
        if namespace:
            for subject in doc.get("subjects") or []:
                if subject.get("kind") == "ServiceAccount" and subject.get("namespace") == namespace:
                    subject.pop("namespace", None)
    if "consul-namespace-reference-normalization" in semantic_normalizations:
        normalize_json_configmap_data(doc)
    if (
        "consul-statefulset-gitops-defaults" in semantic_normalizations
        and identity == "apps/v1|StatefulSet|consul|consul-consul-server"
    ):
        spec = doc.get("spec") or {}
        spec.pop("persistentVolumeClaimRetentionPolicy", None)
        spec.pop("revisionHistoryLimit", None)
        spec.pop("updateStrategy", None)
        pod_spec = (((spec.get("template") or {}).get("spec")) or {})
        pod_spec.pop("dnsPolicy", None)
        pod_spec.pop("restartPolicy", None)
        pod_spec.pop("schedulerName", None)
        pod_spec.pop("serviceAccount", None)
        for container in pod_spec.get("containers") or []:
            container.pop("imagePullPolicy", None)
            container.pop("terminationMessagePath", None)
            container.pop("terminationMessagePolicy", None)
            for env in container.get("env") or []:
                (((env.get("valueFrom") or {}).get("fieldRef") or {})).pop("apiVersion", None)
            for port in container.get("ports") or []:
                port.pop("protocol", None)
            for mount in container.get("volumeMounts") or []:
                if mount.get("readOnly") is False:
                    mount.pop("readOnly", None)
        for container in pod_spec.get("initContainers") or []:
            container.pop("imagePullPolicy", None)
            if container.get("resources") == {}:
                container.pop("resources", None)
            container.pop("terminationMessagePath", None)
            container.pop("terminationMessagePolicy", None)
            for env in container.get("env") or []:
                (((env.get("valueFrom") or {}).get("fieldRef") or {})).pop("apiVersion", None)
        for volume in pod_spec.get("volumes") or []:
            if isinstance(volume.get("configMap"), dict):
                volume["configMap"].pop("defaultMode", None)
        for claim in spec.get("volumeClaimTemplates") or []:
            claim.pop("apiVersion", None)
            claim.pop("kind", None)
            claim.pop("status", None)
            claim_spec = claim.get("spec") or {}
            claim_spec.pop("volumeMode", None)
    return doc


def object_map(text: str, semantic_normalizations: list[str] | None = None) -> dict[str, str]:
    semantic_normalizations = semantic_normalizations or []
    result = {}
    for doc in yaml_docs(text):
        meta = doc.get("metadata")
        if not isinstance(meta, dict):
            continue
        if not doc.get("apiVersion") or not doc.get("kind") or not meta.get("name"):
            continue
        doc = prune(doc)
        meta = doc.get("metadata") or {}
        for optional_map in ("annotations", "labels"):
            if meta.get(optional_map) == {}:
                meta.pop(optional_map, None)
        doc = apply_semantic_normalizations(doc, semantic_normalizations)
        result[object_identity(doc)] = json.dumps(doc, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    return result


def collect_yaml(root: Path) -> str:
    docs = []
    if not root.exists():
        return ""
    for path in sorted(root.glob("*.yaml")):
        text = path.read_text()
        if text.strip():
            docs.append(text.rstrip())
    return "\n---\n".join(docs) + ("\n" if docs else "")


def combine_yaml_parts(*parts: str) -> str:
    docs = [part.strip() for part in parts if part.strip()]
    return "\n---\n".join(docs) + ("\n" if docs else "")


def render_docs_to_yaml(docs: list[dict]) -> str:
    if not docs:
        return ""
    return "\n---\n".join(yaml.safe_dump(doc, sort_keys=False).strip() for doc in docs) + "\n"


def docs_matching(text: str, kind: str) -> list[dict]:
    return [doc for doc in yaml_docs(text) if doc.get("kind") == kind]


def manifest_namespaces(text: str) -> list[str]:
    namespaces = set()
    for doc in yaml_docs(text):
        meta = doc.get("metadata") or {}
        namespace = meta.get("namespace")
        if isinstance(namespace, str) and namespace:
            namespaces.add(namespace)
        if doc.get("kind") == "Namespace":
            name = meta.get("name")
            if isinstance(name, str) and name:
                namespaces.add(name)
    return sorted(namespaces)


def workload_namespaces(text: str, fallback: str) -> list[str]:
    workload_kinds = {"Deployment", "StatefulSet", "DaemonSet"}
    namespaces = set()
    for doc in yaml_docs(text):
        if doc.get("kind") not in workload_kinds:
            continue
        namespace = (doc.get("metadata") or {}).get("namespace")
        if isinstance(namespace, str) and namespace:
            namespaces.add(namespace)
    return sorted(namespaces) or [fallback]


def protected_namespace(namespace: str) -> bool:
    return namespace in ("default", "kube-system", "kube-public", "kube-node-lease")


def kubectl(args: list[str], kubeconfig: Path, context: str, timeout: int = 120) -> tuple[int, str, str]:
    return sh(["kubectl", "--kubeconfig", str(kubeconfig), "--context", context, *args], timeout=timeout)


def kubectl_must(args: list[str], kubeconfig: Path, context: str, step: str, timeout: int = 120) -> str:
    rc, out, err = kubectl(args, kubeconfig, context, timeout=timeout)
    if rc != 0:
        raise RuntimeError(f"{step} failed: {(err or out)[:1000]}")
    return out


def cert_needs_refresh(cert: Path, key: Path) -> bool:
    if not cert.exists() or not key.exists():
        return True
    rc, _out, _err = sh(["openssl", "x509", "-checkend", "3600", "-noout", "-in", str(cert)], timeout=30)
    return rc != 0


def ensure_tls_material(run_root: Path) -> tuple[str, str]:
    cert = run_root / "target-facts-tls.crt"
    key = run_root / "target-facts-tls.key"
    if cert_needs_refresh(cert, key):
        cert.unlink(missing_ok=True)
        key.unlink(missing_ok=True)
        rc, out, err = sh([
            "openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes",
            "-keyout", str(key), "-out", str(cert), "-subj", "/CN=helm-expt.local",
            "-days", "1",
        ], timeout=60)
        if rc != 0:
            raise RuntimeError(f"target fact TLS material generation failed: {(err or out)[:1000]}")
    return cert.read_text(), key.read_text()


def ensure_consul_tls_material(run_root: Path) -> tuple[str, str, str]:
    ca_cert = run_root / "consul-target-facts-ca.crt"
    ca_key = run_root / "consul-target-facts-ca.key"
    server_cert = run_root / "consul-target-facts-server.crt"
    server_key = run_root / "consul-target-facts-server.key"
    server_csr = run_root / "consul-target-facts-server.csr"
    server_config = run_root / "consul-target-facts-server-openssl.cnf"
    needs_refresh = (
        cert_needs_refresh(ca_cert, ca_key)
        or cert_needs_refresh(server_cert, server_key)
        or not server_cert.exists()
        or not server_key.exists()
    )
    if needs_refresh:
        for path in (ca_cert, ca_key, server_cert, server_key, server_csr):
            path.unlink(missing_ok=True)
        rc, out, err = sh([
            "openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes",
            "-keyout", str(ca_key), "-out", str(ca_cert), "-subj", "/CN=helm-expt-consul-ca",
            "-days", "1",
        ], timeout=60)
        if rc != 0:
            raise RuntimeError(f"Consul target fact CA generation failed: {(err or out)[:1000]}")
        server_config.write_text("""[req]
distinguished_name = req_distinguished_name
req_extensions = v3_req
prompt = no

[req_distinguished_name]
CN = consul-consul-server.consul.svc

[v3_req]
basicConstraints = CA:FALSE
keyUsage = critical,digitalSignature,keyEncipherment
extendedKeyUsage = serverAuth,clientAuth
subjectAltName = @alt_names

[alt_names]
DNS.1 = consul-consul-server
DNS.2 = consul-consul-server.consul
DNS.3 = consul-consul-server.consul.svc
DNS.4 = consul-consul-server.consul.svc.cluster.local
DNS.5 = server.consul.consul
DNS.6 = server.dc1.consul
DNS.7 = localhost
IP.1 = 127.0.0.1
""")
        rc, out, err = sh([
            "openssl", "req", "-new", "-newkey", "rsa:2048", "-nodes",
            "-keyout", str(server_key), "-out", str(server_csr), "-config", str(server_config),
        ], timeout=60)
        if rc != 0:
            raise RuntimeError(f"Consul target fact server CSR generation failed: {(err or out)[:1000]}")
        rc, out, err = sh([
            "openssl", "x509", "-req", "-in", str(server_csr),
            "-CA", str(ca_cert), "-CAkey", str(ca_key), "-CAcreateserial",
            "-out", str(server_cert), "-days", "1",
            "-extensions", "v3_req", "-extfile", str(server_config),
        ], timeout=60)
        if rc != 0:
            raise RuntimeError(f"Consul target fact server certificate generation failed: {(err or out)[:1000]}")
    return ca_cert.read_text(), server_cert.read_text(), server_key.read_text()


def ensure_metrics_server_tls_material(run_root: Path) -> tuple[str, str]:
    cert = run_root / "metrics-server-target-facts-tls.crt"
    key = run_root / "metrics-server-target-facts-tls.key"
    config = run_root / "metrics-server-target-facts-openssl.cnf"
    if cert_needs_refresh(cert, key):
        cert.unlink(missing_ok=True)
        key.unlink(missing_ok=True)
        config.write_text("""[req]
distinguished_name = req_distinguished_name
x509_extensions = v3_req
prompt = no

[req_distinguished_name]
CN = metrics-server.kube-system.svc

[v3_req]
basicConstraints = critical,CA:TRUE
keyUsage = critical,digitalSignature,keyEncipherment,keyCertSign
extendedKeyUsage = serverAuth
subjectAltName = @alt_names

[alt_names]
DNS.1 = metrics-server
DNS.2 = metrics-server.kube-system
DNS.3 = metrics-server.kube-system.svc
DNS.4 = metrics-server.kube-system.svc.cluster.local
""")
        rc, out, err = sh([
            "openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes",
            "-keyout", str(key), "-out", str(cert), "-days", "1",
            "-config", str(config),
        ], timeout=60)
        if rc != 0:
            raise RuntimeError(f"metrics-server target fact TLS material generation failed: {(err or out)[:1000]}")
    return cert.read_text(), key.read_text()


def target_fact_value(secret_name: str, key: str, run_root: Path) -> str:
    if secret_name == "consul-ca-cert" and key in ("tls.crt", "ca.crt"):
        return ensure_consul_tls_material(run_root)[0]
    if secret_name == "consul-server-cert" and key == "tls.crt":
        return ensure_consul_tls_material(run_root)[1]
    if secret_name == "consul-server-cert" and key == "tls.key":
        return ensure_consul_tls_material(run_root)[2]
    if secret_name == "metrics-server-tls" and key in ("cert", "tls.crt", "ca.crt"):
        return ensure_metrics_server_tls_material(run_root)[0]
    if secret_name == "metrics-server-tls" and key in ("key", "tls.key"):
        return ensure_metrics_server_tls_material(run_root)[1]
    if key in ("cert", "tls.crt", "ca.crt", "ca") and ("admission" in secret_name or "webhook" in secret_name):
        return ensure_tls_material(run_root)[0]
    if key in ("key", "tls.key") and ("admission" in secret_name or "webhook" in secret_name):
        return ensure_tls_material(run_root)[1]
    if key in ("tls.crt", "ca.crt"):
        return ensure_tls_material(run_root)[0]
    if key == "tls.key":
        return ensure_tls_material(run_root)[1]
    if key == "admin-user":
        return "admin"
    if key == "key" and "gossip" in secret_name:
        return "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
    if key == "mongodb-replica-set-key":
        return "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
    if key in ("access_key", "access-key"):
        return "helm-expt-access-key"
    if key in ("secret_key", "secret-key"):
        return "helm-expt-secret-key"
    if key == "token":
        return "helm-expt-token"
    if "cookie" in key:
        return "helm-expt-cookie"
    return "helm-expt-password"


def target_fact_env(secret_name: str, key: str) -> dict:
    return {
        "secretKeyRef": {
            "name": secret_name,
            "key": key,
        }
    }


def set_dotted_path(data: dict, path: str, value) -> None:
    cursor = data
    parts = path.split(".")
    for part in parts[:-1]:
        existing = cursor.get(part)
        if not isinstance(existing, dict):
            existing = {}
            cursor[part] = existing
        cursor = existing
    cursor[parts[-1]] = value


def target_fact_required_values(variant: dict, lane: str) -> list[dict]:
    return [
        item
        for item in (((variant.get("spec") or {}).get("targetFacts") or {}).get("requiredValues") or [])
        if target_fact_applies(item, lane)
    ]


def value_for_required_value(item: dict, consumer: str, run_root: Path) -> str:
    if item.get("source") == "metrics-server-tls-ca" or item.get("path") == "apiService.caBundle":
        cert, _ = ensure_metrics_server_tls_material(run_root)
        if consumer == "installer":
            return base64.b64encode(cert.encode("utf-8")).decode("ascii")
        return cert
    raise RuntimeError(f"no target fact value generator for {item.get('path')}")


def apply_helm_required_value_overrides(values_path: Path, variant: dict, run_root: Path) -> list[dict]:
    required_values = target_fact_required_values(variant, "regularHelm")
    if not required_values:
        return []
    data = load_yaml(values_path)
    applied = []
    for item in required_values:
        path = item.get("path")
        if not path:
            raise RuntimeError(f"invalid required value target fact: {item}")
        value = value_for_required_value(item, "helm", run_root)
        set_dotted_path(data, path, value)
        applied.append({
            "path": path,
            "lane": "regularHelm",
            "valueSHA256": sha256_text(value),
            "format": item.get("regularHelmFormat") or "raw",
        })
    write_yaml(values_path, data)
    return applied


def installer_required_value_inputs(variant: dict, run_root: Path) -> tuple[list[str], list[dict]]:
    required_values = target_fact_required_values(variant, "cubInstallerApply")
    args = []
    applied = []
    for item in required_values:
        input_name = item.get("installerInput")
        path = item.get("path")
        if not input_name or not path:
            raise RuntimeError(f"required value {path or '<missing>'} must declare installerInput")
        value = value_for_required_value(item, "installer", run_root)
        args.extend(["--input", f"{input_name}={value}"])
        applied.append({
            "path": path,
            "lane": "cubInstallerApply",
            "installerInput": input_name,
            "valueSHA256": sha256_text(value),
            "format": item.get("installerInputFormat") or "raw",
        })
    return args, applied


def target_fact_applies(item: dict, lane: str) -> bool:
    delivery_lanes = item.get("deliveryLanes") or item.get("stageFor") or []
    if not delivery_lanes:
        return True
    aliases = {
        "regularHelm": {"regularHelm", "helm"},
        "cubInstallerApply": {"cubInstallerApply", "installer", "config-only"},
    }
    accepted = aliases.get(lane, {lane})
    return any(item in accepted for item in delivery_lanes)


def target_fact_crd_docs(variant: dict, recipe_path: Path, run_root: Path, lane: str) -> tuple[list[dict], list[dict]]:
    required = [
        crd
        for crd in (((variant.get("spec") or {}).get("targetFacts") or {}).get("requiredCRDs") or [])
        if target_fact_applies(crd, lane)
    ]
    docs = []
    staged = []
    for crd in required:
        name = crd.get("name")
        if not name:
            raise RuntimeError(f"invalid required CRD target fact: {crd}")
        source_variant = crd.get("sourceVariant") or "default"
        source_path = crd.get("sourcePath")
        if source_path:
            source = (recipe_path / source_path).resolve() if not Path(source_path).is_absolute() else Path(source_path)
        else:
            source = recipe_path / "revisions" / source_variant / "r001" / "rendered" / "release-objects.yaml"
        if not source.exists():
            raise RuntimeError(f"required CRD source not found for {name}: {source}")
        matches = [doc for doc in yaml_docs(source.read_text()) if doc.get("kind") == "CustomResourceDefinition" and (doc.get("metadata") or {}).get("name") == name]
        if not matches:
            raise RuntimeError(f"required CRD {name} not found in {source}")
        docs.append(matches[0])
        staged.append({"name": name, "sourceVariant": source_variant, "lane": lane})
    return docs, staged


def target_fact_object_stores(variant: dict, lane: str) -> list[dict]:
    return [
        store
        for store in (((variant.get("spec") or {}).get("targetFacts") or {}).get("requiredObjectStores") or [])
        if target_fact_applies(store, lane)
    ]


