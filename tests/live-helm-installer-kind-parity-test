def target_fact_value(secret_name: str, key: str, run_root: Path) -> str:
    if secret_name == "cnpg-webhook-cert" and key in ("cert", "tls.crt", "ca.crt"):
        return ensure_cnpg_webhook_tls_material(run_root)[0]
    if secret_name == "cnpg-webhook-cert" and key in ("key", "tls.key"):
        return ensure_cnpg_webhook_tls_material(run_root)[1]
    if secret_name in ("vpa-tls-certs", "vpa-tls-secret") and key in ("ca", "cert"):
        return ensure_tls_material(run_root)[0]
    if secret_name in ("vpa-tls-certs", "vpa-tls-secret") and key == "key":
        return ensure_tls_material(run_root)[1]
    if secret_name == "consul-ca-cert" and key in ("tls.crt", "ca.crt"):
        return ensure_consul_tls_material(run_root)[0]
    if secret_name == "consul-server-cert" and key == "tls.crt":
        return ensure_consul_tls_material(run_root)[1]
    if secret_name == "consul-server-cert" and key == "tls.key":
        return ensure_consul_tls_material(run_root)[2]
    if secret_name == "metrics-server-tls" and key in ("cert", "tls.crt", "ca.crt"):
        return ensure_metrics_server_tls_material(run_root)[0]
    if secret_name == "metrics-server-tls" and key in ("key", "tls.key"):
        return ensure_metrics_server_tls_material(run_root)[1]
    if key in ("cert", "tls.crt", "ca.crt", "ca") and ("admission" in secret_name or "webhook" in secret_name):
        return ensure_tls_material(run_root)[0]
    if key in ("key", "tls.key") and ("admission" in secret_name or "webhook" in secret_name):
        return ensure_tls_material(run_root)[1]
    if key in ("tls.crt", "ca.crt"):
        return ensure_tls_material(run_root)[0]
    if key == "tls.key":
        return ensure_tls_material(run_root)[1]
    if key == "admin-user":
        return "admin"
    if key == "key" and "gossip" in secret_name:
        return "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
    if key == "mongodb-replica-set-key":
        return "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
    if key in ("access_key", "access-key"):
        return "helm-expt-access-key"
    if key in ("secret_key", "secret-key"):
        return "helm-expt-secret-key"
    if key == "token":
        return "helm-expt-token"
    if "cookie" in key:
        return "helm-expt-cookie"
    return "helm-expt-password"


def target_fact_env(secret_name: str, key: str) -> dict:
    return {
        "secretKeyRef": {
            "name": secret_name,
            "key": key,
        }
    }


def set_dotted_path(data: dict, path: str, value) -> None:
    cursor = data
    parts = path.split(".")
    for part in parts[:-1]:
        existing = cursor.get(part)
        if not isinstance(existing, dict):
            existing = {}
            cursor[part] = existing
        cursor = existing
    cursor[parts[-1]] = value


def target_fact_required_values(variant: dict, lane: str) -> list[dict]:
    return [
        item
        for item in (((variant.get("spec") or {}).get("targetFacts") or {}).get("requiredValues") or [])
        if target_fact_applies(item, lane)
    ]


def value_for_required_value(item: dict, consumer: str, run_root: Path) -> str:
    if item.get("source") == "metrics-server-tls-ca" or item.get("path") == "apiService.caBundle":
        cert, _ = ensure_metrics_server_tls_material(run_root)
        if consumer == "installer":
            return base64.b64encode(cert.encode("utf-8")).decode("ascii")
        return cert
    raise RuntimeError(f"no target fact value generator for {item.get('path')}")


def apply_helm_required_value_overrides(values_path: Path, variant: dict, run_root: Path) -> list[dict]:
    required_values = target_fact_required_values(variant, "regularHelm")
    if not required_values:
        return []
    data = load_yaml(values_path)
    applied = []
    for item in required_values:
        path = item.get("path")
        if not path:
            raise RuntimeError(f"invalid required value target fact: {item}")
        value = value_for_required_value(item, "helm", run_root)
        set_dotted_path(data, path, value)
        applied.append({
            "path": path,
            "lane": "regularHelm",
            "valueSHA256": sha256_text(value),
            "format": item.get("regularHelmFormat") or "raw",
        })
    write_yaml(values_path, data)
    return applied


def installer_required_value_inputs(variant: dict, run_root: Path) -> tuple[list[str], list[dict]]:
    required_values = target_fact_required_values(variant, "cubInstallerApply")
    args = []
    applied = []
    for item in required_values:
        input_name = item.get("installerInput")
        path = item.get("path")
        if not input_name or not path:
            raise RuntimeError(f"required value {path or '<missing>'} must declare installerInput")
        value = value_for_required_value(item, "installer", run_root)
        args.extend(["--input", f"{input_name}={value}"])
        applied.append({
            "path": path,
            "lane": "cubInstallerApply",
            "installerInput": input_name,
            "valueSHA256": sha256_text(value),
            "format": item.get("installerInputFormat") or "raw",
        })
    return args, applied


def target_fact_applies(item: dict, lane: str) -> bool:
    delivery_lanes = item.get("deliveryLanes") or item.get("stageFor") or []
    if not delivery_lanes:
        return True
    aliases = {
        "regularHelm": {"regularHelm", "helm"},
        "cubInstallerApply": {"cubInstallerApply", "installer", "config-only"},
    }
    accepted = aliases.get(lane, {lane})
    return any(item in accepted for item in delivery_lanes)


def target_fact_crd_docs(
    variant: dict,
    recipe_path: Path,
    run_root: Path,
    lane: str,
    package_path: Path | None = None,
) -> tuple[list[dict], list[dict]]:
    required = [
        crd
        for crd in (((variant.get("spec") or {}).get("targetFacts") or {}).get("requiredCRDs") or [])
        if target_fact_applies(crd, lane)
        and crd.get("provisioningMode") != "operator-bootstrap"
    ]
    docs = []
    staged = []
    packaged_source = None
    if required and lane == "cubInstallerApply" and package_path is not None:
        base = str((variant.get("metadata") or {}).get("name") or "default")
        slug = re.sub(r"[^a-z0-9]+", "-", base.lower()).strip("-")
        candidate = package_path / "prerequisites" / "target-facts" / f"{slug}-crds.yaml"
        if candidate.exists():
            packaged_source = candidate
    for crd in required:
        name = crd.get("name")
        if not name:
            raise RuntimeError(f"invalid required CRD target fact: {crd}")
        source_variant = crd.get("sourceVariant") or "default"
        source_path = crd.get("sourcePath")
        if packaged_source is not None:
            source = packaged_source
            source_kind = "installer-package"
        elif source_path:
            source = (recipe_path / source_path).resolve() if not Path(source_path).is_absolute() else Path(source_path)
            source_kind = "recorded-source-path"
        else:
            source = recipe_path / "revisions" / source_variant / "r001" / "rendered" / "release-objects.yaml"
            source_kind = "recorded-source-variant"
        if not source.exists():
            raise RuntimeError(f"required CRD source not found for {name}: {source}")
        matches = [doc for doc in yaml_docs(source.read_text()) if doc.get("kind") == "CustomResourceDefinition" and (doc.get("metadata") or {}).get("name") == name]
        if not matches:
            raise RuntimeError(f"required CRD {name} not found in {source}")
        docs.append(matches[0])
        staged.append({
            "name": name,
            "sourceVariant": source_variant,
            "sourceKind": source_kind,
            "sourcePath": str(source),
            "lane": lane,
        })
    return docs, staged


def target_fact_operator_bootstraps(
    variant: dict,
    recipe_path: Path,
    lane: str,
    package_path: Path | None = None,
) -> list[dict]:
    required = [
        crd
        for crd in (((variant.get("spec") or {}).get("targetFacts") or {}).get("requiredCRDs") or [])
        if target_fact_applies(crd, lane)
        and crd.get("provisioningMode") == "operator-bootstrap"
    ]
    grouped = {}
    for crd in required:
        name = crd.get("name")
        if not name:
            raise RuntimeError(f"invalid operator-bootstrap CRD target fact: {crd}")
        suggested_source = str(crd.get("suggestedSource") or "")
        source_path = str(crd.get("sourcePath") or "")
        if lane == "cubInstallerApply" and package_path is not None and suggested_source.startswith("package://"):
            relative_path = suggested_source[len("package://"):]
            if not relative_path or ".." in Path(relative_path).parts:
                raise RuntimeError(f"unsafe operator-bootstrap package path for {name}: {suggested_source}")
            source = package_path / relative_path
            source_kind = "installer-package"
        elif source_path:
            source = (recipe_path / source_path).resolve() if not Path(source_path).is_absolute() else Path(source_path)
            source_kind = "recorded-source-path"
        else:
            raise RuntimeError(f"operator-bootstrap CRD {name} has no usable source")
        if not source.exists():
            raise RuntimeError(f"operator-bootstrap source not found for {name}: {source}")
        key = str(source)
        group = grouped.setdefault(key, {
            "source": source,
            "sourceKind": source_kind,
            "crds": [],
        })
        group["crds"].append({"name": name, "lane": lane})
    return [grouped[key] for key in sorted(grouped)]


def wait_for_crd_established(
    name: str,
    kubeconfig: Path,
    context: str,
    timeout_seconds: int = 300,
) -> None:
    deadline = time.monotonic() + timeout_seconds
    last = ""
    while time.monotonic() < deadline:
        rc, out, err = kubectl(
            ["get", f"crd/{name}", "-o", "name"],
            kubeconfig,
            context,
            timeout=30,
        )
        if rc == 0:
            remaining = max(1, int(deadline - time.monotonic()))
            kubectl_must(
                [
                    "wait", "--for=condition=Established", f"crd/{name}",
                    f"--timeout={remaining}s",
                ],
                kubeconfig,
                context,
                f"operator-bootstrap CRD {name}",
                timeout=remaining + 30,
            )
            return
        last = err or out
        time.sleep(3)
    raise RuntimeError(
        f"operator-bootstrap CRD {name} did not appear within "
        f"{timeout_seconds}s: {last[:500]}"
    )


def stage_operator_bootstraps(
    bootstraps: list[dict],
    kubeconfig: Path,
    context: str,
    label: str,
) -> list[dict]:
    staged = []
    for index, bootstrap in enumerate(bootstraps, start=1):
        source = bootstrap["source"]
        if source.name in {"kustomization.yaml", "kustomization.yml", "Kustomization"}:
            apply_args = ["apply", "--server-side", "-k", str(source.parent)]
            delete_args = ["delete", "-k", str(source.parent), "--ignore-not-found", "--wait=true"]
        else:
            apply_args = ["apply", "--server-side", "-f", str(source)]
            delete_args = ["delete", "-f", str(source), "--ignore-not-found", "--wait=true"]
        kubectl_must(
            apply_args,
            kubeconfig,
            context,
            f"operator bootstrap apply {label} {index}",
            timeout=300,
        )
        for crd in bootstrap["crds"]:
            wait_for_crd_established(crd["name"], kubeconfig, context)
        kubectl_must(
            delete_args,
            kubeconfig,
            context,
            f"operator bootstrap cleanup {label} {index}",
            timeout=300,
        )
        for crd in bootstrap["crds"]:
            kubectl_must(
                ["wait", "--for=condition=Established", f"crd/{crd['name']}", "--timeout=60s"],
                kubeconfig,
                context,
                f"operator-bootstrap retained CRD {crd['name']}",
                timeout=90,
            )
            staged.append({
                **crd,
                "provisioningMode": "operator-bootstrap",
                "sourceKind": bootstrap["sourceKind"],
                "sourcePath": str(source),
                "temporaryBootstrapRemoved": True,
            })
    return staged


def target_fact_object_stores(variant: dict, lane: str) -> list[dict]:
