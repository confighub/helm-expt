#!/usr/bin/env python3
"""Helm-expt Wave-1 work unit: install ONE catalog package at its default base
via `cub installer`, deliver it through ConfigHub -> OCI -> Argo on a cub-lk rig,
verify it, and emit a structured receipt.

Rig-agnostic: it operates on an existing cub-lk cluster (passed via --rig); the
caller owns `cub lk up`/`down`. That keeps this the parallel/agentic atom — a
coordinator can hand each agent its own rig (one cluster per agent) and shard the
charts. See tests/strategy.md.

Reality Rule: status comes from real command output, never a label. Pairs Argo
health with exact runtime field proof. Includes the F1 namespace-coherence guard.
"""
from __future__ import annotations
import argparse, json, re, subprocess, sys, time
from pathlib import Path

import yaml


def sh(cmd: list[str] | str, timeout: int = 120) -> tuple[int, str, str]:
    shell = isinstance(cmd, str)
    try:
        p = subprocess.run(cmd, shell=shell, text=True, capture_output=True, timeout=timeout)
        return p.returncode, p.stdout.strip(), p.stderr.strip()
    except subprocess.TimeoutExpired:
        return 124, "", f"timeout after {timeout}s"


def resolve_helm_expt(explicit: str | None) -> Path:
    if explicit:
        return Path(explicit).expanduser().resolve()
    here = Path(__file__).resolve().parents[1]
    for c in [here,
              Path("/Users/alexis/Public/github-repos/helm-expt"),
              Path("/Users/alexis/code/helm-expt")]:
        if c.exists():
            return c
    return here


def default_base(pkg: Path) -> str | None:
    """Resolve the default:true base via `cub installer doc` — robust to the
    real base names (e.g. `static-passwords`, `single-binary-filesystem`)
    and to key ordering in installer.yaml, which a regex got wrong."""
    rc, o, _ = sh(["cub", "installer", "doc", str(pkg)], timeout=60)
    if rc != 0:
        return None
    m = re.search(r"^\s*-\s*([\w.-]+)\s*\(default\)", o, re.M)
    return m.group(1) if m else None


def read_yaml(path: Path) -> dict:
    with path.open() as fh:
        return yaml.safe_load(fh) or {}


def write_yaml(path: Path, doc: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(yaml.safe_dump(doc, sort_keys=False))


def kubectl(args: list[str], kubeconfig: str, context: str, timeout: int = 120) -> tuple[int, str, str]:
    return sh(["kubectl", "--kubeconfig", kubeconfig, "--context", context, *args], timeout=timeout)


def cert_needs_refresh(cert: Path, key: Path) -> bool:
    if not cert.exists() or not key.exists():
        return True
    rc, _out, _err = sh(["openssl", "x509", "-checkend", "3600", "-noout", "-in", str(cert)], timeout=30)
    return rc != 0


def ensure_tls_material(run_root: Path) -> tuple[str, str]:
    run_root.mkdir(parents=True, exist_ok=True)
    cert = run_root / "target-facts-tls.crt"
    key = run_root / "target-facts-tls.key"
    if cert_needs_refresh(cert, key):
        cert.unlink(missing_ok=True)
        key.unlink(missing_ok=True)
        rc, out, err = sh([
            "openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes",
            "-keyout", str(key), "-out", str(cert), "-subj", "/CN=helm-expt.local",
            "-days", "1",
        ], timeout=60)
        if rc != 0:
            raise RuntimeError(f"target fact TLS material generation failed: {(err or out)[:1000]}")
    return cert.read_text(), key.read_text()


def target_fact_applies(item: dict, lane: str) -> bool:
    lanes = item.get("deliveryLanes") or item.get("stageFor") or []
    return not lanes or lane in lanes


def target_fact_value(secret_name: str, key: str, run_root: Path) -> str:
    if key in ("cert", "tls.crt", "ca.crt", "ca") and ("admission" in secret_name or "webhook" in secret_name):
        return ensure_tls_material(run_root)[0]
    if key in ("key", "tls.key") and ("admission" in secret_name or "webhook" in secret_name):
        return ensure_tls_material(run_root)[1]
    if key in ("tls.crt", "ca.crt"):
        return ensure_tls_material(run_root)[0]
    if key == "tls.key":
        return ensure_tls_material(run_root)[1]
    if key == "admin-user":
        return "admin"
    if key == "token":
        return "helm-expt-token"
    if "cookie" in key:
        return "helm-expt-cookie"
    return "helm-expt-password"


def variant_doc_for(helm_expt: Path, pkg: Path, base: str) -> dict:
    try:
        rel = pkg.relative_to(helm_expt / "packages")
    except ValueError:
        return {}
    path = helm_expt / "recipes" / rel / "variants" / base / "variant.yaml"
    return read_yaml(path) if path.exists() else {}


def ensure_namespace(namespace: str, kubeconfig: str, context: str) -> tuple[int, str, str]:
    rc, _out, _err = kubectl(["get", "namespace", namespace], kubeconfig, context, timeout=30)
    if rc == 0:
        return 0, "", ""
    return kubectl(["create", "namespace", namespace], kubeconfig, context, timeout=60)


def stage_prerequisites(helm_expt: Path, pkg: Path, base: str, workdir: str, kubeconfig: str, context: str, namespace: str) -> dict:
    variant = variant_doc_for(helm_expt, pkg, base)
    target_facts = (variant.get("spec") or {}).get("targetFacts") or {}
    required_secrets = [
        secret for secret in target_facts.get("requiredSecrets") or []
        if target_fact_applies(secret, "configHubOciArgo")
    ]
    secrets_dir = Path(workdir) / "out" / "secrets"
    separated_secret_files = sorted(secrets_dir.glob("*.yaml")) if secrets_dir.exists() else []
    namespaces = {namespace}
    for secret in required_secrets:
        namespaces.add(secret.get("namespace") or namespace)
    for path in separated_secret_files:
        doc = read_yaml(path)
        metadata = doc.get("metadata") or {}
        namespaces.add(metadata.get("namespace") or namespace)

    for ns_name in sorted(namespaces):
        rc, out, err = ensure_namespace(ns_name, kubeconfig, context)
        if rc != 0:
            return {"result": "block", "detail": f"namespace {ns_name} could not be created: {(err or out)[:200]}"}

    if separated_secret_files:
        rc, out, err = kubectl(["apply", "-f", str(secrets_dir)], kubeconfig, context, timeout=120)
        if rc != 0:
            return {"result": "block", "detail": f"separated Secrets could not be staged: {(err or out)[:300]}"}

    secret_docs = []
    run_root = Path(workdir) / ".target-facts"
    for secret in required_secrets:
        name = secret.get("name")
        keys = secret.get("keys") or []
        ns_name = secret.get("namespace") or namespace
        if not name or not keys:
            return {"result": "block", "detail": f"invalid required Secret target fact: {secret}"}
        string_data = {key: target_fact_value(name, key, run_root) for key in keys}
        secret_docs.append({
            "apiVersion": "v1",
            "kind": "Secret",
            "metadata": {"name": name, "namespace": ns_name},
            "type": "Opaque",
            "stringData": string_data,
        })
    if secret_docs:
        path = run_root / "configHubOciArgo-target-facts.yaml"
        write_yaml(path, {"apiVersion": "v1", "kind": "List", "items": secret_docs})
        rc, out, err = kubectl(["apply", "-f", str(path)], kubeconfig, context, timeout=120)
        if rc != 0:
            return {"result": "block", "detail": f"target fact Secrets could not be staged: {(err or out)[:300]}"}

    return {
        "result": "pass",
        "separatedSecrets": [path.name for path in separated_secret_files],
        "targetSecrets": [
            {
                "namespace": secret.get("namespace") or namespace,
                "name": secret.get("name"),
                "keys": sorted(secret.get("keys") or []),
            }
            for secret in required_secrets
        ],
    }


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--package", required=True, help="package path relative to helm-expt root, e.g. packages/bitnami/nginx/24.0.2")
    ap.add_argument("--slug", required=True, help="short id for spaces/receipt, e.g. nginx")
    ap.add_argument("--namespace", required=True, help="install namespace (use the TOP20 entry's namespace = the package's frozen ns)")
    ap.add_argument("--rig", required=True, help="cub-lk cluster name (must already be `cub lk up`)")
    ap.add_argument("--base", default=None, help="base to render; default = the package's default:true base")
    ap.add_argument("--helm-expt", default=None)
    ap.add_argument("--wait", type=int, default=180, help="seconds to wait for Argo app Healthy")
    ap.add_argument("--keep", action="store_true", help="do not delete the workload space + app afterwards")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    he = resolve_helm_expt(args.helm_expt)
    pkg = he / args.package
    rig = args.rig
    space_cluster = f"{rig}-cluster"
    target = f"{space_cluster}/oci"
    wspace = f"{rig}-{args.slug}"
    kubeconfig = str(Path.home() / ".confighub" / "lk" / f"{rig}.kubeconfig")
    kctx = f"kind-{rig}"
    workdir = f"/tmp/helm-wave-{rig}-{args.slug}"
    ns = args.namespace

    receipt: dict = {"slug": args.slug, "package": args.package, "namespace": ns,
                     "rig": rig, "base": None, "status": "BLOCK",
                     "proof_rows": [], "findings": [], "steps": []}

    def step(name, rc, detail):
        receipt["steps"].append({"step": name, "rc": rc, "detail": detail[:300]})
        return rc == 0

    def fail(msg):
        receipt["findings"].append(msg)
        receipt["status"] = "BLOCK"
        out()
        return 1

    def out():
        if args.json:
            print(json.dumps(receipt, indent=2))
        else:
            print(f"[{receipt['status']}] {args.slug}: {'; '.join(receipt['findings']) or 'ok'}")

    if not pkg.exists():
        return fail(f"package not found: {pkg}")

    base = args.base or default_base(pkg)
    receipt["base"] = base
    if not base:
        return fail("could not resolve default base")

    # 0. clean any stale work-dir so `installer setup` starts fresh rather than
    #    re-entering reconcile mode from a prior (possibly failed) run's state.
    sh(["rm", "-rf", workdir])

    # 1. render
    rc, o, e = sh(["cub", "installer", "setup", "--pull", str(pkg), "--base", base,
                   "--work-dir", workdir, "--non-interactive", "--namespace", ns],
                  timeout=180)
    if not step("setup", rc, o + e):
        return fail(f"installer setup failed: {(e or o)[:160]}")

    # 1b. F1 coherence guard
    man = Path(workdir) / "out" / "manifests"
    nslist = set()
    for f in man.glob("*.yaml"):
        for line in f.read_text().splitlines():
            m = re.match(r"\s*namespace:\s*\"?([\w.-]+)\"?", line)
            if m:
                nslist.add(m.group(1))
    unexpected_namespaces = sorted(n for n in nslist if n != ns and n not in ("kube-system", "kube-public", "kube-node-lease"))
    receipt["proof_rows"].append({"layer": "render", "result": "PASS" if not unexpected_namespaces else "BLOCK",
                                  "detail": f"namespaces in render: {sorted(nslist) or ['(none)']}"})
    if unexpected_namespaces:
        return fail(f"F1 incoherent render: unexpected namespaces {unexpected_namespaces} (expected {ns}; protected cluster namespaces are allowed)")

    try:
        prerequisites = stage_prerequisites(he, pkg, base, workdir, kubeconfig, kctx, ns)
    except Exception as exc:
        prerequisites = {"result": "block", "detail": str(exc)}
    receipt["targetFacts"] = prerequisites
    if prerequisites.get("result") != "pass":
        receipt["proof_rows"].append({"layer": "target-facts", "result": "BLOCK", "detail": prerequisites.get("detail", "target fact staging failed")})
        return fail(prerequisites.get("detail", "target fact staging failed"))
    receipt["proof_rows"].append({
        "layer": "target-facts",
        "result": "PASS",
        "detail": f"staged {len(prerequisites.get('separatedSecrets', []))} separated Secret(s) and {len(prerequisites.get('targetSecrets', []))} target Secret(s)",
    })

    # 2. upload
    upload_timeout = max(420, args.wait)
    rc, o, e = sh(["cub", "installer", "upload", "--work-dir", workdir,
                   "--space", wspace, "--target", target], timeout=upload_timeout)
    if not step("upload", rc, o + e):
        return fail(f"installer upload failed: {(e or o)[:160]}")
    receipt["proof_rows"].append({"layer": "confighub", "result": "PASS", "detail": f"units uploaded to {wspace}"})

    # 3. apply targeted units (Noop -> populate OCI bundle). Explicit list, excluding
    #    the untargeted installer-record and any header line.
    rc, names, e = sh(["cub", "unit", "list", "--space", wspace], timeout=60)
    units = []
    for ln in names.splitlines():
        tok = ln.split()
        if not tok:
            continue
        n = tok[0]
        if n in ("NAME", "installer-record"):
            continue
        units.append(n)
    if not units:
        return fail(f"no workload units found to apply in {wspace}")
    rc, o, e = sh(["cub", "unit", "apply", "--space", wspace, "--unit", ",".join(units)], timeout=180)
    if not step("apply-units", rc, o + e):
        return fail(f"unit apply failed: {(e or o)[:160]}")

    # 4. author + apply the Argo Application unit in the cluster space
    app = {"apiVersion": "argoproj.io/v1alpha1", "kind": "Application",
           "metadata": {"name": args.slug, "namespace": "argocd"},
           "spec": {"project": "default",
                    "source": {"repoURL": f"oci://oci.hub.confighub.com:443/target/{space_cluster}/oci",
                               "targetRevision": "latest", "path": f"./{wspace}"},
                    "destination": {"server": "https://kubernetes.default.svc", "namespace": ns},
                    "syncPolicy": {"automated": {"selfHeal": True, "prune": True},
                                   "syncOptions": ["ServerSideApply=true", "CreateNamespace=true"]}}}
    appfile = f"/tmp/app-{rig}-{args.slug}.yaml"
    Path(appfile).write_text(json.dumps(app))
    rc, o, e = sh(["cub", "unit", "create", "--space", space_cluster, f"{args.slug}-app", appfile, "--target", target], timeout=120)
    step("app-create", rc, o + e)  # tolerate already-exists on re-run
    rc, o, e = sh(["cub", "unit", "apply", "--space", space_cluster, "--unit", f"{args.slug}-app"], timeout=120)
    if not step("app-apply", rc, o + e):
        return fail(f"application apply failed: {(e or o)[:160]}")

    # The root Argo Application watches the cluster-space OCI artifact. Force a
    # refresh after adding the child Application Unit so the bounded wait below
    # observes the new child promptly instead of depending on Argo's poll window.
    rc, o, e = sh([
        "kubectl", "--kubeconfig", kubeconfig, "--context", kctx,
        "annotate", "application", space_cluster, "-n", "argocd",
        "argocd.argoproj.io/refresh=hard", "--overwrite",
    ], timeout=30)
    step("root-refresh", rc, o + e)

    # 5. wait for Argo app Healthy + Synced (bounded poll)
    deadline = args.wait
    waited, sync, health = 0, "", ""
    while waited < deadline:
        rc, o, e = sh(["kubectl", "--kubeconfig", kubeconfig, "--context", kctx, "get", "application",
                       args.slug, "-n", "argocd",
                       "-o", "jsonpath={.status.sync.status}|{.status.health.status}|{.status.sync.revision}"], timeout=30)
        if "|" in o:
            sync, health, rev = (o.split("|") + ["", "", ""])[:3]
            receipt["oci_revision"] = rev
            if sync == "Synced" and health == "Healthy":
                break
        time.sleep(10)
        waited += 10
    receipt["proof_rows"].append({"layer": "argo", "result": "PASS" if (sync == "Synced" and health == "Healthy") else "WATCH",
                                  "detail": f"app {args.slug}: sync={sync or '?'} health={health or '?'} after {waited}s"})

    # 6. exact runtime proof: workloads AND pod readiness in the namespace
    rc, o, e = sh(["kubectl", "--kubeconfig", kubeconfig, "--context", kctx, "get", "deploy,statefulset,daemonset",
                   "-n", ns, "--no-headers"], timeout=30)
    rc2, pods, _ = sh(["kubectl", "--kubeconfig", kubeconfig, "--context", kctx, "get", "pods",
                       "-n", ns, "--no-headers"], timeout=30)
    not_ready = []
    for ln in pods.splitlines():
        f = ln.split()
        if len(f) < 3:
            continue
        ready, status = f[1], f[2]
        ok = status in ("Running", "Completed")
        if "/" in ready:
            a, b = (ready.split("/") + ["", ""])[:2]
            ok = ok and a == b
        if not ok:
            not_ready.append((f[0], f"{status} {ready}"))
    runtime_ready = bool(o) and not not_ready
    nr_detail = "; ".join(f"{n}:{s}" for n, s in not_ready[:5])
    receipt["proof_rows"].append({"layer": "runtime",
                                  "result": "PASS" if runtime_ready else "WATCH",
                                  "detail": ((o[:240] or "no workloads found in namespace")
                                             + (f" | NOT-READY: {nr_detail}" if nr_detail else ""))})

    # status: PASS only if Argo Synced/Healthy AND workloads actually Ready AND coherent render
    argo_ok = (sync == "Synced" and health == "Healthy")
    if argo_ok and runtime_ready:
        receipt["status"] = "PASS"
    elif sync == "Synced":
        receipt["status"] = "WATCH"
        receipt["findings"].append(f"delivered but workload not Ready in {deadline}s (sync={sync} health={health}); not-ready: {nr_detail or 'see runtime row'} — likely a missing Secret/PVC/CRD (may be a permanent gap, not just slow)")
    else:
        receipt["status"] = "WATCH"
        receipt["findings"].append(f"Argo did not reach Synced in {deadline}s (sync={sync or '?'} health={health or '?'})")

    # 7. optional cleanup of the workload (leave the rig up)
    if not args.keep:
        # `cub unit apply --destroy` was removed; the destroy verb is now `cub unit destroy`.
        sh(["cub", "unit", "destroy", "--space", space_cluster, "--unit", f"{args.slug}-app", "--wait"], timeout=180)
        sh(["cub", "space", "delete", wspace, "--recursive"], timeout=120)
        sh(["cub", "unit", "delete", "--space", space_cluster, f"{args.slug}-app"], timeout=60)

    out()
    return 0


if __name__ == "__main__":
    sys.exit(main())
