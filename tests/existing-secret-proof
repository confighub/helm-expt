#!/usr/bin/env bash
# existing-secret-proof — runtime proof for the secret-needing catalog path.
#
# Proves the F3 fix-path: for each secret-needing chart, pre-provision the exact
# Secret(s) the package's collector live-checks (out-of-band, the supported
# existing-secret pattern), then install the chart's existing-secret base via
# cub installer -> ConfigHub -> OCI -> Argo and confirm runtime-Ready. Contrast
# with the default base (F3), which renders an undelivered Secret -> the pod
# sits in CreateContainerConfigError.
#
# Secret names/keys below are exactly what each package's collector/target-facts.sh
# checks in live mode. Workloads are cleaned up per chart (no --keep) to stay
# within the machine's memory budget.
set -uo pipefail
RIG="${1:?usage: pilot-helm-existing-secret-proof <rig>}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WORKUNIT="$ROOT/tests/chart-install-test"
OUT="$ROOT/tests/results/$RIG"
KC="$HOME/.confighub/lk/$RIG.kubeconfig"
KCTX="kind-$RIG"
DEV="devSecret123"
mkdir -p "$OUT"

# slug|pkg|ns|es_base|secretspec   secretspec = name=key1,key2;name2=keyA
ROWS='redis|packages/bitnami/redis/25.5.3|redis|reuse-existing-secret|redis-existing-secret=redis-password
postgresql|packages/bitnami/postgresql/18.6.7|postgresql|existing-secret|postgresql-auth=postgres-password
mysql|packages/bitnami/mysql/14.0.3|mysql|existing-secret|mysql-auth=mysql-root-password,mysql-password,mysql-replication-password
mongodb|packages/bitnami/mongodb/19.0.7|mongodb|existing-secret-replicaset|mongodb-auth=mongodb-root-password,mongodb-replica-set-key
rabbitmq|packages/bitnami/rabbitmq/16.0.14|rabbitmq|existing-secret|rabbitmq-auth=rabbitmq-password;rabbitmq-erlang-cookie=rabbitmq-erlang-cookie
grafana|packages/grafana/grafana/10.5.15|grafana|existing-secret-ingress|grafana-admin=admin-user,admin-password'

while IFS='|' read -r slug pkg ns base secretspec; do
  [ -z "$slug" ] && continue
  echo "=== ${slug}-es (ns=$ns, base=$base) ==="
  kubectl --kubeconfig "$KC" --context "$KCTX" create namespace "$ns" >/dev/null 2>&1 || true
  IFS=';' read -ra secs <<< "$secretspec"
  for s in "${secs[@]}"; do
    name="${s%%=*}"; keys="${s#*=}"
    args=()
    IFS=',' read -ra ks <<< "$keys"
    for k in "${ks[@]}"; do args+=("--from-literal=$k=$DEV"); done
    kubectl --kubeconfig "$KC" --context "$KCTX" -n "$ns" delete secret "$name" >/dev/null 2>&1 || true
    if kubectl --kubeconfig "$KC" --context "$KCTX" -n "$ns" create secret generic "$name" "${args[@]}" >/dev/null 2>&1; then
      echo "  pre-provisioned Secret $name (keys: $keys)"
    else
      echo "  WARN: failed to create Secret $name"
    fi
  done
  "$WORKUNIT" --package "$pkg" --slug "${slug}-es" --namespace "$ns" --rig "$RIG" --base "$base" --wait 240 --json \
    > "$OUT/receipt-${slug}-es.json" 2>/dev/null
  st=$(grep -m1 '"status"' "$OUT/receipt-${slug}-es.json" | sed 's/.*: *"//; s/".*//')
  echo "  [${st:-NO-JSON}] ${slug}-es -> receipt-${slug}-es.json"
done <<< "$ROWS"
echo "=== existing-secret proof sweep complete on $RIG ==="
