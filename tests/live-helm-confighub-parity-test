def object_map(
    text: str,
    namespace_map: dict[str, str] | None = None,
    semantic_normalizations: list[str] | None = None,
) -> dict[str, str]:
    namespace_map = namespace_map or {}
    semantic_normalizations = semantic_normalizations or []
    result = {}
    for doc in yaml_docs(text):
        meta = doc.get("metadata")
        if not isinstance(meta, dict):
            continue
        if not doc.get("apiVersion") or not doc.get("kind") or not meta.get("name"):
            continue
        doc = normalize_namespace_references(prune(doc), namespace_map)
        if doc.get("kind") == "Namespace":
            name = doc.get("metadata", {}).get("name")
            if name in namespace_map:
                doc["metadata"]["name"] = namespace_map[name]
        meta = doc.get("metadata") or {}
        for optional_map in ("annotations", "labels"):
            if meta.get(optional_map) == {}:
                meta.pop(optional_map, None)
        doc = apply_semantic_normalizations(doc, semantic_normalizations)
        result[object_identity(doc)] = json.dumps(doc, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    return result


def collect_yaml(root: Path) -> str:
    docs = []
    if not root.exists():
        return ""
    for path in sorted(root.glob("*.yaml")):
        text = path.read_text()
        if text.strip():
            docs.append(text.rstrip())
    return "\n---\n".join(docs) + ("\n" if docs else "")


def combine_yaml_parts(*parts: str) -> str:
    docs = [part.strip() for part in parts if part.strip()]
    return "\n---\n".join(docs) + ("\n" if docs else "")


def helm_wait_timeout(output: str) -> bool:
    lowered = output.lower()
    return (
        "context deadline exceeded" in lowered
        and ("not ready" in lowered or "status: inprogress" in lowered)
    )


def render_docs_to_yaml(docs: list[dict]) -> str:
    if not docs:
        return ""
    if yaml:
        return "\n---\n".join(yaml.safe_dump(doc, sort_keys=False).strip() for doc in docs) + "\n"
    return "\n---\n".join(json.dumps(doc, indent=2) for doc in docs) + "\n"


def namespace_secret_for_destination(secret_path: Path, destination_namespace: str, out_dir: Path) -> Path:
    docs = yaml_docs(secret_path.read_text())
    changed = False
    for doc in docs:
        if doc.get("kind") != "Secret":
            continue
        metadata = doc.setdefault("metadata", {})
        if not metadata.get("namespace"):
            metadata["namespace"] = destination_namespace
            changed = True
    if not changed:
        return secret_path
    out_dir.mkdir(parents=True, exist_ok=True)
    staged_path = out_dir / secret_path.name
    write_text(staged_path, render_docs_to_yaml(docs))
    return staged_path


def rendered_lifecycle_secret_docs(manifest: str, destination_namespace: str) -> list[dict]:
    docs = []
    service_accounts = {}
    manifest_docs = yaml_docs(manifest)
    for doc in manifest_docs:
        if doc.get("kind") == "ServiceAccount":
            metadata = doc.get("metadata") or {}
            name = metadata.get("name")
            namespace = metadata.get("namespace") or destination_namespace
            if name:
                service_accounts[(namespace, name)] = doc
    for doc in manifest_docs:
        if doc.get("kind") != "Secret":
            continue
        if doc.get("type") != "kubernetes.io/service-account-token":
            continue
        metadata = doc.get("metadata") or {}
        annotations = metadata.get("annotations") or {}
        service_account_name = annotations.get("kubernetes.io/service-account.name")
        if not service_account_name:
            continue
        namespace = metadata.get("namespace") or destination_namespace
        service_account = service_accounts.get((namespace, service_account_name))
        if service_account:
            staged_service_account = json.loads(json.dumps(service_account))
            staged_service_account_metadata = staged_service_account.setdefault("metadata", {})
            if not staged_service_account_metadata.get("namespace"):
                staged_service_account_metadata["namespace"] = namespace
            docs.append(staged_service_account)
        staged = json.loads(json.dumps(doc))
        staged_metadata = staged.setdefault("metadata", {})
        if not staged_metadata.get("namespace"):
            staged_metadata["namespace"] = destination_namespace
        docs.append(staged)
    return docs


def stage_rendered_lifecycle_secrets(
    manifest: str,
    kubeconfig: Path,
    context: str,
    destination_namespace: str,
    run_root: Path,
    label: str,
) -> dict:
    docs = rendered_lifecycle_secret_docs(manifest, destination_namespace)
    if not docs:
        return {"result": "not-needed", "count": 0, "secrets": []}
    path = run_root / f"{label}-rendered-lifecycle-secrets.yaml"
    secrets = [doc for doc in docs if doc.get("kind") == "Secret"]
    service_accounts = [doc for doc in docs if doc.get("kind") == "ServiceAccount"]
    write_text(path, render_docs_to_yaml(docs))
    kubectl_must(["apply", "-f", str(path)], kubeconfig, context, f"{label} lifecycle secret apply", timeout=120)
    return {
        "result": "pass",
        "count": len(secrets),
        "manifest": str(path.relative_to(run_root)),
        "stagedServiceAccounts": [
            {
                "namespace": (doc.get("metadata") or {}).get("namespace", destination_namespace),
                "name": (doc.get("metadata") or {}).get("name"),
            }
            for doc in service_accounts
        ],
        "secrets": [
            {
                "namespace": (doc.get("metadata") or {}).get("namespace", destination_namespace),
                "name": (doc.get("metadata") or {}).get("name"),
                "type": doc.get("type"),
                "serviceAccount": ((doc.get("metadata") or {}).get("annotations") or {}).get("kubernetes.io/service-account.name"),
            }
            for doc in secrets
        ],
        "reason": "rendered kubernetes.io/service-account-token Secrets are Kubernetes lifecycle state required by controllers; each is staged with its referenced ServiceAccount so token-controller ordering matches a normal apply wave, without treating user credential Secrets as ConfigHub Units",
    }


