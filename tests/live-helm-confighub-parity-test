def argocd_core_status(kubeconfig: Path, context: str, app: str, run_root: Path | None = None, label: str | None = None) -> dict:
    if shutil.which("argocd") is None:
        return {"result": "unavailable", "reason": "argocd CLI not found on PATH"}
    core_kubeconfig = kubeconfig_with_context_namespace(kubeconfig, context, "argocd")
    env = {**os.environ, "KUBECONFIG": str(core_kubeconfig)}
    base_command = [
        "argocd", "app", "get", app,
        "--core",
        "--kube-context", context,
        "--app-namespace", "argocd",
        "--hard-refresh",
    ]
    try:
        rc_json, json_out, json_err = sh([*base_command, "-o", "json"], timeout=120, env=env)
        rc_tree, tree_out, tree_err = sh([*base_command, "-o", "tree=detailed"], timeout=120, env=env)
    finally:
        if core_kubeconfig != kubeconfig:
            core_kubeconfig.unlink(missing_ok=True)
    result = "pass" if rc_json == 0 or rc_tree == 0 else "blocked"
    artifact_prefix = safe_artifact_label(label or app)
    json_artifact = None
    tree_artifact = None
    if run_root is not None:
        json_artifact = artifact(
            run_root / f"argocd-core-{artifact_prefix}.json",
            json_out if rc_json == 0 else (json_err or json_out),
        )
        tree_artifact = artifact(
            run_root / f"argocd-core-{artifact_prefix}-tree.txt",
            tree_out if rc_tree == 0 else (tree_err or tree_out),
        )
    summary = {}
    if rc_json == 0 and json_out:
        try:
            payload = json.loads(json_out)
            status = payload.get("status") or {}
            summary = {
                "sync": (status.get("sync") or {}).get("status", ""),
                "health": (status.get("health") or {}).get("status", ""),
                "operationPhase": ((status.get("operationState") or {}).get("phase") or ""),
                "conditions": len(status.get("conditions") or []),
                "resources": len(status.get("resources") or []),
            }
        except json.JSONDecodeError as exc:
            summary = {"jsonError": str(exc)}
    return {
        "result": result,
        "coreNamespace": "argocd",
        "temporaryKubeconfigNamespace": core_kubeconfig != kubeconfig,
        "json": {
            "result": "pass" if rc_json == 0 else "blocked",
            "summary": summary,
            "artifact": json_artifact,
            "output": json_out[:6000] if rc_json == 0 else (json_err or json_out)[:2000],
        },
        "tree": {
            "result": "pass" if rc_tree == 0 else "blocked",
            "artifact": tree_artifact,
            "output": (tree_out if rc_tree == 0 else (tree_err or tree_out))[:8000],
        },
    }


def cub_scout_gitops_status(kubeconfig: Path) -> dict:
    if shutil.which("cub-scout") is None:
        return {"result": "unavailable", "reason": "cub-scout not found on PATH"}
    env = {**os.environ, "KUBECONFIG": str(kubeconfig)}
    rc, out, err = sh(["cub-scout", "gitops", "status", "--json"], timeout=120, env=env)
    result = "pass" if rc == 0 else "blocked"
    summary = {}
    if rc == 0 and out:
        try:
            payload = json.loads(out)
            summary = {
                "backendCount": len(payload.get("backends") or []),
                "applicationCount": len(payload.get("applications") or []),
                "sourceCount": len(payload.get("sources") or []),
                "resourceCount": len(payload.get("resources") or []),
            }
        except json.JSONDecodeError as exc:
            summary = {"jsonError": str(exc)}
    return {
        "result": result,
        "summary": summary,
        "output": (out if rc == 0 else (err or out))[:8000],
    }


def target_fact_tls_root(run_root: Path) -> Path:
    identity = hashlib.sha256(str(run_root.resolve()).encode()).hexdigest()[:16]
    root = Path(tempfile.gettempdir()) / f"helm-expt-target-facts-{identity}"
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    root.chmod(0o700)
    return root


def ensure_tls_material(run_root: Path, dns_names: list[str] | None = None) -> tuple[str, str]:
    names = sorted({name for name in (dns_names or []) if name})
    suffix = f"-{hashlib.sha256(chr(10).join(names).encode()).hexdigest()[:12]}" if names else ""
    material_root = target_fact_tls_root(run_root)
    cert = material_root / f"target-facts-tls{suffix}.crt"
    key = material_root / f"target-facts-tls{suffix}.key"
    needs_generation = not cert.exists() or not key.exists()
    if cert.exists():
        # The live lane reuses run directories so receipts and diagnostic files
        # stay inspectable. Generated target-fact certificates must not be reused
        # after their validity window, otherwise reruns fail for the wrong reason.
        rc, _out, _err = sh(["openssl", "x509", "-checkend", str(12 * 60 * 60), "-noout", "-in", str(cert)], timeout=30)
        if rc != 0:
            needs_generation = True
    if needs_generation:
        cert.unlink(missing_ok=True)
        key.unlink(missing_ok=True)
        command = [
            "openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes",
            "-keyout", str(key), "-out", str(cert), "-subj", f"/CN={names[0] if names else 'helm-expt.local'}",
            "-days", "1",
            "-addext", "basicConstraints=critical,CA:TRUE",
            "-addext", "keyUsage=critical,digitalSignature,keyEncipherment,keyCertSign",
        ]
        if names:
            command.extend(["-addext", f"subjectAltName={','.join(f'DNS:{name}' for name in names)}"])
        rc, out, err = sh(command, timeout=60)
        if rc != 0:
            raise RuntimeError(f"target fact TLS material generation failed: {(err or out)[:1000]}")
    return cert.read_text(), key.read_text()


def secret_identity(secret: dict) -> str:
    return f"{secret.get('namespace', 'default')}/{secret.get('name')}"


def target_fact_tls_material(secrets: list[dict], run_root: Path) -> dict[str, dict[str, str]]:
    material: dict[str, dict[str, str]] = {}
    for secret in secrets:
        required_dns_names = secret.get("requiredDNSNames") or []
        keys = set(secret.get("keys") or [])
        if not required_dns_names or not {"tls.crt", "tls.key"}.issubset(keys):
            continue
        cert, key = ensure_tls_material(run_root, required_dns_names)
        identity = secret_identity(secret)
        material[identity] = {"tls.crt": cert, "tls.key": key}
        if secret.get("name"):
            material[str(secret.get("name"))] = {"tls.crt": cert, "tls.key": key}
        ca_secret_name = secret.get("caSecretName")
        if ca_secret_name:
            ca_identity = f"{secret.get('namespace', 'default')}/{ca_secret_name}"
            material.setdefault(ca_identity, {})["tls.crt"] = cert
            material.setdefault(str(ca_secret_name), {})["tls.crt"] = cert
    return material


def target_fact_value(secret_name: str, key: str, run_root: Path, secret: dict | None = None, tls_material: dict[str, dict[str, str]] | None = None) -> str:
    if secret:
        precomputed = (tls_material or {}).get(secret_identity(secret), {}) or (tls_material or {}).get(str(secret.get("name")), {})
        if key in precomputed:
            return precomputed[key]
    required_dns_names = (secret or {}).get("requiredDNSNames") or []
    secret_looks_like_tls = (
        "admission" in secret_name
        or "webhook" in secret_name
        or "tls" in secret_name
        or bool(required_dns_names)
    )
    if key in ("ca", "cert", "tls.crt", "ca.crt") and secret_looks_like_tls:
        return ensure_tls_material(run_root, required_dns_names)[0]
    if key in ("key", "tls.key") and secret_looks_like_tls:
        return ensure_tls_material(run_root, required_dns_names)[1]
    if key in ("tls.crt", "ca.crt"):
        return ensure_tls_material(run_root, required_dns_names)[0]
    if key == "tls.key":
        return ensure_tls_material(run_root, required_dns_names)[1]
    if key == "admin-user":
        return "admin"
    if key == "key" and "gossip" in secret_name:
        return "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
    if key == "mongodb-replica-set-key":
        return "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
    if key in ("access_key", "access-key"):
        return "helm-expt-access-key"
    if key in ("secret_key", "secret-key"):
        return "helm-expt-secret-key"
    if key == "token":
        return "helm-expt-token"
    if "cookie" in key:
        return "helm-expt-cookie"
    return "helm-expt-password"


def target_fact_env(secret_name: str, key: str) -> dict:
    return {
        "secretKeyRef": {
            "name": secret_name,
            "key": key,
        }
    }


def target_fact_applies(item: dict, lane: str) -> bool:
    delivery_lanes = item.get("deliveryLanes") or item.get("stageFor") or []
    if not delivery_lanes:
        return True
    aliases = {
        "regularHelm": {"regularHelm", "helm"},
        "configHubKubectlApply": {"configHubKubectlApply", "cubInstallerApply", "installer", "config-only"},
        "configHubOciArgo": {"configHubOciArgo", "cubInstallerApply", "installer", "config-only"},
    }
    accepted = aliases.get(lane, {lane})
    return any(item in accepted for item in delivery_lanes)


def target_fact_crd_docs(variant: dict, recipe_path: Path, lane: str) -> tuple[list[dict], list[dict]]:
    required = [
        crd
        for crd in (((variant.get("spec") or {}).get("targetFacts") or {}).get("requiredCRDs") or [])
        if target_fact_applies(crd, lane)
    ]
    docs = []
    staged = []
    for crd in required:
        name = crd.get("name")
        if not name:
            raise RuntimeError(f"invalid required CRD target fact: {crd}")
        source_variant = crd.get("sourceVariant") or "default"
        source_path = crd.get("sourcePath")
        if source_path:
            source = (recipe_path / source_path).resolve() if not Path(source_path).is_absolute() else Path(source_path)
        else:
            source = recipe_path / "revisions" / source_variant / "r001" / "rendered" / "release-objects.yaml"
        if not source.exists():
            raise RuntimeError(f"required CRD source not found for {name}: {source}")
        matches = [doc for doc in yaml_docs(source.read_text()) if doc.get("kind") == "CustomResourceDefinition" and (doc.get("metadata") or {}).get("name") == name]
        if not matches:
            raise RuntimeError(f"required CRD {name} not found in {source}")
        docs.append(matches[0])
        staged.append({"name": name, "sourceVariant": source_variant, "lane": lane})
    return docs, staged


def target_fact_object_stores(variant: dict, lane: str) -> list[dict]:
    return [
        store
        for store in (((variant.get("spec") or {}).get("targetFacts") or {}).get("requiredObjectStores") or [])
        if target_fact_applies(store, lane)
    ]


def target_fact_namespaces(variant: dict, lane: str) -> list[dict]:
    return [
        namespace
        for namespace in (((variant.get("spec") or {}).get("targetFacts") or {}).get("requiredNamespaces") or [])
        if target_fact_applies(namespace, lane)
    ]


