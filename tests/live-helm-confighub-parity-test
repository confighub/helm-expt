API_RESOURCE_NAMESPACED_CACHE: dict[tuple[str, str], bool | None] = {}


def api_group(api_version: str) -> str:
    if "/" not in api_version:
        return ""
    return api_version.split("/", 1)[0]


def api_resource_namespaced(doc: dict, kubeconfig: Path, context: str) -> bool | None:
    api_version = str(doc.get("apiVersion") or "")
    kind = str(doc.get("kind") or "")
    if not api_version or not kind:
        return None
    key = (api_version, kind)
    if key in API_RESOURCE_NAMESPACED_CACHE:
        return API_RESOURCE_NAMESPACED_CACHE[key]
    rc, out, _ = kubectl(
        ["api-resources", "--api-group", api_group(api_version), "--no-headers"],
        kubeconfig,
        context,
        timeout=60,
    )
    if rc != 0:
        API_RESOURCE_NAMESPACED_CACHE[key] = None
        return None
    for line in out.splitlines():
        parts = line.split()
        if len(parts) < 3:
            continue
        if parts[-1] == kind and parts[-3] == api_version and parts[-2] in {"true", "false"}:
            API_RESOURCE_NAMESPACED_CACHE[key] = parts[-2] == "true"
            return API_RESOURCE_NAMESPACED_CACHE[key]
    API_RESOURCE_NAMESPACED_CACHE[key] = None
    return None


def should_default_namespace(doc: dict, kubeconfig: Path, context: str) -> bool:
    kind = doc.get("kind")
    if not kind or kind in KNOWN_CLUSTER_SCOPED_KINDS:
        return False
    if kind in KNOWN_NAMESPACED_KINDS:
        return True
    namespaced = api_resource_namespaced(doc, kubeconfig, context)
    return namespaced is True


def namespace_missing_direct_apply_docs(
    text: str,
    destination_namespace: str,
    kubeconfig: Path,
    context: str,
) -> tuple[str, list[str]]:
    docs = yaml_docs(text)
    changed = []
    for doc in docs:
        metadata = doc.setdefault("metadata", {})
        if not isinstance(metadata, dict) or metadata.get("namespace"):
            continue
        if should_default_namespace(doc, kubeconfig, context):
            metadata["namespace"] = destination_namespace
            changed.append(object_identity(doc))
    if not changed:
        return text, []
    return render_docs_to_yaml(docs), changed


def docs_matching(text: str, kind: str) -> list[dict]:
    return [doc for doc in yaml_docs(text) if doc.get("kind") == kind]


def manifest_namespaces(text: str) -> list[str]:
    namespaces = set()
    for doc in yaml_docs(text):
        meta = doc.get("metadata") or {}
        namespace = meta.get("namespace")
        if isinstance(namespace, str) and namespace:
            namespaces.add(namespace)
        if doc.get("kind") == "Namespace":
            name = meta.get("name")
            if isinstance(name, str) and name:
                namespaces.add(name)
    return sorted(namespaces)


def namespaced_cleanup_docs(text: str, namespaces: set[str]) -> list[dict]:
    docs = []
    for doc in yaml_docs(text):
        if doc.get("kind") == "Namespace":
            continue
        meta = doc.get("metadata") or {}
        namespace = meta.get("namespace")
        if isinstance(namespace, str) and namespace in namespaces:
            docs.append(doc)
    return docs


def existing_namespaced_doc_identities(docs: list[dict], kubeconfig: Path, context: str) -> set[str]:
    identities = set()
    for doc in docs:
        meta = doc.get("metadata") or {}
        kind = doc.get("kind")
        namespace = meta.get("namespace")
        name = meta.get("name")
        if not kind or not namespace or not name:
            continue
        rc, _, _ = kubectl(["-n", namespace, "get", str(kind), str(name), "-o", "name"], kubeconfig, context, timeout=30)
        if rc == 0:
            identities.add(object_identity(doc))
    return identities


def exclude_cleanup_identities(docs: list[dict], identities: set[str]) -> list[dict]:
    if not identities:
        return docs
    return [doc for doc in docs if object_identity(doc) not in identities]


def cluster_scoped_cleanup_docs(text: str) -> list[dict]:
    docs = []
    for doc in yaml_docs(text):
        if doc.get("kind") == "Namespace":
            continue
        meta = doc.get("metadata") or {}
        namespace = meta.get("namespace")
        if not isinstance(namespace, str) or not namespace:
            docs.append(doc)
    return docs


def workload_namespaces(text: str, fallback: str) -> list[str]:
    workload_kinds = {"Deployment", "StatefulSet", "DaemonSet", "CronJob", "Job"}
    namespaces = set()
    saw_workload = False
    for doc in yaml_docs(text):
        if doc.get("kind") not in workload_kinds:
            continue
        saw_workload = True
        namespace = (doc.get("metadata") or {}).get("namespace")
        if isinstance(namespace, str) and namespace:
            namespaces.add(namespace)
        else:
            namespaces.add(fallback)
    return sorted(namespaces) if saw_workload else []


def no_workload_runtime(text: str) -> dict:
    kinds = {}
    for doc in yaml_docs(text):
        kind = doc.get("kind")
        if not kind or kind == "Namespace":
            continue
        kinds[kind] = kinds.get(kind, 0) + 1
    return {
        "result": "pass",
        "kind": "no-workload-objects",
        "workloads": "",
        "pods": "",
        "notReady": [],
        "objectKinds": kinds,
        "reason": "rendered object set has no Deployment, StatefulSet, DaemonSet, Job, or CronJob to wait for",
    }


def kubectl(args: list[str], kubeconfig: Path, context: str, timeout: int = 120) -> tuple[int, str, str]:
    return sh(["kubectl", "--kubeconfig", str(kubeconfig), "--context", context, *args], timeout=timeout)


def kubectl_must(args: list[str], kubeconfig: Path, context: str, step: str, timeout: int = 120) -> str:
    rc, out, err = kubectl(args, kubeconfig, context, timeout=timeout)
    if rc != 0:
        raise RuntimeError(f"{step} failed: {(err or out)[:800]}")
    return out


def kubeconfig_with_context_namespace(kubeconfig: Path, context: str, namespace: str) -> Path:
    if not yaml:
        return kubeconfig
    try:
        config = load_yaml(kubeconfig)
        matched = False
        for item in config.get("contexts") or []:
            if item.get("name") != context:
                continue
            item.setdefault("context", {})["namespace"] = namespace
            matched = True
            break
        if not matched:
            return kubeconfig
        config["current-context"] = context
        with tempfile.NamedTemporaryFile("w", prefix="helm-expt-argocd-core-", suffix=".kubeconfig", delete=False) as handle:
            yaml.safe_dump(config, handle, sort_keys=False)
            return Path(handle.name)
    except Exception:
        return kubeconfig


def schedulable_node_count(kubeconfig: Path, context: str) -> int:
    out = kubectl_must(
        ["get", "nodes", "-o", "json"],
        kubeconfig,
        context,
        "target topology node inspection",
        timeout=60,
    )
    try:
        payload = json.loads(out)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"target topology node inspection returned invalid JSON: {exc}") from exc
    count = 0
    for item in payload.get("items") or []:
        spec = item.get("spec") or {}
        if spec.get("unschedulable") is True:
            continue
        taints = spec.get("taints") or []
        if any(taint.get("effect") in ("NoSchedule", "NoExecute") for taint in taints):
            continue
        count += 1
    return count


def argo_application_status(kubeconfig: Path, context: str, app: str, run_root: Path | None = None, label: str | None = None) -> dict:
    rc, out, err = kubectl(
        ["get", "application", app, "-n", "argocd", "-o", "json"],
        kubeconfig,
        context,
        timeout=60,
    )
    if rc != 0:
        return {"result": "unavailable", "error": (err or out)[:1000]}
    try:
        payload = json.loads(out)
    except json.JSONDecodeError as exc:
        return {"result": "unparseable", "error": str(exc)}
    status = payload.get("status") or {}
    resources = []
    for item in status.get("resources") or []:
        health = item.get("health") or {}
        resources.append({
            "group": item.get("group", ""),
            "kind": item.get("kind", ""),
            "namespace": item.get("namespace", ""),
            "name": item.get("name", ""),
            "status": item.get("status", ""),
            "health": health.get("status", ""),
            "healthMessage": health.get("message", ""),
            "hook": item.get("hook", False),
        })
    rc_describe, describe_out, describe_err = kubectl(
        ["describe", "application", app, "-n", "argocd"],
        kubeconfig,
        context,
        timeout=60,
    )
    rc_events, events_out, events_err = kubectl(
        [
            "get", "events", "-n", "argocd",
            "--field-selector", f"involvedObject.kind=Application,involvedObject.name={app}",
            "--sort-by=.lastTimestamp",
        ],
        kubeconfig,
        context,
        timeout=60,
    )
    argocd_core = argocd_core_status(kubeconfig, context, app, run_root, label)
    cub_scout = cub_scout_gitops_status(kubeconfig)
    operation_state = status.get("operationState") or {}
    operation = operation_state.get("operation") or {}
    operation_sync = operation.get("sync") or {}
    sync_result = operation_state.get("syncResult") or {}
    operation_sync_resources = argo_resource_refs(operation_sync.get("resources") or [])
    sync_result_resources = argo_sync_result_resources(sync_result.get("resources") or [])
    health_residue = [
        {
            "group": item["group"],
            "kind": item["kind"],
            "namespace": item["namespace"],
            "name": item["name"],
            "status": item["status"],
            "health": item["health"],
            "healthMessage": item["healthMessage"],
        }
        for item in resources
        if item.get("health") and item.get("health") != "Healthy"
    ]
    return {
        "result": "recorded",
        "sync": status.get("sync") or {},
        "health": status.get("health") or {},
        "summary": status.get("summary") or {},
        "operationState": {
            "phase": operation_state.get("phase", ""),
            "message": operation_state.get("message", ""),
            "startedAt": operation_state.get("startedAt", ""),
            "finishedAt": operation_state.get("finishedAt", ""),
            "operationSyncResourceCount": len(operation_sync_resources),
            "operationSyncResources": operation_sync_resources[:20],
            "syncResultResourceCount": len(sync_result_resources),
            "syncResultStatusCounts": count_by(sync_result_resources, lambda item: item.get("status") or "blank"),
        },
        "history": argo_history(status.get("history") or []),
        "conditions": status.get("conditions") or [],
        "resources": resources,
        "diagnostics": {
            "healthResidue": health_residue,
            "describe": {
                "result": "pass" if rc_describe == 0 else "blocked",
                "output": (describe_out or describe_err)[:6000],
            },
            "events": {
                "result": "pass" if rc_events == 0 else "blocked",
                "output": (events_out or events_err)[:3000],
            },
            "argocdCore": argocd_core,
            "cubScoutGitOpsStatus": cub_scout,
        },
    }


