#!/usr/bin/env python3
"""Run one live Helm-vs-ConfigHub parity test.

The test owns one cub-lk rig and writes a LiveHelmConfigHubParityReceipt. It
checks three delivery legs for the same chart/base:

  1. regular Helm install
  2. cub installer render followed by kubectl apply
  3. cub installer upload followed by ConfigHub OCI -> Argo CD

The runner is intentionally conservative. A receipt can pass, watch, or block.
Non-pass receipts are useful evidence when the chart needs CRDs, secrets,
storage, hooks, or target capabilities before the selected base is live-ready.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

try:
    import yaml
except ImportError:  # pragma: no cover
    yaml = None

if yaml:
    # Some Kubernetes manifests contain unquoted "=" list items. PyYAML resolves
    # those as YAML 1.1 "value" tags, but for Kubernetes they are plain strings.
    yaml.SafeLoader.add_constructor(
        "tag:yaml.org,2002:value",
        lambda loader, node: loader.construct_scalar(node),
    )

TARGET_PROFILE_PROCESSES: list[subprocess.Popen] = []


def sh(cmd: list[str], timeout: int = 120, env: dict[str, str] | None = None) -> tuple[int, str, str]:
    try:
        proc = subprocess.run(cmd, text=True, capture_output=True, timeout=timeout, env=env)
        return proc.returncode, proc.stdout.strip(), proc.stderr.strip()
    except subprocess.TimeoutExpired:
        return 124, "", f"timeout after {timeout}s"


def helm_chart_command_args(chart: str, repo_url: str) -> list[str]:
    chart_name = chart.split("/", 1)[1] if "/" in chart else chart
    if repo_url.startswith("oci://"):
        repo = repo_url.rstrip("/")
        chart_ref = repo if repo.rsplit("/", 1)[-1] == chart_name else f"{repo}/{chart_name}"
        return [chart_ref]
    return [chart_name, "--repo", repo_url]


def kind_clusters() -> list[str]:
    rc, clusters, _ = sh(["kind", "get", "clusters"], timeout=60)
    if rc != 0:
        return []
    return [line.strip() for line in clusters.splitlines() if line.strip()]


def prune_parity_leaks() -> None:
    # The rig runner is serial, so before bringing a cluster up there should be no
    # other helm-expt-parity-* cluster. Remove any left over from a prior failed
    # teardown so leaked clusters and containers cannot starve kind create / the
    # bootstrap controller and cascade into "blocked" rows.
    rc, clusters, _ = sh(["kind", "get", "clusters"], timeout=60)
    if rc == 0:
        for name in clusters.splitlines():
            name = name.strip()
            if name.startswith("helm-expt-parity-"):
                sh(["kind", "delete", "cluster", "--name", name], timeout=180)
    rc, ids, _ = sh(["docker", "ps", "-aq", "--filter", "name=helm-expt-parity-"], timeout=60)
    if rc == 0 and ids.strip():
        sh(["docker", "rm", "-f", *ids.split()], timeout=120)


def process_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def live_parity_lock_path() -> Path:
    override = os.environ.get("HELM_EXPT_LIVE_PARITY_LOCK")
    if override:
        return Path(override).expanduser()
    return Path.home() / ".confighub" / "locks" / "helm-expt-live-parity.lock"


def acquire_live_parity_lock(timeout_seconds: int) -> Path:
    lock_path = live_parity_lock_path()
    owner_path = lock_path / "owner.json"
    deadline = time.monotonic() + timeout_seconds
    while True:
        try:
            lock_path.parent.mkdir(parents=True, exist_ok=True)
            lock_path.mkdir()
            owner_path.write_text(json.dumps({
                "pid": os.getpid(),
                "startedAt": datetime.now(timezone.utc).replace(microsecond=0).isoformat(),
                "command": " ".join(sys.argv),
            }, indent=2) + "\n")
            return lock_path
        except FileExistsError:
            owner = {}
            try:
                owner = json.loads(owner_path.read_text())
            except Exception:
                pass
            pid = owner.get("pid")
            if isinstance(pid, int) and not process_alive(pid):
                shutil.rmtree(lock_path, ignore_errors=True)
                continue
            if time.monotonic() >= deadline:
                detail = f"live parity lane locked at {lock_path}"
                if pid:
                    detail += f" by pid {pid}"
                raise RuntimeError(detail)
            time.sleep(10)


def release_live_parity_lock(lock_path: Path | None) -> None:
    if not lock_path:
        return
    owner_path = lock_path / "owner.json"
    try:
        owner = json.loads(owner_path.read_text())
    except Exception:
        owner = {}
    if owner.get("pid") == os.getpid():
        shutil.rmtree(lock_path, ignore_errors=True)


def teardown_rig(rig: str) -> tuple[bool, str]:
    # Authoritative teardown: cub lk down --force, then an unconditional kind/docker
    # fallback so a stuck control-plane container cannot leak. Reports clean only if
    # the cluster is actually gone afterward.
    rc, out, err = sh(["cub", "lk", "down", "--name", rig, "--force"], timeout=600)
    detail = (err or out)[:1000]
    sh(["kind", "delete", "cluster", "--name", rig], timeout=180)
    sh(["docker", "rm", "-f", f"{rig}-control-plane"], timeout=120)
    rc_check, clusters, _ = sh(["kind", "get", "clusters"], timeout=60)
    gone = rc_check == 0 and rig not in clusters.split()
    return (rc == 0 or gone), detail


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def write_text(path: Path, text: str) -> str:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    return hashlib.sha256(path.read_bytes()).hexdigest()


def write_yaml(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if yaml:
        path.write_text(yaml.safe_dump(data, sort_keys=False, default_flow_style=False))
    else:
        path.write_text(json.dumps(data, indent=2) + "\n")


def load_yaml(path: Path) -> dict:
    if not yaml:
        raise RuntimeError("PyYAML is required for live parity tests")
    return yaml.safe_load(path.read_text()) or {}


def raw_values_file(source: Path, destination: Path) -> Path:
    data = load_yaml(source)
    if data.get("kind") == "EffectiveValues":
        values = data.get("spec", {}).get("values")
        if not isinstance(values, dict):
            raise RuntimeError(
                f"{source} is an EffectiveValues wrapper but has no spec.values map; "
                "live parity requires raw Helm values that can be replayed with helm"
            )
        write_yaml(destination, values)
        return destination
    shutil.copyfile(source, destination)
    return destination


def yaml_docs(text: str) -> list[dict]:
    if not yaml:
        raise RuntimeError("PyYAML is required for live parity tests")
    return [doc for doc in yaml.safe_load_all(text) if isinstance(doc, dict)]


def object_identity(doc: dict) -> str:
    meta = doc.get("metadata") or {}
    return "|".join([
        str(doc.get("apiVersion") or ""),
        str(doc.get("kind") or ""),
        str(meta.get("namespace") or ""),
        str(meta.get("name") or ""),
    ])


def prune(value):
    if isinstance(value, dict):
        return {key: prune(item) for key, item in value.items() if item is not None}
    if isinstance(value, list):
        return [prune(item) for item in value]
    return value


def normalize_namespace_references(value, namespace_map: dict[str, str]):
    if isinstance(value, dict):
        return {key: normalize_namespace_references(item, namespace_map) for key, item in value.items()}
    if isinstance(value, list):
        return [normalize_namespace_references(item, namespace_map) for item in value]
    if isinstance(value, str):
        normalized = namespace_map.get(value, value)
        for source, target in namespace_map.items():
            normalized = normalized.replace(f".{source}.svc", f".{target}.svc")
            normalized = normalized.replace(f".{source}\"", f".{target}\"")
            normalized = normalized.replace(f"={source}", f"={target}")
            normalized = normalized.replace(f'="{source}"', f'="{target}"')
            normalized = normalized.replace(f'"{source}"', f'"{target}"')
        return normalized
    return value


def trim_command_block_leading_newline(value, key: str | None = None):
    if isinstance(value, dict):
        return {item_key: trim_command_block_leading_newline(item, item_key) for item_key, item in value.items()}
    if isinstance(value, list):
        return [trim_command_block_leading_newline(item, key) for item in value]
    if key in {"args", "command"} and isinstance(value, str) and value.startswith("\n"):
        return value[1:]
    return value


def normalize_json_configmap_data(doc: dict):
    if doc.get("kind") != "ConfigMap":
        return
    data = doc.get("data")
    if not isinstance(data, dict):
        return
    for key, value in list(data.items()):
        if not key.endswith(".json") or not isinstance(value, str):
            continue
        try:
            parsed = json.loads(value)
        except json.JSONDecodeError:
            continue
        data[key] = json.dumps(parsed, sort_keys=True, separators=(",", ":"), ensure_ascii=True)


def apply_k8s_zero_defaults(doc: dict) -> list[str]:
    changes = []

    def pop_if_equal(obj: dict, key: str, expected, path: str) -> None:
        if isinstance(obj, dict) and obj.get(key) == expected:
            obj.pop(key, None)
            changes.append(path)

    def pop_if_empty(obj: dict, key: str, path: str) -> None:
        if isinstance(obj, dict) and obj.get(key) in (None, [], {}):
            obj.pop(key, None)
            changes.append(path)

    if doc.get("apiVersion") == "apiregistration.k8s.io/v1" and doc.get("kind") == "APIService":
        spec = doc.get("spec") or {}
        pop_if_equal(spec, "insecureSkipTLSVerify", False, "spec.insecureSkipTLSVerify=false")

    if doc.get("apiVersion") != "apps/v1" or doc.get("kind") != "StatefulSet":
        return changes

    spec = doc.get("spec") or {}
    pop_if_equal(spec, "minReadySeconds", 0, "spec.minReadySeconds=0")
    pop_if_equal(spec, "persistentVolumeClaimRetentionPolicy", {"whenDeleted": "Retain", "whenScaled": "Retain"}, "spec.persistentVolumeClaimRetentionPolicy=Retain/Retain")
    pop_if_equal(spec, "podManagementPolicy", "OrderedReady", "spec.podManagementPolicy=OrderedReady")
    pop_if_equal(spec, "revisionHistoryLimit", 10, "spec.revisionHistoryLimit=10")
    pop_if_equal(spec, "updateStrategy", {"type": "RollingUpdate"}, "spec.updateStrategy.type=RollingUpdate")
    pop_if_equal(spec, "updateStrategy", {"rollingUpdate": {"maxUnavailable": 1, "partition": 0}, "type": "RollingUpdate"}, "spec.updateStrategy RollingUpdate defaults")

    pod_spec = (((spec.get("template") or {}).get("spec")) or {})
    pop_if_equal(pod_spec, "restartPolicy", "Always", "spec.template.spec.restartPolicy=Always")
    pop_if_equal(pod_spec, "dnsPolicy", "ClusterFirst", "spec.template.spec.dnsPolicy=ClusterFirst")
    pop_if_equal(pod_spec, "schedulerName", "default-scheduler", "spec.template.spec.schedulerName=default-scheduler")
    pop_if_equal(pod_spec, "terminationGracePeriodSeconds", 30, "spec.template.spec.terminationGracePeriodSeconds=30")
    if pod_spec.get("serviceAccount") and pod_spec.get("serviceAccount") == pod_spec.get("serviceAccountName"):
        pod_spec.pop("serviceAccount", None)
        changes.append("spec.template.spec.serviceAccount=serviceAccountName")

    security_context = pod_spec.get("securityContext") or {}
    pop_if_empty(security_context, "supplementalGroups", "spec.template.spec.securityContext.supplementalGroups empty")
    pop_if_empty(security_context, "sysctls", "spec.template.spec.securityContext.sysctls empty")
    affinity = pod_spec.get("affinity") or {}
    pop_if_empty(affinity, "nodeAffinity", "spec.template.spec.affinity.nodeAffinity empty")
    pop_if_empty(affinity, "podAffinity", "spec.template.spec.affinity.podAffinity empty")

    for container_field in ("containers", "initContainers"):
        for container in pod_spec.get(container_field) or []:
            name = container.get("name", "?")
            pop_if_empty(container, "envFrom", f"spec.template.spec.{container_field}[{name}].envFrom empty")
            pop_if_equal(container, "resources", {}, f"spec.template.spec.{container_field}[{name}].resources empty")
            pop_if_equal(container, "terminationMessagePath", "/dev/termination-log", f"spec.template.spec.{container_field}[{name}].terminationMessagePath default")
            pop_if_equal(container, "terminationMessagePolicy", "File", f"spec.template.spec.{container_field}[{name}].terminationMessagePolicy default")
            for port in container.get("ports") or []:
                port_name = port.get("name") or port.get("containerPort") or "?"
                pop_if_equal(port, "protocol", "TCP", f"spec.template.spec.{container_field}[{name}].ports[{port_name}].protocol=TCP")
            for env in container.get("env") or []:
                env_name = env.get("name", "?")
                field_ref = (((env.get("valueFrom") or {}).get("fieldRef") or {}))
                pop_if_equal(field_ref, "apiVersion", "v1", f"spec.template.spec.{container_field}[{name}].env[{env_name}].fieldRef.apiVersion=v1")
            for probe_field in ("livenessProbe", "readinessProbe", "startupProbe"):
                probe = container.get(probe_field)
                if not isinstance(probe, dict):
                    continue
                pop_if_equal(probe, "failureThreshold", 3, f"spec.template.spec.{container_field}[{name}].{probe_field}.failureThreshold=3")
                pop_if_equal(probe, "periodSeconds", 10, f"spec.template.spec.{container_field}[{name}].{probe_field}.periodSeconds=10")
                pop_if_equal(probe, "successThreshold", 1, f"spec.template.spec.{container_field}[{name}].{probe_field}.successThreshold=1")
                pop_if_equal(probe, "timeoutSeconds", 1, f"spec.template.spec.{container_field}[{name}].{probe_field}.timeoutSeconds=1")
                http_get = probe.get("httpGet")
                if isinstance(http_get, dict):
                    pop_if_equal(http_get, "scheme", "HTTP", f"spec.template.spec.{container_field}[{name}].{probe_field}.httpGet.scheme=HTTP")

    for volume in pod_spec.get("volumes") or []:
        name = volume.get("name", "?")
        if isinstance(volume.get("configMap"), dict):
            pop_if_equal(volume["configMap"], "defaultMode", 420, f"spec.template.spec.volumes[{name}].configMap.defaultMode=420")
        if isinstance(volume.get("secret"), dict):
            pop_if_equal(volume["secret"], "defaultMode", 420, f"spec.template.spec.volumes[{name}].secret.defaultMode=420")

    for claim in spec.get("volumeClaimTemplates") or []:
        name = (claim.get("metadata") or {}).get("name", "?")
        pop_if_equal(claim, "apiVersion", "v1", f"spec.volumeClaimTemplates[{name}].apiVersion=v1")
        pop_if_equal(claim, "kind", "PersistentVolumeClaim", f"spec.volumeClaimTemplates[{name}].kind=PersistentVolumeClaim")
        pop_if_empty(claim, "status", f"spec.volumeClaimTemplates[{name}].status empty")
        pop_if_equal(claim, "status", {"phase": "Pending"}, f"spec.volumeClaimTemplates[{name}].status.phase=Pending")
        claim_spec = claim.get("spec") or {}
        pop_if_equal(claim_spec, "volumeMode", "Filesystem", f"spec.volumeClaimTemplates[{name}].spec.volumeMode=Filesystem")

    return changes


def materialize_statefulset_gitops_defaults(doc: dict) -> list[str]:
    changes = []
    if doc.get("apiVersion") != "apps/v1" or doc.get("kind") != "StatefulSet":
        return changes

    def set_default(obj: dict, key: str, value, path: str) -> None:
        if isinstance(obj, dict) and key not in obj:
            obj[key] = value
            changes.append(f"materialized {path}")

    def drop_zero(obj: dict, key: str, value, path: str) -> None:
        if isinstance(obj, dict) and obj.get(key) == value:
            obj.pop(key, None)
            changes.append(f"removed {path}")

    spec = doc.get("spec") or {}
    drop_zero(spec, "minReadySeconds", 0, "spec.minReadySeconds=0")
    set_default(spec, "persistentVolumeClaimRetentionPolicy", {"whenDeleted": "Retain", "whenScaled": "Retain"}, "spec.persistentVolumeClaimRetentionPolicy=Retain/Retain")
    set_default(spec, "podManagementPolicy", "OrderedReady", "spec.podManagementPolicy=OrderedReady")
    set_default(spec, "revisionHistoryLimit", 10, "spec.revisionHistoryLimit=10")
    set_default(spec, "updateStrategy", {"rollingUpdate": {"maxUnavailable": 1, "partition": 0}, "type": "RollingUpdate"}, "spec.updateStrategy RollingUpdate defaults")

    pod_spec = (((spec.get("template") or {}).get("spec")) or {})
    set_default(pod_spec, "restartPolicy", "Always", "spec.template.spec.restartPolicy=Always")
    set_default(pod_spec, "dnsPolicy", "ClusterFirst", "spec.template.spec.dnsPolicy=ClusterFirst")
    set_default(pod_spec, "schedulerName", "default-scheduler", "spec.template.spec.schedulerName=default-scheduler")
    set_default(pod_spec, "terminationGracePeriodSeconds", 30, "spec.template.spec.terminationGracePeriodSeconds=30")
    if pod_spec.get("serviceAccountName") and "serviceAccount" not in pod_spec:
        pod_spec["serviceAccount"] = pod_spec["serviceAccountName"]
        changes.append("spec.template.spec.serviceAccount=serviceAccountName")

    for container_field in ("containers", "initContainers"):
        for container in pod_spec.get(container_field) or []:
            name = container.get("name", "?")
            set_default(container, "resources", {}, f"spec.template.spec.{container_field}[{name}].resources empty")
            set_default(container, "terminationMessagePath", "/dev/termination-log", f"spec.template.spec.{container_field}[{name}].terminationMessagePath default")
            set_default(container, "terminationMessagePolicy", "File", f"spec.template.spec.{container_field}[{name}].terminationMessagePolicy default")
            for port in container.get("ports") or []:
                port_name = port.get("name") or port.get("containerPort") or "?"
                set_default(port, "protocol", "TCP", f"spec.template.spec.{container_field}[{name}].ports[{port_name}].protocol=TCP")
            for env in container.get("env") or []:
                env_name = env.get("name", "?")
                field_ref = (((env.get("valueFrom") or {}).get("fieldRef") or {}))
                set_default(field_ref, "apiVersion", "v1", f"spec.template.spec.{container_field}[{name}].env[{env_name}].fieldRef.apiVersion=v1")
            for probe_field in ("livenessProbe", "readinessProbe", "startupProbe"):
                probe = container.get(probe_field)
                if not isinstance(probe, dict):
                    continue
                set_default(probe, "failureThreshold", 3, f"spec.template.spec.{container_field}[{name}].{probe_field}.failureThreshold=3")
                set_default(probe, "periodSeconds", 10, f"spec.template.spec.{container_field}[{name}].{probe_field}.periodSeconds=10")
                set_default(probe, "successThreshold", 1, f"spec.template.spec.{container_field}[{name}].{probe_field}.successThreshold=1")
                set_default(probe, "timeoutSeconds", 1, f"spec.template.spec.{container_field}[{name}].{probe_field}.timeoutSeconds=1")
                http_get = probe.get("httpGet")
                if isinstance(http_get, dict):
                    set_default(http_get, "scheme", "HTTP", f"spec.template.spec.{container_field}[{name}].{probe_field}.httpGet.scheme=HTTP")

    for volume in pod_spec.get("volumes") or []:
        name = volume.get("name", "?")
        if isinstance(volume.get("configMap"), dict):
            set_default(volume["configMap"], "defaultMode", 420, f"spec.template.spec.volumes[{name}].configMap.defaultMode=420")
        if isinstance(volume.get("secret"), dict):
            set_default(volume["secret"], "defaultMode", 420, f"spec.template.spec.volumes[{name}].secret.defaultMode=420")

    for claim in spec.get("volumeClaimTemplates") or []:
        name = (claim.get("metadata") or {}).get("name", "?")
        set_default(claim, "apiVersion", "v1", f"spec.volumeClaimTemplates[{name}].apiVersion=v1")
        set_default(claim, "kind", "PersistentVolumeClaim", f"spec.volumeClaimTemplates[{name}].kind=PersistentVolumeClaim")
        set_default(claim, "status", {"phase": "Pending"}, f"spec.volumeClaimTemplates[{name}].status.phase=Pending")
        claim_spec = claim.get("spec") or {}
        set_default(claim_spec, "volumeMode", "Filesystem", f"spec.volumeClaimTemplates[{name}].spec.volumeMode=Filesystem")

    return changes


def apply_semantic_normalizations(doc: dict, semantic_normalizations: list[str]) -> dict:
    if "k8s-zero-defaults" in semantic_normalizations:
        apply_k8s_zero_defaults(doc)
    identity = object_identity(doc)
    if (
        "loki-configmap-leading-blank-line-pruned-by-kustomize" in semantic_normalizations
        and identity == "v1|ConfigMap|loki|loki"
    ):
        config = doc.get("data", {}).get("config.yaml")
        if isinstance(config, str) and config.startswith("\n"):
            doc["data"]["config.yaml"] = config[1:]
    if "trim-leading-command-block-newline" in semantic_normalizations:
        doc = trim_command_block_leading_newline(doc)
    if (
        "consul-namespace-reference-normalization" in semantic_normalizations
        and doc.get("kind") == "RoleBinding"
    ):
        namespace = (doc.get("metadata") or {}).get("namespace")
        if namespace:
            for subject in doc.get("subjects") or []:
                if subject.get("kind") == "ServiceAccount" and subject.get("namespace") == namespace:
                    subject.pop("namespace", None)
    if "consul-namespace-reference-normalization" in semantic_normalizations:
        normalize_json_configmap_data(doc)
    if "mysql-statefulset-gitops-defaults" in semantic_normalizations and identity == "apps/v1|StatefulSet|mysql|mysql":
        spec = doc.get("spec") or {}
        spec.pop("podManagementPolicy", None)
        spec.pop("persistentVolumeClaimRetentionPolicy", None)
        spec.pop("revisionHistoryLimit", None)
        pod_spec = (((spec.get("template") or {}).get("spec")) or {})
        pod_spec.pop("dnsPolicy", None)
        pod_spec.pop("restartPolicy", None)
        pod_spec.pop("schedulerName", None)
        pod_spec.pop("serviceAccount", None)
        pod_spec.pop("terminationGracePeriodSeconds", None)
        for container in pod_spec.get("containers") or []:
            container.pop("envFrom", None)
            container.pop("terminationMessagePath", None)
            container.pop("terminationMessagePolicy", None)
            for port in container.get("ports") or []:
                port.pop("protocol", None)
        for container in pod_spec.get("initContainers") or []:
            container.pop("terminationMessagePath", None)
            container.pop("terminationMessagePolicy", None)
        for volume in pod_spec.get("volumes") or []:
            if isinstance(volume.get("configMap"), dict):
                volume["configMap"].pop("defaultMode", None)
            if isinstance(volume.get("secret"), dict):
                volume["secret"].pop("defaultMode", None)
        security_context = pod_spec.get("securityContext") or {}
        security_context.pop("supplementalGroups", None)
        security_context.pop("sysctls", None)
        affinity = pod_spec.get("affinity") or {}
        affinity.pop("nodeAffinity", None)
        affinity.pop("podAffinity", None)
        for claim in spec.get("volumeClaimTemplates") or []:
            claim.pop("apiVersion", None)
            claim.pop("kind", None)
            claim_spec = claim.get("spec") or {}
            claim_spec.pop("volumeMode", None)
    if (
        "consul-statefulset-gitops-defaults" in semantic_normalizations
        and identity == "apps/v1|StatefulSet|consul|consul-consul-server"
    ):
        spec = doc.get("spec") or {}
        spec.pop("persistentVolumeClaimRetentionPolicy", None)
        spec.pop("revisionHistoryLimit", None)
        spec.pop("updateStrategy", None)
        pod_spec = (((spec.get("template") or {}).get("spec")) or {})
        pod_spec.pop("dnsPolicy", None)
        pod_spec.pop("restartPolicy", None)
        pod_spec.pop("schedulerName", None)
        pod_spec.pop("serviceAccount", None)
        for container in pod_spec.get("containers") or []:
            container.pop("imagePullPolicy", None)
            container.pop("terminationMessagePath", None)
            container.pop("terminationMessagePolicy", None)
            for env in container.get("env") or []:
                (((env.get("valueFrom") or {}).get("fieldRef") or {})).pop("apiVersion", None)
            for port in container.get("ports") or []:
                port.pop("protocol", None)
            for mount in container.get("volumeMounts") or []:
                if mount.get("readOnly") is False:
                    mount.pop("readOnly", None)
        for container in pod_spec.get("initContainers") or []:
            container.pop("imagePullPolicy", None)
            if container.get("resources") == {}:
                container.pop("resources", None)
            container.pop("terminationMessagePath", None)
            container.pop("terminationMessagePolicy", None)
            for env in container.get("env") or []:
                (((env.get("valueFrom") or {}).get("fieldRef") or {})).pop("apiVersion", None)
        for volume in pod_spec.get("volumes") or []:
            if isinstance(volume.get("configMap"), dict):
                volume["configMap"].pop("defaultMode", None)
        for claim in spec.get("volumeClaimTemplates") or []:
            claim.pop("apiVersion", None)
            claim.pop("kind", None)
            claim.pop("status", None)
            claim_spec = claim.get("spec") or {}
            claim_spec.pop("volumeMode", None)
    return doc


def object_map(
    text: str,
    namespace_map: dict[str, str] | None = None,
    semantic_normalizations: list[str] | None = None,
) -> dict[str, str]:
    namespace_map = namespace_map or {}
    semantic_normalizations = semantic_normalizations or []
    result = {}
    for doc in yaml_docs(text):
        meta = doc.get("metadata")
        if not isinstance(meta, dict):
            continue
        if not doc.get("apiVersion") or not doc.get("kind") or not meta.get("name"):
            continue
        doc = normalize_namespace_references(prune(doc), namespace_map)
        if doc.get("kind") == "Namespace":
            name = doc.get("metadata", {}).get("name")
            if name in namespace_map:
                doc["metadata"]["name"] = namespace_map[name]
        meta = doc.get("metadata") or {}
        for optional_map in ("annotations", "labels"):
            if meta.get(optional_map) == {}:
                meta.pop(optional_map, None)
        doc = apply_semantic_normalizations(doc, semantic_normalizations)
        result[object_identity(doc)] = json.dumps(doc, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    return result


def collect_yaml(root: Path) -> str:
    docs = []
    if not root.exists():
        return ""
    for path in sorted(root.glob("*.yaml")):
        text = path.read_text()
        if text.strip():
            docs.append(text.rstrip())
    return "\n---\n".join(docs) + ("\n" if docs else "")


def combine_yaml_parts(*parts: str) -> str:
    docs = [part.strip() for part in parts if part.strip()]
    return "\n---\n".join(docs) + ("\n" if docs else "")


def helm_wait_timeout(output: str) -> bool:
    lowered = output.lower()
    return (
        "context deadline exceeded" in lowered
        and ("not ready" in lowered or "status: inprogress" in lowered)
    )


def render_docs_to_yaml(docs: list[dict]) -> str:
    if not docs:
        return ""
    if yaml:
        return "\n---\n".join(yaml.safe_dump(doc, sort_keys=False).strip() for doc in docs) + "\n"
    return "\n---\n".join(json.dumps(doc, indent=2) for doc in docs) + "\n"


def namespace_secret_for_destination(secret_path: Path, destination_namespace: str, out_dir: Path) -> Path:
    docs = yaml_docs(secret_path.read_text())
    changed = False
    for doc in docs:
        if doc.get("kind") != "Secret":
            continue
        metadata = doc.setdefault("metadata", {})
        if not metadata.get("namespace"):
            metadata["namespace"] = destination_namespace
            changed = True
    if not changed:
        return secret_path
    out_dir.mkdir(parents=True, exist_ok=True)
    staged_path = out_dir / secret_path.name
    write_text(staged_path, render_docs_to_yaml(docs))
    return staged_path


def docs_matching(text: str, kind: str) -> list[dict]:
    return [doc for doc in yaml_docs(text) if doc.get("kind") == kind]


def manifest_namespaces(text: str) -> list[str]:
    namespaces = set()
    for doc in yaml_docs(text):
        meta = doc.get("metadata") or {}
        namespace = meta.get("namespace")
        if isinstance(namespace, str) and namespace:
            namespaces.add(namespace)
        if doc.get("kind") == "Namespace":
            name = meta.get("name")
            if isinstance(name, str) and name:
                namespaces.add(name)
    return sorted(namespaces)


def namespaced_cleanup_docs(text: str, namespaces: set[str]) -> list[dict]:
    docs = []
    for doc in yaml_docs(text):
        if doc.get("kind") == "Namespace":
            continue
        meta = doc.get("metadata") or {}
        namespace = meta.get("namespace")
        if isinstance(namespace, str) and namespace in namespaces:
            docs.append(doc)
    return docs


def cluster_scoped_cleanup_docs(text: str) -> list[dict]:
    docs = []
    for doc in yaml_docs(text):
        if doc.get("kind") == "Namespace":
            continue
        meta = doc.get("metadata") or {}
        namespace = meta.get("namespace")
        if not isinstance(namespace, str) or not namespace:
            docs.append(doc)
    return docs


def workload_namespaces(text: str, fallback: str) -> list[str]:
    workload_kinds = {"Deployment", "StatefulSet", "DaemonSet"}
    namespaces = set()
    for doc in yaml_docs(text):
        if doc.get("kind") not in workload_kinds:
            continue
        namespace = (doc.get("metadata") or {}).get("namespace")
        if isinstance(namespace, str) and namespace:
            namespaces.add(namespace)
    return sorted(namespaces) or [fallback]


def kubectl(args: list[str], kubeconfig: Path, context: str, timeout: int = 120) -> tuple[int, str, str]:
    return sh(["kubectl", "--kubeconfig", str(kubeconfig), "--context", context, *args], timeout=timeout)


def kubectl_must(args: list[str], kubeconfig: Path, context: str, step: str, timeout: int = 120) -> str:
    rc, out, err = kubectl(args, kubeconfig, context, timeout=timeout)
    if rc != 0:
        raise RuntimeError(f"{step} failed: {(err or out)[:800]}")
    return out


def argo_application_status(kubeconfig: Path, context: str, app: str) -> dict:
    rc, out, err = kubectl(
        ["get", "application", app, "-n", "argocd", "-o", "json"],
        kubeconfig,
        context,
        timeout=60,
    )
    if rc != 0:
        return {"result": "unavailable", "error": (err or out)[:1000]}
    try:
        payload = json.loads(out)
    except json.JSONDecodeError as exc:
        return {"result": "unparseable", "error": str(exc)}
    status = payload.get("status") or {}
    resources = []
    for item in status.get("resources") or []:
        resources.append({
            "group": item.get("group", ""),
            "kind": item.get("kind", ""),
            "namespace": item.get("namespace", ""),
            "name": item.get("name", ""),
            "status": item.get("status", ""),
            "health": (item.get("health") or {}).get("status", ""),
            "hook": item.get("hook", False),
        })
    return {
        "result": "recorded",
        "sync": status.get("sync") or {},
        "health": status.get("health") or {},
        "operationState": {
            "phase": (status.get("operationState") or {}).get("phase", ""),
            "message": (status.get("operationState") or {}).get("message", ""),
        },
        "conditions": status.get("conditions") or [],
        "resources": resources,
    }


def ensure_tls_material(run_root: Path) -> tuple[str, str]:
    cert = run_root / "target-facts-tls.crt"
    key = run_root / "target-facts-tls.key"
    if not cert.exists() or not key.exists():
        rc, out, err = sh([
            "openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes",
            "-keyout", str(key), "-out", str(cert), "-subj", "/CN=helm-expt.local",
            "-days", "1",
        ], timeout=60)
        if rc != 0:
            raise RuntimeError(f"target fact TLS material generation failed: {(err or out)[:1000]}")
    return cert.read_text(), key.read_text()


def target_fact_value(secret_name: str, key: str, run_root: Path) -> str:
    secret_looks_like_tls = (
        "admission" in secret_name
        or "webhook" in secret_name
        or "tls" in secret_name
    )
    if key in ("ca", "cert", "tls.crt", "ca.crt") and secret_looks_like_tls:
        return ensure_tls_material(run_root)[0]
    if key in ("key", "tls.key") and secret_looks_like_tls:
        return ensure_tls_material(run_root)[1]
    if key in ("tls.crt", "ca.crt"):
        return ensure_tls_material(run_root)[0]
    if key == "tls.key":
        return ensure_tls_material(run_root)[1]
    if key == "admin-user":
        return "admin"
    if key == "key" and "gossip" in secret_name:
        return "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
    if key == "mongodb-replica-set-key":
        return "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
    if key in ("access_key", "access-key"):
        return "helm-expt-access-key"
    if key in ("secret_key", "secret-key"):
        return "helm-expt-secret-key"
    if key == "token":
        return "helm-expt-token"
    if "cookie" in key:
        return "helm-expt-cookie"
    return "helm-expt-password"


def target_fact_applies(item: dict, lane: str) -> bool:
    delivery_lanes = item.get("deliveryLanes") or item.get("stageFor") or []
    if not delivery_lanes:
        return True
    aliases = {
        "regularHelm": {"regularHelm", "helm"},
        "configHubKubectlApply": {"configHubKubectlApply", "cubInstallerApply", "installer", "config-only"},
        "configHubOciArgo": {"configHubOciArgo", "cubInstallerApply", "installer", "config-only"},
    }
    accepted = aliases.get(lane, {lane})
    return any(item in accepted for item in delivery_lanes)


def target_fact_crd_docs(variant: dict, recipe_path: Path, lane: str) -> tuple[list[dict], list[dict]]:
    required = [
        crd
        for crd in (((variant.get("spec") or {}).get("targetFacts") or {}).get("requiredCRDs") or [])
        if target_fact_applies(crd, lane)
    ]
    docs = []
    staged = []
    for crd in required:
        name = crd.get("name")
        if not name:
            raise RuntimeError(f"invalid required CRD target fact: {crd}")
        source_variant = crd.get("sourceVariant") or "default"
        source_path = crd.get("sourcePath")
        if source_path:
            source = (recipe_path / source_path).resolve() if not Path(source_path).is_absolute() else Path(source_path)
        else:
            source = recipe_path / "revisions" / source_variant / "r001" / "rendered" / "release-objects.yaml"
        if not source.exists():
            raise RuntimeError(f"required CRD source not found for {name}: {source}")
        matches = [doc for doc in yaml_docs(source.read_text()) if doc.get("kind") == "CustomResourceDefinition" and (doc.get("metadata") or {}).get("name") == name]
        if not matches:
            raise RuntimeError(f"required CRD {name} not found in {source}")
        docs.append(matches[0])
        staged.append({"name": name, "sourceVariant": source_variant, "lane": lane})
    return docs, staged


def stage_target_facts(
    variant: dict,
    recipe_path: Path,
    kubeconfig: Path,
    context: str,
    fallback_namespace: str,
    run_root: Path,
    label: str,
    lane: str,
    rendered_namespaces: list[str] | None = None,
) -> dict:
    variant_namespace = (variant.get("spec") or {}).get("namespace")
    required_secrets = [
        secret
        for secret in (((variant.get("spec") or {}).get("targetFacts") or {}).get("requiredSecrets") or [])
        if target_fact_applies(secret, lane)
    ]
    crd_docs, staged_crds = target_fact_crd_docs(variant, recipe_path, lane)
    if not required_secrets and not crd_docs:
        return {"result": "pass", "stagedSecrets": [], "stagedCRDs": []}
    secret_docs = []
    namespaces = set()
    staged_secrets = []
    for secret in required_secrets:
        source_namespace = secret.get("namespace")
        if source_namespace and variant_namespace and source_namespace == variant_namespace:
            secret_namespaces = {fallback_namespace}
            for rendered_namespace in rendered_namespaces or []:
                if rendered_namespace == source_namespace:
                    secret_namespaces.add(rendered_namespace)
        else:
            secret_namespaces = {source_namespace or fallback_namespace}
        name = secret.get("name")
        keys = secret.get("keys") or []
        if not name or not keys:
            raise RuntimeError(f"invalid required secret target fact: {secret}")
        for namespace in sorted(secret_namespaces):
            namespaces.add(namespace)
            string_data = {key: target_fact_value(name, key, run_root) for key in keys}
            secret_type = "kubernetes.io/tls" if set(("tls.crt", "tls.key")).issubset(string_data) and len(set(string_data) - set(("tls.crt", "tls.key", "ca.crt"))) == 0 else "Opaque"
            secret_docs.append({
                "apiVersion": "v1",
                "kind": "Secret",
                "metadata": {"name": name, "namespace": namespace},
                "type": secret_type,
                "stringData": string_data,
            })
            staged = {"namespace": namespace, "name": name, "keys": sorted(keys), "lane": lane}
            if source_namespace and source_namespace != namespace:
                staged["sourceNamespace"] = source_namespace
            staged_secrets.append(staged)
    if crd_docs:
        crd_path = run_root / f"target-facts-{label}-crds.yaml"
        write_yaml(crd_path, {"apiVersion": "v1", "kind": "List", "items": crd_docs})
        kubectl_must(["apply", "--server-side", "--force-conflicts", "-f", str(crd_path)], kubeconfig, context, f"target fact CRD apply {label}", timeout=300)
        for crd in staged_crds:
            kubectl(["wait", "--for=condition=Established", f"crd/{crd['name']}", "--timeout=180s"], kubeconfig, context, timeout=210)
    for namespace in sorted(namespaces):
        if protected_namespace(namespace):
            continue
        namespace_yaml = yaml.safe_load(kubectl_must(
            ["create", "namespace", namespace, "--dry-run=client", "-o", "yaml"],
            kubeconfig,
            context,
            f"target fact namespace {namespace}",
        ))
        namespace_path = run_root / f"target-facts-{label}-{namespace}-namespace.yaml"
        write_yaml(namespace_path, namespace_yaml)
        kubectl_must(["apply", "-f", str(namespace_path)], kubeconfig, context, f"target fact namespace apply {namespace}")
    target_facts_path = run_root / f"target-facts-{label}.yaml"
    if secret_docs:
        write_yaml(target_facts_path, {"apiVersion": "v1", "kind": "List", "items": secret_docs})
        kubectl_must(["apply", "-f", str(target_facts_path)], kubeconfig, context, f"target facts apply {label}")
    return {"result": "pass", "stagedSecrets": staged_secrets, "stagedCRDs": staged_crds, "path": str(target_facts_path)}


def delete_namespace_if_safe(namespace: str, kubeconfig: Path, context: str) -> None:
    if namespace in ("default", "kube-system", "kube-public", "kube-node-lease"):
        return
    kubectl(["delete", "namespace", namespace, "--wait=true", "--timeout=180s"], kubeconfig, context, timeout=210)


def install_target_profile(profile: str, kubeconfig: Path, context: str, run_root: Path) -> dict:
    if profile in ("", "none"):
        return {"name": "none", "result": "pass", "resources": []}
    if profile == "kind-loadbalancer":
        return install_kind_loadbalancer_profile(kubeconfig, context, run_root)
    if profile != "kind-ingress-nginx":
        raise RuntimeError(f"unsupported target profile: {profile}")

    # This pinned ingress-nginx kind provider is a target capability, not part of
    # the chart under test. It gives ingressClassName=nginx an actual controller
    # and writes Ingress status.loadBalancer.ingress=localhost on kind.
    manifest_url = "https://raw.githubusercontent.com/kubernetes/ingress-nginx/controller-v1.15.1/deploy/static/provider/kind/deploy.yaml"
    rc, out, err = kubectl(["apply", "-f", manifest_url], kubeconfig, context, timeout=300)
    if rc != 0:
        raise RuntimeError(f"target profile {profile} apply failed: {(err or out)[:1000]}")
    kubectl_must(
        ["-n", "ingress-nginx", "rollout", "status", "deployment/ingress-nginx-controller", "--timeout=300s"],
        kubeconfig,
        context,
        f"target profile {profile} controller ready",
        timeout=330,
    )
    profile_receipt = {
        "name": profile,
        "result": "pass",
        "manifest": manifest_url,
        "resources": [
            "namespace/ingress-nginx",
            "deployment/ingress-nginx-controller",
            "ingressclass/nginx",
            "validatingwebhookconfiguration/ingress-nginx-admission",
        ],
        "observedBehavior": "Ingress objects with ingressClassName=nginx receive status.loadBalancer.ingress on kind.",
    }
    write_yaml(run_root / f"target-profile-{profile}.yaml", {
        "apiVersion": "helm-expt.confighub.com/v1alpha1",
        "kind": "TargetProfileReceipt",
        "spec": profile_receipt,
    })
    return profile_receipt


METALLB_MANIFEST = "https://raw.githubusercontent.com/metallb/metallb/v0.14.9/config/manifests/metallb-native.yaml"


def install_metallb_l2_profile(kubeconfig: Path, context: str, run_root: Path, cpk_detail: str) -> dict:
    rc, out, err = kubectl(["apply", "-f", METALLB_MANIFEST], kubeconfig, context, timeout=180)
    if rc != 0:
        raise RuntimeError(f"target profile kind-loadbalancer metallb install failed: {(err or out)[:1000]}")
    rc, out, err = kubectl(
        ["-n", "metallb-system", "wait", "--for=condition=Available", "deploy/controller", "--timeout=180s"],
        kubeconfig,
        context,
        timeout=200,
    )
    if rc != 0:
        raise RuntimeError(f"target profile kind-loadbalancer metallb controller not ready: {(err or out)[:1000]}")
    kubectl(["-n", "metallb-system", "rollout", "status", "daemonset/speaker", "--timeout=120s"], kubeconfig, context, timeout=140)

    # Address pool from the kind Docker network: take the top /27 of the
    # first IPv4 subnet so pool addresses cannot collide with node IPs.
    import ipaddress
    rc, subnet_out, err = sh(["docker", "network", "inspect", "kind", "-f", "{{range .IPAM.Config}}{{.Subnet}}\n{{end}}"], timeout=30)
    if rc != 0:
        raise RuntimeError(f"target profile kind-loadbalancer could not inspect the kind docker network: {(err or subnet_out)[:500]}")
    subnet = next((line.strip() for line in subnet_out.splitlines() if line.strip() and ":" not in line), "")
    if not subnet:
        raise RuntimeError("target profile kind-loadbalancer found no IPv4 subnet on the kind docker network")
    network = ipaddress.ip_network(subnet)
    hosts = list(network.subnets(new_prefix=27))[-1]
    pool_start, pool_end = str(list(hosts.hosts())[0]), str(list(hosts.hosts())[-1])

    pool_yaml = f"""apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: kind-pool
  namespace: metallb-system
spec:
  addresses:
    - {pool_start}-{pool_end}
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: kind-l2
  namespace: metallb-system
spec:
  ipAddressPools:
    - kind-pool
"""
    # The MetalLB admission webhook can lag behind deployment readiness;
    # retry the pool apply briefly instead of failing on the first webhook
    # connection refusal.
    deadline = time.monotonic() + 90
    last = ""
    while time.monotonic() < deadline:
        proc = subprocess.run(
            ["kubectl", "--kubeconfig", str(kubeconfig), "--context", context, "apply", "-f", "-"],
            input=pool_yaml,
            text=True,
            capture_output=True,
            timeout=60,
        )
        if proc.returncode == 0:
            break
        last = (proc.stderr or proc.stdout or "")[:500]
        time.sleep(5)
    else:
        raise RuntimeError(f"target profile kind-loadbalancer metallb pool apply failed: {last}")

    profile_receipt = {
        "name": "kind-loadbalancer",
        "result": "pass",
        "provider": "metallb-l2",
        "fallbackReason": f"cloud-provider-kind requires host privileges on this machine: {cpk_detail.strip().splitlines()[-1][:200] if cpk_detail.strip() else 'sudo required'}",
        "addressPool": f"{pool_start}-{pool_end}",
        "resources": [
            "namespace/metallb-system",
            "ipaddresspool/kind-pool",
            "l2advertisement/kind-l2",
        ],
        "observedBehavior": (
            "Service.type=LoadBalancer objects receive an in-Docker-network address via MetalLB L2. "
            "Addresses populate status.loadBalancer.ingress (sufficient for parity and controller health); "
            "they are NOT reachable from the macOS host."
        ),
    }
    write_yaml(run_root / "target-profile-kind-loadbalancer.yaml", profile_receipt)
    return profile_receipt


def install_kind_loadbalancer_profile(kubeconfig: Path, context: str, run_root: Path) -> dict:
    # cloud-provider-kind is the upstream-recommended way to make
    # Service.type=LoadBalancer work on kind. It observes all kind clusters on
    # the host, so this profile refuses to run unless the current proof rig is
    # the only kind cluster present.
    binary = shutil.which("cloud-provider-kind")
    if not binary:
        raise RuntimeError("target profile kind-loadbalancer requires cloud-provider-kind on PATH")

    rig = context.removeprefix("kind-")
    clusters = kind_clusters()
    unexpected = [cluster for cluster in clusters if cluster != rig]
    if unexpected:
        # cloud-provider-kind observes every kind cluster on the host, so it
        # cannot run safely next to foreign clusters. MetalLB is scoped to
        # THIS cluster only, so the no-privilege fallback is also the
        # safe-under-concurrency route.
        return install_metallb_l2_profile(
            kubeconfig,
            context,
            run_root,
            f"cloud-provider-kind would observe other kind clusters: {', '.join(unexpected)}",
        )

    node_name = f"{rig}-control-plane"
    label_rc, label_out, label_err = kubectl(
        ["label", "node", node_name, "node.kubernetes.io/exclude-from-external-load-balancers-"],
        kubeconfig,
        context,
        timeout=60,
    )
    if label_rc != 0 and "not labeled" not in (label_err or label_out):
        raise RuntimeError(f"target profile kind-loadbalancer node label update failed: {(label_err or label_out)[:1000]}")

    log_path = run_root / "target-profile-kind-loadbalancer.log"
    log = log_path.open("w")
    proc = subprocess.Popen(
        [binary, "--enable-lb-port-mapping"],
        text=True,
        stdout=log,
        stderr=subprocess.STDOUT,
    )
    TARGET_PROFILE_PROCESSES.append(proc)
    time.sleep(5)
    if proc.poll() is not None:
        log.close()
        detail = ""
        try:
            detail = log_path.read_text()[-2000:]
        except Exception:
            pass
        if "sudo" in detail.lower():
            # cloud-provider-kind needs host privileges on macOS (its host
            # tunnel) in every mode. MetalLB in L2 mode is the no-privilege
            # fallback: it runs entirely as pods and assigns in-Docker-network
            # addresses, which is exactly what the parity and Argo-health
            # checks consume (status.loadBalancer.ingress) - the addresses
            # are not reachable from the macOS host, and the profile receipt
            # says so.
            return install_metallb_l2_profile(kubeconfig, context, run_root, detail)
        raise RuntimeError(f"target profile kind-loadbalancer exited early: {detail}")

    profile_receipt = {
        "name": "kind-loadbalancer",
        "result": "pass",
        "binary": binary,
        "process": {"pid": proc.pid, "log": str(log_path)},
        "resources": [
            f"node/{node_name}",
            "host-process/cloud-provider-kind",
        ],
        "observedBehavior": "Service.type=LoadBalancer objects receive a local external address on kind through cloud-provider-kind.",
    }
    write_yaml(run_root / "target-profile-kind-loadbalancer.yaml", {
        "apiVersion": "helm-expt.confighub.com/v1alpha1",
        "kind": "TargetProfileReceipt",
        "spec": profile_receipt,
    })
    return profile_receipt


def stop_target_profile_processes() -> None:
    while TARGET_PROFILE_PROCESSES:
        proc = TARGET_PROFILE_PROCESSES.pop()
        if proc.poll() is not None:
            continue
        proc.terminate()
        try:
            proc.wait(timeout=15)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait(timeout=15)


def canonicalize_gitops_doc(doc: dict, profile: str) -> tuple[dict, list[str]]:
    changes = []
    if profile != "k8s-zero-defaults":
        return doc, changes

    name = (doc.get("metadata") or {}).get("name", "")
    if doc.get("apiVersion") == "apiregistration.k8s.io/v1" and doc.get("kind") == "APIService":
        for change in apply_k8s_zero_defaults(doc):
            changes.append(f"{doc.get('kind')}/{name}: removed {change}")
    if doc.get("apiVersion") == "apps/v1" and doc.get("kind") == "StatefulSet":
        for change in materialize_statefulset_gitops_defaults(doc):
            changes.append(f"{doc.get('kind')}/{name}: {change}")
    return doc, changes


def canonicalize_gitops_manifest_dir(manifests_dir: Path, profile: str, run_root: Path) -> dict:
    if profile in ("", "none"):
        return {"name": "none", "result": "pass", "changes": []}
    if profile != "k8s-zero-defaults":
        raise RuntimeError(f"unsupported GitOps canonicalization profile: {profile}")

    changes = []
    for path in sorted(manifests_dir.glob("*.yaml")):
        docs = yaml_docs(path.read_text())
        changed_docs = []
        path_changes = []
        for doc in docs:
            changed_doc, doc_changes = canonicalize_gitops_doc(doc, profile)
            changed_docs.append(changed_doc)
            path_changes.extend(doc_changes)
        if path_changes:
            write_text(path, render_docs_to_yaml(changed_docs))
            changes.extend(f"{path.name}: {item}" for item in path_changes)
    receipt = {
        "name": profile,
        "result": "pass",
        "changes": changes,
        "rationale": "Normalize Kubernetes API zero/default fields before publishing the OCI GitOps artifact; semantic parity remains checked against Helm.",
    }
    write_yaml(run_root / f"gitops-canonicalization-{profile}.yaml", {
        "apiVersion": "helm-expt.confighub.com/v1alpha1",
        "kind": "GitOpsCanonicalizationReceipt",
        "spec": receipt,
    })
    return {
        **receipt,
        "receipt": str(run_root / f"gitops-canonicalization-{profile}.yaml"),
    }


def protected_namespace(namespace: str) -> bool:
    return namespace in ("default", "kube-system", "kube-public", "kube-node-lease")


def leg_namespace(namespace: str, suffix: str) -> str:
    return f"{namespace}-{suffix}"


def cleanup_manifest_yaml(text: str) -> str:
    docs = []
    for doc in yaml_docs(text):
        if doc.get("kind") == "Namespace" and protected_namespace(doc.get("metadata", {}).get("name", "")):
            continue
        docs.append(doc)
    return render_docs_to_yaml(docs)


def ready_status(kubeconfig: Path, context: str, namespace: str, command_timeout: int = 20) -> dict:
    rc, workloads, workload_err = kubectl(
        ["-n", namespace, "get", "deploy,statefulset,daemonset", "--no-headers"],
        kubeconfig,
        context,
        timeout=command_timeout,
    )
    rc_pods, pods, pod_err = kubectl(["-n", namespace, "get", "pods", "--no-headers"], kubeconfig, context, timeout=command_timeout)
    rc_pods_json, pods_json, _ = kubectl(["-n", namespace, "get", "pods", "-o", "json"], kubeconfig, context, timeout=command_timeout)
    pod_owners = {}
    if rc_pods_json == 0:
        try:
            payload = json.loads(pods_json)
        except json.JSONDecodeError:
            payload = {}
        for item in payload.get("items") or []:
            name = ((item.get("metadata") or {}).get("name") or "")
            owners = ((item.get("metadata") or {}).get("ownerReferences") or [])
            pod_owners[name] = [owner.get("kind") for owner in owners if owner.get("kind")]
    not_ready = []
    ignored_job_pods = []
    workloads_ready = rc == 0 and bool(workloads.strip())
    for line in pods.splitlines():
        fields = line.split()
        if len(fields) < 3:
            continue
        name, ready, status = fields[:3]
        ok = status in ("Running", "Completed")
        if "/" in ready:
            have, want = ready.split("/", 1)
            ok = ok and (have == want or status == "Completed")
        if not ok:
            if workloads_ready and "Job" in pod_owners.get(name, []):
                ignored_job_pods.append({"pod": name, "ready": ready, "status": status})
                continue
            not_ready.append({"pod": name, "ready": ready, "status": status})
    return {
        "result": "pass" if workloads_ready and rc_pods == 0 and not not_ready else "watch",
        "workloads": workloads if rc == 0 else workload_err,
        "pods": pods if rc_pods == 0 else pod_err,
        "notReady": not_ready,
        "ignoredJobPods": ignored_job_pods,
    }


def wait_ready(kubeconfig: Path, context: str, namespace: str, timeout_seconds: int = 300) -> dict:
    deadline = time.monotonic() + timeout_seconds
    last = ready_status(kubeconfig, context, namespace)
    while time.monotonic() < deadline:
        if last["result"] == "pass":
            return last
        time.sleep(10)
        remaining = max(1, int(deadline - time.monotonic()))
        last = ready_status(kubeconfig, context, namespace, command_timeout=min(20, remaining))
    return last


def wait_ready_many(kubeconfig: Path, context: str, namespaces: list[str], timeout_seconds: int = 300) -> dict:
    deadline = time.monotonic() + timeout_seconds
    last = {}
    while time.monotonic() < deadline:
        results = {}
        for namespace in namespaces:
            remaining = max(1, int(deadline - time.monotonic()))
            if remaining <= 1:
                break
            results[namespace] = ready_status(kubeconfig, context, namespace, command_timeout=min(20, remaining))
        last = results
        if results and all(item.get("result") == "pass" for item in results.values()):
            break
        time.sleep(10)
    not_ready = []
    workloads = []
    pods = []
    for namespace, result in last.items():
        workloads.append(f"# {namespace}\n{result.get('workloads', '')}".rstrip())
        pods.append(f"# {namespace}\n{result.get('pods', '')}".rstrip())
        for item in result.get("notReady", []):
            not_ready.append({"namespace": namespace, **item})
    return {
        "result": "pass" if last and all(item.get("result") == "pass" for item in last.values()) else "watch",
        "namespaces": namespaces,
        "workloads": "\n".join(workloads),
        "pods": "\n".join(pods),
        "notReady": not_ready,
    }


def wait_for_pod_running(kubeconfig: Path, context: str, namespace: str, pod: str, timeout_seconds: int = 300) -> dict:
    deadline = time.monotonic() + timeout_seconds
    last = {"phase": "", "detail": ""}
    while time.monotonic() < deadline:
        rc, out, err = kubectl(
            ["-n", namespace, "get", "pod", pod, "-o", "json"],
            kubeconfig,
            context,
            timeout=60,
        )
        if rc == 0:
            try:
                payload = json.loads(out)
            except json.JSONDecodeError:
                payload = {}
            phase = (((payload.get("status") or {}).get("phase")) or "")
            last = {"phase": phase, "detail": phase}
            if phase == "Running":
                return {"result": "pass", "phase": phase}
        else:
            last = {"phase": "", "detail": err or out}
        time.sleep(5)
    return {"result": "blocked", **last}


def redacted_vault_status(raw: str) -> dict:
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        return {"rawSHA256": sha256_text(raw), "parse": "failed"}
    allowed = {}
    for key in ("initialized", "sealed", "standby", "version", "storage_type", "cluster_name", "cluster_id"):
        if key in payload:
            allowed[key] = payload[key]
    allowed["rawSHA256"] = sha256_text(raw)
    return allowed


def run_vault_default_operating_policy(kubeconfig: Path, context: str, namespace: str) -> dict:
    pod = "vault-0"
    pod_ready = wait_for_pod_running(kubeconfig, context, namespace, pod, timeout_seconds=300)
    if pod_ready.get("result") != "pass":
        return {"result": "blocked", "operation": "vault-init-unseal", "pod": pod, "podReady": pod_ready}

    base_exec = ["-n", namespace, "exec", pod, "--", "sh", "-ec"]
    status_cmd = "VAULT_ADDR=http://127.0.0.1:8200 vault status -format=json || true"
    _status_rc, status_before, _status_err = kubectl([*base_exec, status_cmd], kubeconfig, context, timeout=120)

    init_cmd = "VAULT_ADDR=http://127.0.0.1:8200 vault operator init -key-shares=1 -key-threshold=1 -format=json"
    init_rc, init_out, init_err = kubectl([*base_exec, init_cmd], kubeconfig, context, timeout=120)
    if init_rc != 0:
        return {
            "result": "blocked",
            "operation": "vault-init-unseal",
            "pod": pod,
            "statusBefore": redacted_vault_status(status_before),
            "initResult": "blocked",
            "detail": (init_err or init_out)[:1000],
        }

    try:
        init_payload = json.loads(init_out)
    except json.JSONDecodeError:
        return {
            "result": "blocked",
            "operation": "vault-init-unseal",
            "pod": pod,
            "statusBefore": redacted_vault_status(status_before),
            "initResult": "blocked",
            "detail": "vault operator init did not return JSON",
        }
    unseal_keys = init_payload.get("unseal_keys_b64") or []
    if not unseal_keys:
        return {
            "result": "blocked",
            "operation": "vault-init-unseal",
            "pod": pod,
            "statusBefore": redacted_vault_status(status_before),
            "initResult": "blocked",
            "detail": "vault operator init returned no unseal key",
        }

    unseal_cmd = f"VAULT_ADDR=http://127.0.0.1:8200 vault operator unseal {unseal_keys[0]}"
    unseal_rc, unseal_out, unseal_err = kubectl([*base_exec, unseal_cmd], kubeconfig, context, timeout=120)
    if unseal_rc != 0:
        return {
            "result": "blocked",
            "operation": "vault-init-unseal",
            "pod": pod,
            "statusBefore": redacted_vault_status(status_before),
            "initResult": "pass",
            "unsealResult": "blocked",
            "detail": (unseal_err or unseal_out)[:1000],
        }

    status_rc, status_after, status_err = kubectl([*base_exec, status_cmd], kubeconfig, context, timeout=120)
    status = redacted_vault_status(status_after)
    passed = status_rc == 0 and status.get("initialized") is True and status.get("sealed") is False
    return {
        "result": "pass" if passed else "blocked",
        "operation": "vault-init-unseal",
        "pod": pod,
        "statusBefore": redacted_vault_status(status_before),
        "initResult": "pass",
        "unsealResult": "pass",
        "statusAfter": status,
        "custody": "unseal key and root token were held in process memory only and not written to the receipt",
        "detail": "" if passed else (status_err or status_after)[:1000],
    }


def post_apply_operations(chart: str, base: str, kubeconfig: Path, context: str, namespace: str) -> dict:
    if chart == "hashicorp/vault" and base == "default":
        return run_vault_default_operating_policy(kubeconfig, context, namespace)
    return {"result": "pass", "operation": "none"}


def needs_post_apply_operations(chart: str, base: str) -> bool:
    return post_apply_operation_name(chart, base) != "none"


def post_apply_operation_name(chart: str, base: str) -> str:
    if chart == "hashicorp/vault" and base == "default":
        return "vault-init-unseal"
    return "none"


def operation_namespace(runtime_namespaces: list[str], fallback: str) -> str:
    for namespace in runtime_namespaces:
        if not protected_namespace(namespace):
            return namespace
    return fallback


def readiness_timeout(chart: str, base: str, default_seconds: int) -> int:
    return default_seconds


def helm_duration(value: str) -> str:
    text = str(value).strip()
    if text.isdigit():
        return f"{text}s"
    return text


def semantic_compare(
    helm_yaml: str,
    cub_yaml: str,
    allowed_extra: list[str],
    namespace_map: dict[str, str] | None = None,
    semantic_normalizations: list[str] | None = None,
) -> dict:
    semantic_normalizations = semantic_normalizations or []
    helm = object_map(helm_yaml, semantic_normalizations=semantic_normalizations)
    cub = object_map(cub_yaml, namespace_map, semantic_normalizations)
    helm_keys = set(helm)
    cub_keys = set(cub)
    missing = sorted(helm_keys - cub_keys)
    extra = sorted(cub_keys - helm_keys)
    common = sorted(helm_keys & cub_keys)
    diffs = [key for key in common if helm[key] != cub[key]]
    return {
        "result": "pass" if not missing and extra == allowed_extra and not diffs else "blocked",
        "helmObjectCount": len(helm_keys),
        "configHubObjectCount": len(cub_keys),
        "missingFromConfigHub": missing,
        "extraInConfigHub": extra,
        "semanticDiffs": diffs[:50],
        "semanticNormalizations": semantic_normalizations,
        "comparisonSHA256": sha256_text(json.dumps({
            "missing": missing,
            "extra": extra,
            "diffs": diffs,
            "semanticNormalizations": semantic_normalizations,
        }, sort_keys=True)),
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--chart", required=True)
    parser.add_argument("--version", required=True)
    parser.add_argument("--repo-url", required=True)
    parser.add_argument("--release", required=True)
    parser.add_argument("--namespace", required=True)
    parser.add_argument("--package", required=True)
    parser.add_argument("--recipe", required=True)
    parser.add_argument("--base", required=True)
    parser.add_argument("--variant-revision", required=True)
    parser.add_argument("--values", required=True)
    parser.add_argument("--slug", required=True)
    parser.add_argument("--rig", required=True)
    parser.add_argument("--out", required=True)
    parser.add_argument("--wait", default="8m")
    parser.add_argument("--target-profile", default="none", choices=["none", "kind-ingress-nginx", "kind-loadbalancer"])
    parser.add_argument("--gitops-canonicalization-profile", default="none", choices=["none", "k8s-zero-defaults"])
    parser.add_argument(
        "--lock-timeout-seconds",
        type=int,
        default=int(os.environ.get("HELM_EXPT_LIVE_PARITY_LOCK_TIMEOUT_SECONDS", "7200")),
    )
    parser.add_argument("--keep", action="store_true")
    args = parser.parse_args()

    repo = Path(__file__).resolve().parents[1]
    package_path = repo / args.package
    recipe_path = repo / args.recipe
    values_path = repo / args.values
    revision_path = repo / args.variant_revision
    variant_path = recipe_path / "variants" / args.base / "variant.yaml"
    canonical_rendered_path = revision_path.parent / "rendered" / "release-objects.yaml"
    equivalence_receipt_path = revision_path.parent / "receipts" / "helm-equivalence-receipt.yaml"
    out_path = repo / args.out
    run_root = out_path.parent
    rig = args.rig
    context = f"kind-{rig}"
    kubeconfig = Path.home() / ".confighub" / "lk" / f"{rig}.kubeconfig"
    cluster_space = f"{rig}-cluster"
    target = f"{cluster_space}/oci"
    workdir = Path("/tmp") / f"helm-expt-live-parity-{rig}-{args.slug}"
    wspace = f"{rig}-{args.slug}"
    child_app = f"{args.slug}-parity"
    helm_namespace = leg_namespace(args.namespace, "helm")
    apply_namespace = leg_namespace(args.namespace, "apply")
    oci_namespace = leg_namespace(args.namespace, "oci")

    receipt = {
        "apiVersion": "helm-expt.confighub.com/v1alpha1",
        "kind": "LiveHelmConfigHubParityReceipt",
        "metadata": {"name": f"{args.chart.replace('/', '-')}-{args.version}-{args.base}-live-parity-20260605"},
        "spec": {
            "chart": args.chart,
            "version": args.version,
            "base": args.base,
            "result": "blocked",
            "observedAt": datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z"),
            "package": {"path": args.package},
            "recipe": {"path": args.recipe},
            "variantRevision": args.variant_revision,
            "targetProfile": {"name": args.target_profile},
            "gitOpsCanonicalizationProfile": {"name": args.gitops_canonicalization_profile},
            "run": {
                "rig": rig,
                "kubeContext": context,
                "namespace": args.namespace,
                "legNamespaces": {
                    "regularHelm": helm_namespace,
                    "configHubKubectlApply": apply_namespace,
                    "configHubOciArgo": oci_namespace,
                },
                "clusterLifecycle": "not-created",
                "cleanup": {"result": "not-run"},
            },
            "legs": {},
            "semanticComparison": {"allowedExtraConfigHubObjects": [f"v1|Namespace||{args.namespace}"]},
            "checks": [],
        },
    }

    def check_item(name: str, result: str, detail: str) -> None:
        receipt["spec"]["checks"].append({"name": name, "result": result, "detail": detail[:1000]})

    def leg(name: str, **fields) -> None:
        receipt["spec"]["legs"][name] = fields

    def mark_stage(name: str) -> None:
        write_text(run_root / "stage.txt", f"{datetime.now(timezone.utc).replace(microsecond=0).isoformat()} {name}\n")

    cleanup_ok = True
    lock_path = None
    try:
        mark_stage("acquire-live-lane-lock")
        lock_path = acquire_live_parity_lock(args.lock_timeout_seconds)
        check_item("live-lane-lock", "pass", f"acquired {lock_path}")

        mark_stage("validate-inputs")
        for path, label in [
            (package_path, "package"),
            (recipe_path, "recipe"),
            (variant_path, "variant"),
            (values_path, "values"),
            (revision_path, "variant revision"),
            (canonical_rendered_path, "canonical rendered objects"),
            (equivalence_receipt_path, "Helm equivalence receipt"),
        ]:
            if not path.exists():
                raise RuntimeError(f"{label} path not found: {path}")
        equivalence_receipt = load_yaml(equivalence_receipt_path)
        semantic_normalizations = equivalence_receipt.get("spec", {}).get("semanticNormalizations") or []
        receipt["spec"]["semanticComparison"]["semanticNormalizations"] = semantic_normalizations
        variant = load_yaml(variant_path)
        canonical_helm_manifest = canonical_rendered_path.read_text()
        write_text(run_root / "canonical-helm-render.yaml", canonical_helm_manifest)
        helm_values_path = raw_values_file(values_path, run_root / "regular-helm-values.yaml")

        mark_stage("cub-lk-up")
        prune_parity_leaks()
        rc, out, err = 1, "", ""
        for attempt in range(1, 3):
            rc, out, err = sh(["cub", "lk", "up", "--name", rig, "--no-ports"], timeout=900)
            if rc == 0:
                break
            # Transient kind create / bootstrap failure: tear the partial rig down
            # and retry once on a pruned host before giving up.
            teardown_rig(rig)
            prune_parity_leaks()
        if rc != 0:
            raise RuntimeError(f"cub lk up failed after retries: {(err or out)[:1000]}")
        receipt["spec"]["run"]["clusterLifecycle"] = "created"
        check_item("cub-lk-up", "pass", out or "cub lk up passed")

        mark_stage("target-profile")
        target_profile = install_target_profile(args.target_profile, kubeconfig, context, run_root)
        receipt["spec"]["targetProfile"] = target_profile
        if args.target_profile != "none":
            check_item("target-profile", target_profile["result"], f"{args.target_profile}: {target_profile.get('observedBehavior', '')}")

        if workdir.exists():
            shutil.rmtree(workdir)

        # Adopt CRDs the chart declares that the rig already installed. The cub lk
        # bootstrap installs Argo CD (the OCI controller) and its argoproj CRDs, so
        # the argo-cd chart's own CRDs already exist without Helm ownership metadata
        # and "helm upgrade --install" refuses to import them. Labeling the existing
        # CRDs with Helm ownership lets the regular-Helm leg own them. CRDs that are
        # not already present are created by Helm as usual, so this is a no-op for
        # every other chart.
        for crd_doc in docs_matching(canonical_helm_manifest, "CustomResourceDefinition"):
            crd_name = (crd_doc.get("metadata") or {}).get("name")
            if not crd_name:
                continue
            if kubectl(["get", "crd", crd_name], kubeconfig, context, timeout=60)[0] != 0:
                continue
            kubectl(["label", "crd", crd_name, "app.kubernetes.io/managed-by=Helm", "--overwrite"], kubeconfig, context, timeout=60)
            kubectl(
                [
                    "annotate", "crd", crd_name,
                    f"meta.helm.sh/release-name={args.release}",
                    f"meta.helm.sh/release-namespace={helm_namespace}",
                    "--overwrite",
                ],
                kubeconfig, context, timeout=60,
            )

        helm_target_facts = stage_target_facts(variant, recipe_path, kubeconfig, context, helm_namespace, run_root, "regular-helm", "regularHelm")
        receipt["spec"]["targetFacts"] = {"regularHelm": helm_target_facts}
        check_item("target-facts-regular-helm", helm_target_facts["result"], f"secrets={len(helm_target_facts.get('stagedSecrets', []))} crds={len(helm_target_facts.get('stagedCRDs', []))}")

        helm_cmd = [
            "helm", "upgrade", "--install", args.release,
            *helm_chart_command_args(args.chart, args.repo_url),
            "--version", args.version,
            "--namespace", helm_namespace,
            "--create-namespace",
            "--values", str(helm_values_path),
            "--wait",
            "--timeout", helm_duration(args.wait),
        ]
        env = {**os.environ, "KUBECONFIG": str(kubeconfig)}
        mark_stage("regular-helm-install")
        rc, helm_out, helm_err = sh(helm_cmd, timeout=900, env=env)
        helm_live_manifest = ""
        get_rc, get_out, get_err = sh(["helm", "get", "manifest", args.release, "--namespace", helm_namespace], timeout=120, env=env)
        if get_rc == 0:
            helm_live_manifest = get_out + "\n"
            write_text(run_root / "regular-helm-live-manifest.yaml", helm_live_manifest)
        helm_operations = post_apply_operations(args.chart, args.base, kubeconfig, context, helm_namespace)
        receipt["spec"].setdefault("operatingPolicy", {})["regularHelm"] = helm_operations
        if helm_operations.get("operation") != "none":
            check_item("regular-helm-operating-policy", helm_operations["result"], helm_operations.get("operation", "none"))
        helm_runtime = wait_ready(kubeconfig, context, helm_namespace, timeout_seconds=180)
        if get_rc != 0:
            helm_result = "blocked"
        elif rc != 0 and helm_wait_timeout(f"{helm_out}\n{helm_err}"):
            helm_result = "watch"
        elif rc != 0:
            helm_result = "blocked"
        elif helm_operations["result"] != "pass":
            helm_result = "watch"
        elif helm_runtime["result"] == "pass":
            helm_result = "pass"
        else:
            helm_result = "watch"
        leg("regularHelm",
            result=helm_result,
            command=" ".join(helm_cmd),
            manifestSHA256=sha256_text(canonical_helm_manifest),
            objectCount=len(object_map(canonical_helm_manifest)),
            liveHelmManifestSHA256=sha256_text(helm_live_manifest) if helm_live_manifest else "",
            liveHelmManifestObjectCount=len(object_map(helm_live_manifest)) if helm_live_manifest else 0,
            namespace=helm_namespace,
            runtime=helm_runtime,
            stderr=helm_err[:1000] if rc != 0 else "",
            getManifestError=get_err[:1000] if get_rc != 0 else "",
        )
        check_item("regular-helm-live", helm_result, helm_err or helm_out or helm_runtime.get("workloads", ""))
        # The other legs use separate namespaces, so Helm cleanup does not block
        # their execution. cub-lk teardown removes the whole rig at the end.
        sh(["helm", "uninstall", args.release, "--namespace", helm_namespace, "--wait"], timeout=300, env=env)
        delete_namespace_if_safe(helm_namespace, kubeconfig, context)

        mark_stage("configHub-direct-render")
        setup_cmd = [
            "cub", "installer", "setup", "--pull", str(package_path), "--base", args.base,
            "--work-dir", str(workdir), "--non-interactive", "--namespace", apply_namespace,
        ]
        rc, setup_out, setup_err = sh(setup_cmd, timeout=360)
        if rc != 0:
            raise RuntimeError(f"installer setup failed: {(setup_err or setup_out)[:1000]}")
        manifests_dir = workdir / "out" / "manifests"
        secrets_dir = workdir / "out" / "secrets"
        cub_manifest = combine_yaml_parts(collect_yaml(manifests_dir), collect_yaml(secrets_dir))
        write_text(run_root / "confighub-rendered-manifest.yaml", cub_manifest)

        apply_manifest_namespaces = manifest_namespaces(cub_manifest) or [apply_namespace]
        apply_runtime_namespaces = workload_namespaces(cub_manifest, apply_namespace)
        namespace_docs = []
        for namespace in apply_manifest_namespaces:
            if protected_namespace(namespace):
                continue
            namespace_docs.append(yaml.safe_load(kubectl_must(
                ["create", "namespace", namespace, "--dry-run=client", "-o", "yaml"],
                kubeconfig,
                context,
                f"namespace yaml {namespace}",
            )))
        ns_yaml = run_root / "namespace-apply.yaml"
        if namespace_docs:
            write_text(ns_yaml, render_docs_to_yaml(namespace_docs))
            kubectl_must(["apply", "-f", str(ns_yaml)], kubeconfig, context, "namespace apply")
        apply_target_facts = stage_target_facts(
            variant,
            recipe_path,
            kubeconfig,
            context,
            apply_namespace,
            run_root,
            "confighub-apply",
            "configHubKubectlApply",
            apply_manifest_namespaces,
        )
        receipt["spec"]["targetFacts"]["configHubKubectlApply"] = apply_target_facts
        check_item("target-facts-confighub-apply", apply_target_facts["result"], f"secrets={len(apply_target_facts.get('stagedSecrets', []))} crds={len(apply_target_facts.get('stagedCRDs', []))}")
        if secrets_dir.exists():
            for secret_path in sorted(secrets_dir.glob("*.yaml")):
                kubectl_must(["apply", "-f", str(secret_path)], kubeconfig, context, f"secret apply {secret_path.name}", timeout=120)
        if manifests_dir.exists():
            mark_stage("configHub-direct-apply")
            crds = docs_matching(cub_manifest, "CustomResourceDefinition")
            if crds:
                crd_path = run_root / "confighub-rendered-crds.yaml"
                write_text(crd_path, render_docs_to_yaml(crds))
                kubectl_must(["apply", "--server-side", "--force-conflicts", "-f", str(crd_path)], kubeconfig, context, "crd apply", timeout=300)
                for crd in crds:
                    name = crd.get("metadata", {}).get("name")
                    if name:
                        kubectl(["wait", "--for=condition=Established", f"crd/{name}", "--timeout=180s"], kubeconfig, context, timeout=210)
            for path in sorted(manifests_dir.glob("*.yaml")):
                if "namespace-" in path.name:
                    kubectl(["apply", "-f", str(path)], kubeconfig, context, timeout=120)
            rest = [path for path in sorted(manifests_dir.glob("*.yaml")) if "namespace-" not in path.name]
            if rest:
                kubectl_must(["apply", "--server-side", "--force-conflicts", "-f", str(manifests_dir)], kubeconfig, context, "manifest apply", timeout=300)
        mark_stage("configHub-direct-readiness")
        apply_operation_namespace = operation_namespace(apply_runtime_namespaces, apply_namespace)
        apply_operations = post_apply_operations(args.chart, args.base, kubeconfig, context, apply_operation_namespace)
        apply_operations["namespace"] = apply_operation_namespace
        receipt["spec"].setdefault("operatingPolicy", {})["configHubKubectlApply"] = apply_operations
        if apply_operations.get("operation") != "none":
            check_item("confighub-kubectl-apply-operating-policy", apply_operations["result"], apply_operations.get("operation", "none"))
        apply_runtime = wait_ready_many(kubeconfig, context, apply_runtime_namespaces, timeout_seconds=readiness_timeout(args.chart, args.base, 300))
        apply_result = "pass" if apply_operations["result"] == "pass" and apply_runtime["result"] == "pass" else "watch"
        apply_cleanup_candidates = [
            namespace for namespace in sorted(set(apply_manifest_namespaces + apply_runtime_namespaces))
            if not protected_namespace(namespace)
        ]
        apply_protected_cleanup_namespaces = {
            namespace for namespace in sorted(set(apply_manifest_namespaces + apply_runtime_namespaces))
            if protected_namespace(namespace)
        }
        apply_cleanup_namespaces = apply_cleanup_candidates
        apply_retained_namespaces = []
        apply_protected_cleanup = {"result": "not-needed", "namespaces": sorted(apply_protected_cleanup_namespaces), "objectCount": 0}
        apply_cluster_cleanup = {"result": "not-needed", "objectCount": 0}
        leg("configHubKubectlApply",
            result=apply_result,
            renderCommand=" ".join(setup_cmd),
            applyMode="namespace-first kubectl apply; separated secrets staged when present",
            manifestSHA256=sha256_text(cub_manifest),
            objectCount=len(object_map(cub_manifest)),
            namespace=apply_namespace,
            manifestNamespaces=apply_manifest_namespaces,
            runtimeNamespaces=apply_runtime_namespaces,
            runtime=apply_runtime,
            cleanupBeforeOci={
                "namespaces": apply_cleanup_namespaces,
                "retainedNamespaces": apply_retained_namespaces,
                "clusterScopedResources": apply_cluster_cleanup,
                "protectedNamespaceResources": apply_protected_cleanup,
                "reason": "isolate the OCI/Argo leg from direct-apply workloads in single-cluster parity rigs",
            },
        )
        check_item("confighub-kubectl-apply-live", apply_result, apply_runtime.get("workloads", ""))
        cluster_cleanup_docs = cluster_scoped_cleanup_docs(cub_manifest)
        if cluster_cleanup_docs:
            cleanup_path = run_root / "cluster-scoped-apply-cleanup.yaml"
            write_text(cleanup_path, render_docs_to_yaml(cluster_cleanup_docs))
            rc, out, err = kubectl(
                ["delete", "--ignore-not-found=true", "--wait=true", "--timeout=300s", "-f", str(cleanup_path)],
                kubeconfig,
                context,
                timeout=330,
            )
            apply_cluster_cleanup = {
                "result": "pass" if rc == 0 else "blocked",
                "objectCount": len(cluster_cleanup_docs),
                "manifest": str(cleanup_path.relative_to(run_root)),
                "detail": (err or out)[:1000],
            }
            receipt["spec"]["legs"]["configHubKubectlApply"]["cleanupBeforeOci"]["clusterScopedResources"] = apply_cluster_cleanup
            check_item(
                "confighub-kubectl-apply-cluster-cleanup",
                apply_cluster_cleanup["result"],
                f"objects={len(cluster_cleanup_docs)}",
            )
            if rc != 0:
                raise RuntimeError(f"direct-apply cluster-scoped cleanup failed: {(err or out)[:1000]}")
        protected_cleanup_docs = namespaced_cleanup_docs(cub_manifest, apply_protected_cleanup_namespaces)
        if protected_cleanup_docs:
            cleanup_path = run_root / "protected-namespace-apply-cleanup.yaml"
            write_text(cleanup_path, render_docs_to_yaml(protected_cleanup_docs))
            rc, out, err = kubectl(
                ["delete", "--ignore-not-found=true", "--wait=true", "--timeout=300s", "-f", str(cleanup_path)],
                kubeconfig,
                context,
                timeout=330,
            )
            apply_protected_cleanup = {
                "result": "pass" if rc == 0 else "blocked",
                "namespaces": sorted(apply_protected_cleanup_namespaces),
                "objectCount": len(protected_cleanup_docs),
                "manifest": str(cleanup_path.relative_to(run_root)),
                "detail": (err or out)[:1000],
            }
            receipt["spec"]["legs"]["configHubKubectlApply"]["cleanupBeforeOci"]["protectedNamespaceResources"] = apply_protected_cleanup
            check_item(
                "confighub-kubectl-apply-protected-cleanup",
                apply_protected_cleanup["result"],
                f"objects={len(protected_cleanup_docs)} namespaces={','.join(sorted(apply_protected_cleanup_namespaces))}",
            )
            if rc != 0:
                raise RuntimeError(f"direct-apply protected namespace cleanup failed: {(err or out)[:1000]}")
        for namespace in apply_cleanup_namespaces:
            delete_namespace_if_safe(namespace, kubeconfig, context)

        # Re-render for the OCI leg so the applied artifact is isolated from the
        # direct kubectl/apply namespace.
        mark_stage("configHub-oci-render")
        if workdir.exists():
            shutil.rmtree(workdir)
        setup_cmd_oci = [
            "cub", "installer", "setup", "--pull", str(package_path), "--base", args.base,
            "--work-dir", str(workdir), "--non-interactive", "--namespace", oci_namespace,
        ]
        rc, setup_out, setup_err = sh(setup_cmd_oci, timeout=360)
        if rc != 0:
            raise RuntimeError(f"installer setup for oci failed: {(setup_err or setup_out)[:1000]}")
        manifests_dir = workdir / "out" / "manifests"
        secrets_dir = workdir / "out" / "secrets"
        gitops_canonicalization = canonicalize_gitops_manifest_dir(
            manifests_dir,
            args.gitops_canonicalization_profile,
            run_root,
        )
        receipt["spec"]["gitOpsCanonicalizationProfile"] = gitops_canonicalization
        cub_manifest_oci = combine_yaml_parts(collect_yaml(manifests_dir), collect_yaml(secrets_dir))
        write_text(run_root / "confighub-rendered-oci-manifest.yaml", cub_manifest_oci)

        # Stage separated Secrets before OCI/Argo reconciliation. ConfigHub upload
        # deliberately excludes these files from the workload Units.
        oci_manifest_namespaces = manifest_namespaces(cub_manifest_oci) or [oci_namespace]
        oci_runtime_namespaces = workload_namespaces(cub_manifest_oci, oci_namespace)
        namespace_docs = []
        for namespace in oci_manifest_namespaces:
            if protected_namespace(namespace):
                continue
            namespace_docs.append(yaml.safe_load(kubectl_must(
                ["create", "namespace", namespace, "--dry-run=client", "-o", "yaml"],
                kubeconfig,
                context,
                f"oci namespace yaml {namespace}",
            )))
        ns_oci_yaml = run_root / "namespace-oci.yaml"
        if namespace_docs:
            write_text(ns_oci_yaml, render_docs_to_yaml(namespace_docs))
            kubectl_must(["apply", "-f", str(ns_oci_yaml)], kubeconfig, context, "namespace apply before oci")
        oci_target_facts = stage_target_facts(
            variant,
            recipe_path,
            kubeconfig,
            context,
            oci_namespace,
            run_root,
            "confighub-oci",
            "configHubOciArgo",
            oci_manifest_namespaces,
        )
        receipt["spec"]["targetFacts"]["configHubOciArgo"] = oci_target_facts
        check_item("target-facts-confighub-oci", oci_target_facts["result"], f"secrets={len(oci_target_facts.get('stagedSecrets', []))} crds={len(oci_target_facts.get('stagedCRDs', []))}")
        staged_secrets = []
        if secrets_dir.exists():
            for secret_path in sorted(secrets_dir.glob("*.yaml")):
                oci_secret_path = namespace_secret_for_destination(
                    secret_path,
                    oci_namespace,
                    run_root / "oci-staged-secrets",
                )
                kubectl_must(["apply", "-f", str(oci_secret_path)], kubeconfig, context, f"oci secret apply {secret_path.name}", timeout=120)
                staged_secrets.append(secret_path.name)

        rc, upload_out, upload_err = sh([
            "cub", "installer", "upload", "--work-dir", str(workdir),
            "--space", wspace, "--target", target,
        ], timeout=600)
        if rc != 0:
            raise RuntimeError(f"installer upload failed: {(upload_err or upload_out)[:1000]}")

        rc, units_out, units_err = sh(["cub", "unit", "list", "--space", wspace], timeout=120)
        if rc != 0:
            raise RuntimeError(f"unit list failed: {(units_err or units_out)[:1000]}")
        units = []
        for line in units_out.splitlines():
            token = line.split()
            if not token:
                continue
            name = token[0]
            if name not in ("NAME", "installer-record"):
                units.append(name)
        if not units:
            raise RuntimeError(f"no workload units found in {wspace}")
        rc, apply_out, apply_err = sh(["cub", "unit", "apply", "--space", wspace, "--unit", ",".join(units)], timeout=300)
        if rc != 0:
            raise RuntimeError(f"unit apply failed: {(apply_err or apply_out)[:1000]}")

        mark_stage("configHub-oci-argo")
        app = {
            "apiVersion": "argoproj.io/v1alpha1",
            "kind": "Application",
            "metadata": {"name": child_app, "namespace": "argocd"},
            "spec": {
                "project": "default",
                "source": {
                    "repoURL": f"oci://oci.hub.confighub.com:443/target/{cluster_space}/oci",
                    "targetRevision": "latest",
                    "path": f"./{wspace}",
                },
                "destination": {"server": "https://kubernetes.default.svc", "namespace": oci_namespace},
                "syncPolicy": {
                    "automated": {"selfHeal": True, "prune": True},
                    "syncOptions": ["ServerSideApply=true", "CreateNamespace=true"],
                },
            },
        }
        app_path = run_root / "argo-application.json"
        app_path.write_text(json.dumps(app, indent=2))
        rc, app_create_out, app_create_err = sh([
            "cub", "unit", "create", "--space", cluster_space, f"{child_app}-app",
            str(app_path), "--target", target, "--allow-exists",
        ], timeout=180)
        if rc != 0:
            raise RuntimeError(f"application unit create failed: {(app_create_err or app_create_out)[:1000]}")
        rc, app_apply_out, app_apply_err = sh(["cub", "unit", "apply", "--space", cluster_space, "--unit", f"{child_app}-app"], timeout=180)
        if rc != 0:
            raise RuntimeError(f"application apply failed: {(app_apply_err or app_apply_out)[:1000]}")
        kubectl([
            "annotate", "application", cluster_space, "-n", "argocd",
            "argocd.argoproj.io/refresh=hard", "--overwrite",
        ], kubeconfig, context, timeout=30)

        sync = health = revision = ""
        max_argo_wait = readiness_timeout(args.chart, args.base, 420)
        waited = 0
        needs_oci_operations = needs_post_apply_operations(args.chart, args.base)
        while waited < max_argo_wait:
            rc, status, _ = kubectl([
                "get", "application", child_app, "-n", "argocd",
                "-o", "jsonpath={.status.sync.status}|{.status.health.status}|{.status.sync.revision}",
            ], kubeconfig, context, timeout=30)
            if "|" in status:
                sync, health, revision = (status.split("|") + ["", "", ""])[:3]
                if sync == "Synced" and (health == "Healthy" or needs_oci_operations):
                    break
            time.sleep(10)
            waited += 10
        oci_operation_namespace = operation_namespace(oci_runtime_namespaces, oci_namespace)
        oci_operations = post_apply_operations(args.chart, args.base, kubeconfig, context, oci_operation_namespace)
        oci_operations["namespace"] = oci_operation_namespace
        receipt["spec"].setdefault("operatingPolicy", {})["configHubOciArgo"] = oci_operations
        if oci_operations.get("operation") != "none":
            check_item("confighub-oci-argo-operating-policy", oci_operations["result"], oci_operations.get("operation", "none"))
        if oci_operations["result"] == "pass" and needs_oci_operations:
            kubectl([
                "annotate", "application", child_app, "-n", "argocd",
                "argocd.argoproj.io/refresh=hard", "--overwrite",
            ], kubeconfig, context, timeout=30)
            while waited < max_argo_wait:
                rc, status, _ = kubectl([
                    "get", "application", child_app, "-n", "argocd",
                    "-o", "jsonpath={.status.sync.status}|{.status.health.status}|{.status.sync.revision}",
                ], kubeconfig, context, timeout=30)
                if "|" in status:
                    sync, health, revision = (status.split("|") + ["", "", ""])[:3]
                    if sync == "Synced" and health == "Healthy":
                        break
                time.sleep(10)
                waited += 10
        mark_stage("configHub-oci-readiness")
        oci_runtime = wait_ready_many(kubeconfig, context, oci_runtime_namespaces, timeout_seconds=readiness_timeout(args.chart, args.base, 180))
        oci_result = "pass" if oci_operations["result"] == "pass" and sync == "Synced" and health == "Healthy" and oci_runtime["result"] == "pass" else "watch"
        argo_status = argo_application_status(kubeconfig, context, child_app)
        leg("configHubOciArgo",
            result=oci_result,
            workloadSpace=wspace,
            controller="Argo CD OCI",
            app=child_app,
            manifestSHA256=sha256_text(cub_manifest_oci),
            objectCount=len(object_map(cub_manifest_oci)),
            namespace=oci_namespace,
            manifestNamespaces=oci_manifest_namespaces,
            runtimeNamespaces=oci_runtime_namespaces,
            ociRevision=revision,
            sync=sync or "unknown",
            health=health or "unknown",
            separatedSecrets=staged_secrets,
            argoStatus=argo_status,
            runtime=oci_runtime,
        )
        check_item("confighub-oci-argo-live", oci_result, f"sync={sync or '?'} health={health or '?'} after {waited}s")

        comparison_apply = semantic_compare(
            canonical_helm_manifest,
            cub_manifest,
            [f"v1|Namespace||{args.namespace}"],
            {apply_namespace: args.namespace},
            semantic_normalizations,
        )
        oci_semantic_normalizations = [*semantic_normalizations]
        if args.gitops_canonicalization_profile != "none":
            oci_semantic_normalizations.append(args.gitops_canonicalization_profile)
        comparison_argo = semantic_compare(
            canonical_helm_manifest,
            cub_manifest_oci,
            [f"v1|Namespace||{args.namespace}"],
            {oci_namespace: args.namespace},
            oci_semantic_normalizations,
        )
        receipt["spec"]["semanticComparison"]["helmVsConfigHubKubectlApply"] = comparison_apply
        receipt["spec"]["semanticComparison"]["helmVsConfigHubOciArgo"] = comparison_argo
        semantic_result = "pass" if comparison_apply["result"] == "pass" and comparison_argo["result"] == "pass" else "blocked"
        check_item(
            "semantic-object-parity",
            semantic_result,
            f"apply={comparison_apply['result']} argo={comparison_argo['result']} "
            f"applyDiffs={len(comparison_apply['semanticDiffs'])} argoDiffs={len(comparison_argo['semanticDiffs'])}",
        )

        leg_results = [item.get("result") for item in receipt["spec"]["legs"].values()]
        comparison_ok = semantic_result == "pass"
        receipt["spec"]["result"] = "pass" if all(item == "pass" for item in leg_results) and comparison_ok else "watch"
        if "blocked" in leg_results or not canonical_helm_manifest or not comparison_ok:
            receipt["spec"]["result"] = "blocked"

    except Exception as exc:
        receipt["spec"]["result"] = "blocked"
        check_item("failure", "blocked", str(exc))
        receipt["spec"]["failure"] = {"message": str(exc)}
    finally:
        stop_target_profile_processes()
        if not args.keep:
            if receipt["spec"]["run"]["clusterLifecycle"] == "not-created":
                receipt["spec"]["run"]["cleanup"] = {
                    "command": "not needed",
                    "result": "pass",
                    "detail": "blocked before local cluster or ConfigHub spaces were created",
                }
            else:
                mark_stage("cleanup")
                for cmd in [
                    ["cub", "space", "delete", wspace, "--recursive-force"],
                    ["cub", "unit", "delete", "--space", cluster_space, f"{child_app}-app"],
                ]:
                    rc, _, _ = sh(cmd, timeout=180)
                    cleanup_ok = cleanup_ok and rc == 0
                down_ok, down_detail = teardown_rig(rig)
                cleanup_ok = cleanup_ok and down_ok
                receipt["spec"]["run"]["clusterLifecycle"] = "cleaned-up" if down_ok else "cleanup-failed"
                receipt["spec"]["run"]["cleanup"] = {
                    "command": f"cub lk down --name {rig} --force",
                    "result": "pass" if cleanup_ok else "blocked",
                    "detail": down_detail,
                }
        else:
            receipt["spec"]["run"]["clusterLifecycle"] = "retained"
            receipt["spec"]["run"]["cleanup"] = {"result": "retained"}
        try:
            write_yaml(out_path, receipt)
            print(f"wrote {out_path.relative_to(repo)} result={receipt['spec']['result']}")
        finally:
            release_live_parity_lock(lock_path)

    return 0 if receipt["spec"]["result"] in ("pass", "watch", "blocked") else 1


if __name__ == "__main__":
    sys.exit(main())
